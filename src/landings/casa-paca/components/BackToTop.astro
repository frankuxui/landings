---
import { ArrowUp } from "@lucide/astro"
---

<button
  data-back-to-top
  type="button"
  aria-label="Volver arriba"
  aria-hidden="true"
  tabindex="-1"
  class="pointer-events-none fixed right-5 bottom-5 z-50 grid size-12 scale-90 place-items-center rounded-full bg-control text-foreground opacity-0 shadow-lg transition duration-300 ease-landing hover:bg-control-hover focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-ring active:scale-95 motion-reduce:transition-none"
>
  <ArrowUp size={19} aria-hidden="true" />
</button>
