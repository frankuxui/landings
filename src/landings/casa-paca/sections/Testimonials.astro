---
import { testimonials, type Testimonial } from "../data/content"
---

<section id="testimonials" class="bg-background-alt px-container-x py-section">
  <div class="mx-auto max-w-landing">
    <p class="mb-4 text-xs font-bold tracking-widest uppercase" data-reveal>
      ¿Qué dicen de nosotros?
    </p><h2
      class="max-w-heading text-balance font-display text-headline-2 leading-tight font-semibold tracking-tight"
      data-reveal
    >
      Nadie nos ha pedido que lo pongamos por escrito.
    </h2>
    <div
      class="mt-14 grid gap-10 cards:grid-cols-2 cards:gap-x-12 cards:gap-y-12"
      data-reveal-stagger
    >
      {
        testimonials.map((testimonial: Testimonial) => (
          <figure data-reveal-item class="border-t border-border pt-6">
            <blockquote class="font-display text-xl leading-snug font-medium">
              “{testimonial.quote}”
            </blockquote>
            <figcaption class="mt-4 text-sm font-bold tracking-wide uppercase text-muted">
              {testimonial.name}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
