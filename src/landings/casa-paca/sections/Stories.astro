---
import { ArrowLeft, ArrowRight } from "@lucide/astro"
import Photo from "../components/Photo.astro"
import { storyImages } from "../data/images"
import { barStories, type BarStory } from "../data/content"
---

<section id="stories" class="stories-slider bg-background-alt py-section">
  <div class="mx-auto max-w-landing px-container-x">
    <header
      class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between"
    >
      <div>
        <p class="mb-4 text-xs font-bold tracking-widest uppercase">
          Historias del bar
        </p><h2
          class="max-w-heading text-balance font-display text-headline-1 leading-[0.9] font-semibold tracking-tight"
        >
          Lo que se cuenta en la barra.
        </h2>
      </div>
      <div class="flex items-center gap-5">
        <p
          data-story-counter
          class="font-display text-sm font-bold tabular-nums text-muted"
          aria-live="polite"
        >
          {`01 / ${String(barStories.length).padStart(2, "0")}`}
        </p>
        <div class="flex gap-2">
          <button
            data-story-prev
            type="button"
            aria-label="Historia anterior"
            class="grid size-12 place-items-center rounded-full border border-border bg-transparent transition hover:scale-105 hover:bg-control focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:opacity-40"
            ><ArrowLeft size={19} aria-hidden="true" /></button
          >
          <button
            data-story-next
            type="button"
            aria-label="Historia siguiente"
            class="grid size-12 place-items-center rounded-full border border-border bg-transparent transition hover:scale-105 hover:bg-control focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:opacity-40"
            ><ArrowRight size={19} aria-hidden="true" /></button
          >
        </div>
      </div>
    </header>
  </div>
  <div data-stories-slider class="swiper mt-10 lg:mt-12">
    <div class="swiper-wrapper">
      {
        barStories.map((story: BarStory, index: number) => (
          <article class="swiper-slide">
            <div class="lg:grid lg:min-h-screen lg:grid-cols-[1.6fr_1fr]">
              <Photo
                image={storyImages[index]}
                figureClass="lg:flex lg:h-full lg:flex-col"
                class="aspect-4/3 w-full lg:aspect-auto lg:min-h-0 lg:flex-1"
              />
              <div class="flex flex-col justify-center bg-neutral-950 px-container-x py-10 text-neutral-50 lg:px-14 lg:py-16">
                <div class="mx-auto w-full max-w-copy lg:mx-0">
                  <div class="flex justify-between gap-4 text-xs font-bold tracking-widest text-neutral-400 uppercase">
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <span>{story.date}</span>
                  </div>
                  <h3 class="mt-8 font-display text-headline-2 leading-[0.95] font-semibold">
                    {story.title}
                  </h3>
                  <p class="mt-6 text-lg leading-relaxed">{story.text}</p>
                  <p class="mt-6 border-t border-neutral-700 pt-6 font-display text-sm font-medium text-neutral-400 italic">
                    {story.quip}
                  </p>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
  <div
    class="mx-auto mt-8 flex max-w-landing justify-center px-container-x"
    data-story-pagination
  >
  </div>
</section>
