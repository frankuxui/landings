---
import { Check } from "@lucide/astro"
import { rules } from "../data/content"
---

<section id="rules" class="px-container-x py-section">
  <div class="mx-auto max-w-landing">
    <p class="mb-4 text-xs font-bold tracking-widest uppercase" data-reveal>
      Normas de la casa
    </p><h2
      class="max-w-heading text-balance font-display text-headline-2 leading-tight font-semibold tracking-tight"
      data-reveal
    >
      Pocas, pero se cumplen.
    </h2>
    <ul
      class="mt-12 grid gap-5 cards:grid-cols-2 cards:gap-x-12"
      data-reveal-stagger
    >
      {
        rules.map((rule: string) => (
          <li
            data-reveal-item
            class="flex items-start gap-3 border-b border-border pb-5 text-lg"
          >
            <Check
              size={20}
              class="mt-1 shrink-0 text-muted"
              aria-hidden="true"
            />
            <span class="font-display">{rule}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
