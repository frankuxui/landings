---
// Real photography sourced from Unsplash via the `unsplash-images` Skill.
// Renders the persisted, hotlinked `images.unsplash.com` URL with the
// landing's monochrome treatment. Credit is a discreet caption below the
// photo (never overlaid on top of it) plus a `title` tooltip on the image
// itself — see src/landings/grandparent-care/data/images.ts for the source
// metadata, and the consolidated "Photo credits" list in Footer.astro.
import PhotoCredit from "./PhotoCredit.astro"
import type { UnsplashImage } from "../types"

type PhotoRatio = "1 / 1" | "3 / 4" | "4 / 3" | "4 / 5" | "16 / 10" | "auto"

export interface Props {
  image: UnsplashImage
  ratio?: PhotoRatio
  sizes?: string
  /** Applied to the outer <figure> — layout/position (e.g. `reveal`, width). */
  class?: string
  imgClass?: string
  /** When false, the credit is omitted from this figure's own figcaption —
   * the consuming component must render the credit itself, still below the
   * photo in normal flow. The credit is never simply dropped. */
  caption?: boolean
}

const {
  image,
  ratio = "4 / 3",
  sizes,
  class: className,
  imgClass,
  caption = true,
} = Astro.props
---

<figure class:list={["group/photo m-0 flex w-full flex-col", className]}>
  <div
    class:list={[
      "relative w-full overflow-hidden",
      ratio === "1 / 1" && "aspect-square",
      ratio === "3 / 4" && "aspect-3/4",
      ratio === "4 / 3" && "aspect-4/3",
      ratio === "4 / 5" && "aspect-4/5",
      ratio === "16 / 10" && "aspect-16/10",
      ratio === "auto" && "h-full flex-1",
    ]}
  >
    <img
      src={image.src}
      alt={image.alt}
      title={`Photo by ${image.author} on Unsplash`}
      width={image.width}
      height={image.height}
      sizes={sizes}
      loading="lazy"
      decoding="async"
      class:list={[
        "absolute inset-0 h-full w-full object-cover photo-tone",
        imgClass,
      ]}
    />
    <slot />
  </div>
  {
    caption && (
      <figcaption class="mt-2">
        <PhotoCredit image={image} />
      </figcaption>
    )
  }
</figure>
