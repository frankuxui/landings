---
// One card in the staggered "Tips for better care" grid.
import type { Tip } from "../types"

export interface Props {
  tip: Tip
  index: number
}

const { tip, index } = Astro.props
---

<article
  class="reveal flex h-full flex-col gap-4 bg-surface p-6 sm:p-7"
  style={`transition-delay: ${index * 60}ms`}
>
  <span class="font-mono text-sm text-muted" aria-hidden="true">
    {tip.number}
  </span>
  <h3 class="text-lg leading-snug font-semibold text-foreground">
    {tip.title}
  </h3>
  <p class="text-sm text-muted">
    {tip.description}
  </p>
</article>
