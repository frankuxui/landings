---
// One entry in the "Talks and workshops" agenda — editorial, list-like
// composition rather than a marketing event card.
import { Clock, MapPin, UsersRound } from "@lucide/astro"
import type { Workshop } from "../types"

export interface Props {
  workshop: Workshop
  index: number
}

const { workshop, index } = Astro.props
---

<article
  class="reveal grid grid-cols-1 gap-4 border-t border-border py-8 cards:grid-cols-[3rem_1fr] cards:gap-8"
  style={`transition-delay: ${index * 70}ms`}
>
  <span class="font-mono text-sm text-muted" aria-hidden="true">
    {String(index + 1).padStart(2, "0")}
  </span>
  <div>
    <h3
      class="max-w-heading text-balance text-xl leading-snug font-semibold text-foreground sm:text-2xl"
    >
      {workshop.title}
    </h3>
    <p class="mt-3 max-w-copy text-sm text-muted sm:text-base">
      {workshop.description}
    </p>
    <dl class="mt-5 flex flex-wrap gap-x-8 gap-y-3">
      <div class="flex items-center gap-2">
        <MapPin
          class="size-4 text-muted"
          aria-hidden="true"
          stroke-width="1.5"
        />
        <dt class="sr-only">Format</dt>
        <dd class="text-sm text-foreground">{workshop.format}</dd>
      </div>
      <div class="flex items-center gap-2">
        <Clock
          class="size-4 text-muted"
          aria-hidden="true"
          stroke-width="1.5"
        />
        <dt class="sr-only">Duration</dt>
        <dd class="text-sm text-foreground">{workshop.duration}</dd>
      </div>
      <div class="flex items-center gap-2">
        <UsersRound
          class="size-4 text-muted"
          aria-hidden="true"
          stroke-width="1.5"
        />
        <dt class="sr-only">Audience</dt>
        <dd class="text-sm text-foreground">{workshop.audience}</dd>
      </div>
    </dl>
  </div>
</article>
