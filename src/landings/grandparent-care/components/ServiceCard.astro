---
// One card in the "What we do" services grid — icon-led rather than
// photographic, so this section reads as a calm, editorial index of what's
// offered rather than a marketing-style photo grid (see Gallery.astro for
// the landing's photographic moments).
import { Mic, HeartHandshake, Compass, Users } from "@lucide/astro"
import type { Service, ServiceIconName } from "../types"

export interface Props {
  service: Service
  index: number
}

const { service, index } = Astro.props

const icons: Record<ServiceIconName, typeof Mic> = {
  Mic,
  HeartHandshake,
  Compass,
  Users,
}

const Icon = icons[service.icon]
---

<article
  class="reveal flex flex-col gap-5 border-t border-border pt-6"
  style={`transition-delay: ${index * 70}ms`}
>
  <div class="flex items-center justify-between">
    <Icon
      class="size-7 text-foreground"
      aria-hidden="true"
      stroke-width="1.5"
    />
    <span class="font-mono text-xs text-muted">
      {String(index + 1).padStart(2, "0")}
    </span>
  </div>
  <div>
    <h3 class="text-lg leading-snug font-semibold text-foreground">
      {service.title}
    </h3>
    <p class="mt-3 text-sm text-muted">
      {service.description}
    </p>
  </div>
</article>
