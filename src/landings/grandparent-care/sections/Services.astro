---
import ServiceCard from "../components/ServiceCard.astro"
import { services } from "../data/services"
import type { Service } from "../types"
---

<section
  class="bg-background py-section"
  id="services"
  aria-labelledby="services-heading"
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <div>
      <p
        class="mb-4 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
      >
        What we do
      </p>
      <h2
        id="services-heading"
        class="max-w-heading text-balance text-headline-2 leading-tight font-semibold text-foreground"
        data-split-reveal
      >
        Support that meets families where they actually are.
      </h2>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-8 cards:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service: Service, index: number) => (
          <ServiceCard service={service} index={index} />
        ))
      }
    </div>
  </div>
</section>
