---
// Full-bleed editorial hero: a large headline stacked above a wide
// horizontal photograph, rather than a symmetric two-column layout — a
// deliberate compositional choice distinct from the rest of the gallery
// (see README "Differentiation"). Entrance handled by scripts/heroReveal.ts:
// a line-by-line headline reveal, fade-up subtitle/CTAs, a clip-path image
// reveal with scroll-scrubbed parallax, and a fading scroll cue.
import { ArrowRight, CirclePlay, ChevronDown } from "@lucide/astro"
import PhotoCredit from "../components/PhotoCredit.astro"
import { heroImage } from "../data/images"
---

<section
  class="relative overflow-hidden bg-background pt-32 pb-16 sm:pt-40"
  id="home"
  aria-label="Introduction"
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <p
      class="mb-6 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
      data-hero-eyebrow
    >
      Grandparent Care · Accompaniment for families
    </p>

    <h1
      class="max-w-hero-heading text-balance text-headline-1 leading-[0.98] font-semibold text-foreground"
      data-hero-headline
    >
      Growing older should never mean growing distant.
    </h1>

    <div class="mt-10 grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
      <p class="max-w-copy text-lg text-muted sm:text-xl" data-hero-subtitle>
        We give talks, accompany older adults who spend their days alone, and
        guide families through the conversations that matter — because no one
        should grow old without someone paying attention.
      </p>

      <div
        class="flex flex-wrap items-center gap-4 lg:justify-end"
        data-hero-actions
      >
        <a
          href="#contact"
          class="inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-full border-0 bg-(--color-primary) px-6 py-3 text-base font-semibold text-(--color-light) no-underline transition duration-200 ease-landing hover:opacity-90 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:opacity-90"
        >
          Request accompaniment
          <ArrowRight
            aria-hidden="true"
            width="18"
            height="18"
            stroke-width="1.5"
          />
        </a>
        <a
          href="#services"
          class="inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-full border-0 bg-transparent px-6 py-3 text-base font-semibold text-foreground no-underline transition duration-200 ease-landing hover:bg-control focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-control-hover"
        >
          <CirclePlay
            aria-hidden="true"
            width="18"
            height="18"
            stroke-width="1.5"
          />
          What we do
        </a>
      </div>
    </div>
  </div>

  <div class="relative mt-14 w-full sm:mt-20" data-hero-image-wrap>
    <div
      class="relative aspect-4/3 w-full overflow-hidden sm:aspect-16/10 lg:aspect-auto lg:h-[34rem] xl:h-[40rem]"
    >
      <img
        src={heroImage.src}
        alt={heroImage.alt}
        title={`Photo by ${heroImage.author} on Unsplash`}
        width={heroImage.width}
        height={heroImage.height}
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover photo-tone"
        data-hero-image
      />
    </div>
  </div>

  <div
    class="mx-auto flex w-full max-w-landing items-center justify-between px-container-x pt-4 sm:px-8 xl:px-14"
  >
    <PhotoCredit image={heroImage} />

    <div
      class="hidden items-center gap-2 font-mono text-xs text-muted sm:flex"
      data-hero-scroll-cue
      aria-hidden="true"
    >
      Scroll
      <ChevronDown width="14" height="14" stroke-width="1.5" />
    </div>
  </div>
</section>

<script>
  import "../scripts/heroReveal"
</script>
