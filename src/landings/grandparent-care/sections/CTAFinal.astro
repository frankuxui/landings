---
// Final CTA — a luminous, hopeful full-bleed photograph behind a short,
// direct call to action, doubling as the landing's contact anchor. The
// Unsplash credit sits in its own strip below the photo, in normal document
// flow — never overlaid on top of it. Contact details are clearly fictional
// placeholders (see the astro-landing-pages Skill §15 "Privacy and
// fictional data").
import { ArrowRight, Mail, Phone } from "@lucide/astro"
import PhotoCredit from "../components/PhotoCredit.astro"
import { ctaImage } from "../data/images"
---

<section class="bg-inverted" id="contact" aria-labelledby="cta-final-heading">
  <div class="relative isolate overflow-hidden">
    <img
      src={ctaImage.src}
      alt={ctaImage.alt}
      title={`Photo by ${ctaImage.author} on Unsplash`}
      width={ctaImage.width}
      height={ctaImage.height}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover photo-tone opacity-40"
    />
    <div
      class="pointer-events-none absolute inset-0 bg-linear-to-t from-inverted via-inverted/70 to-inverted/30"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative mx-auto flex w-full max-w-landing flex-col gap-10 px-container-x py-section sm:px-8 xl:px-14"
    >
      <div>
        <p
          class="mb-4 font-mono text-xs font-semibold tracking-widest text-inverted-foreground/70 uppercase"
        >
          Let's talk
        </p>
        <h2
          id="cta-final-heading"
          class="max-w-hero-heading text-balance text-headline-1 leading-[1.02] font-semibold text-inverted-foreground"
          data-split-reveal
        >
          A grandparent nearby is waiting to be asked how they really are.
        </h2>
        <p class="mt-6 max-w-copy text-lg text-inverted-foreground/80">
          Whether you're a family looking for accompaniment, or a community
          wanting to host a talk, we'd like to hear from you.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href="mailto:hello@example.com"
          class="inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-full border-0 bg-(--color-primary) px-7 py-3 text-base font-semibold text-(--color-light) no-underline transition duration-200 ease-landing hover:opacity-90 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-inverted-foreground active:opacity-90"
        >
          Get in touch
          <ArrowRight
            aria-hidden="true"
            width="18"
            height="18"
            stroke-width="1.5"
          />
        </a>
        <a
          href="mailto:hello@example.com"
          class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-inverted-foreground no-underline transition duration-200 ease-landing hover:opacity-80 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-inverted-foreground"
        >
          <Mail aria-hidden="true" width="16" height="16" stroke-width="1.5" />
          hello@example.com
        </a>
        <a
          href="tel:+00000000000"
          class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-inverted-foreground no-underline transition duration-200 ease-landing hover:opacity-80 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-inverted-foreground"
        >
          <Phone aria-hidden="true" width="16" height="16" stroke-width="1.5" />
          +00 000 000 000
        </a>
      </div>
    </div>
  </div>

  <div
    class="mx-auto w-full max-w-landing px-container-x py-3 sm:px-8 xl:px-14"
  >
    <PhotoCredit image={ctaImage} tone="inverted" />
  </div>
</section>
