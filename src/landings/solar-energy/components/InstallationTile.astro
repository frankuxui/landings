---
import Photo from "./Photo.astro"
import type { Installation } from "../types"

export interface Props {
  installation: Installation
}

const { installation } = Astro.props
---

<figure
  class:list={[
    "reveal m-0 flex flex-col gap-3",
    installation.span === "large" && "lg:col-span-4",
    installation.span === "medium" && "lg:col-span-2",
  ]}
>
  <Photo
    image={installation.image}
    ratio={installation.ratio}
    parallax={installation.span === "large"}
    caption={false}
  />
  <figcaption class="flex flex-col gap-1">
    <span class="font-mono text-xs text-muted uppercase">
      {installation.caption}
    </span>
    <span class="font-mono text-xs tracking-wide text-muted uppercase">
      Photo by{" "}
      <a
        href={installation.image.authorUrl}
        rel="noopener"
        target="_blank"
        class="underline underline-offset-2"
      >
        {installation.image.author}
      </a>{" "}
      on{" "}
      <a
        href={installation.image.unsplashUrl}
        rel="noopener"
        target="_blank"
        class="underline underline-offset-2"
      >
        Unsplash
      </a>
    </span>
  </figcaption>
</figure>
