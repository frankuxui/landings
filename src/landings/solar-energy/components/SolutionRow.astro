---
import Photo from "./Photo.astro"
import type { Solution } from "../types"

export interface Props {
  solution: Solution
  isFirst?: boolean
}

const { solution, isFirst = false } = Astro.props
---

<li
  class:list={[
    "reveal relative grid grid-cols-1 items-center gap-6 py-10 sm:grid-cols-[4rem_1fr] sm:gap-8 lg:grid-cols-[6rem_1fr_14rem] lg:gap-12 xl:py-12",
    !isFirst &&
      "before:absolute before:top-0 before:left-0 before:h-px before:w-full before:bg-foreground/10 before:content-['']",
  ]}
>
  <span
    class="font-mono text-2xl text-muted sm:text-3xl xl:text-4xl"
    aria-hidden="true">{solution.number}</span
  >
  <div class="max-w-copy">
    <h3
      class="text-balance text-headline-3 leading-tight font-semibold text-foreground"
    >
      {solution.title}
    </h3>
    <p class="mt-3 text-muted">
      {solution.description}
    </p>
  </div>
  <div class="hidden w-full lg:block">
    <Photo image={solution.image} ratio="4 / 3" />
  </div>
</li>
