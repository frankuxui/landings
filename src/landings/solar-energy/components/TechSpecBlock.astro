---
import { SunMedium, Cpu, Activity, BatteryCharging } from "@lucide/astro"
import type { TechSpec, TechSpecName } from "../types"

export interface Props {
  spec: TechSpec
}

const { spec } = Astro.props

const icons: Record<TechSpecName, typeof SunMedium> = {
  "Photovoltaic panels": SunMedium,
  Inverters: Cpu,
  Monitoring: Activity,
  Storage: BatteryCharging,
}

const Icon = icons[spec.title]
---

<div class="reveal flex h-full flex-col gap-5 bg-surface p-6 xl:p-8">
  <div class="flex items-center justify-between gap-4">
    <Icon
      class="size-7 text-foreground"
      aria-hidden="true"
      stroke-width="1.5"
    />
    <span class="font-mono text-xs text-muted">{spec.number}</span>
  </div>
  <h3
    class="text-balance text-headline-3 leading-tight font-semibold text-foreground"
  >
    {spec.title}
  </h3>
  <p class="text-muted">
    {spec.description}
  </p>
</div>
