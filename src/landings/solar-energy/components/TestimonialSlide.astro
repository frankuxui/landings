---
import type { Testimonial } from "../types"

export interface Props {
  testimonial: Testimonial
}

const { testimonial } = Astro.props
---

<figure
  class="reveal relative m-0 flex h-full flex-col justify-between gap-10 overflow-hidden bg-surface p-7 xl:p-9"
>
  <span
    class="pointer-events-none absolute -top-6 -left-2 font-serif text-[7rem] leading-none text-foreground/8 select-none"
    aria-hidden="true">”</span
  >
  <blockquote class="relative m-0 text-xl leading-snug sm:text-2xl">
    <p>{testimonial.quote}</p>
  </blockquote>
  <figcaption
    class="relative font-mono text-xs tracking-widest text-muted uppercase"
  >
    {testimonial.role}
  </figcaption>
</figure>
