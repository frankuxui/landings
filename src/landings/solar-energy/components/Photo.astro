---
// Real photography sourced from Unsplash via the `unsplash-images` Skill.
// Renders the persisted, hotlinked `images.unsplash.com` URL with this
// landing's monochrome treatment. Replaces the earlier ImagePlaceholder
// component now that every image slot has a real photograph — see
// src/landings/solar-energy/data/images.ts for the source metadata, and the
// consolidated "Photo credits" list in Footer.astro.
import type { UnsplashImage } from "../types"

type PhotoRatio = "1 / 1" | "3 / 4" | "4 / 3" | "16 / 10" | "9 / 16"

export interface Props {
  image: UnsplashImage
  ratio?: PhotoRatio
  /** Enables the subtle GSAP parallax enhancement in scripts/parallax.ts. */
  parallax?: boolean
  /** Applied to the outer wrapper — layout/position (e.g. `reveal`, width). */
  class?: string
  /** Render this component's own discreet "Photo by … on Unsplash" caption
   * below the image. Set to `false` when the call site composes its own
   * caption block instead — e.g. to merge the credit with a design caption,
   * or to lay out an absolutely-positioned overlay relative to the image box
   * itself (see Hero.astro). */
  caption?: boolean
}

const {
  image,
  ratio = "4 / 3",
  parallax = false,
  class: className,
  caption = true,
} = Astro.props

const ratioClass =
  ratio === "1 / 1"
    ? "aspect-square"
    : ratio === "3 / 4"
      ? "aspect-3/4"
      : ratio === "16 / 10"
        ? "aspect-16/10"
        : ratio === "9 / 16"
          ? "aspect-9/16"
          : "aspect-4/3"
---

<div class:list={["w-full", className]}>
  <div class:list={["relative w-full overflow-hidden", ratioClass]}>
    <div
      class:list={["absolute inset-0", parallax && "scale-115"]}
      data-parallax={parallax ? "true" : undefined}
    >
      <img
        src={image.src}
        alt={image.alt}
        title={`Photo by ${image.author} on Unsplash`}
        width={image.width}
        height={image.height}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover photo-tone"
      />
    </div>
  </div>
  {
    caption && (
      <p class="mt-2 font-mono text-xs tracking-wide text-muted uppercase">
        Photo by{" "}
        <a
          href={image.authorUrl}
          rel="noopener"
          target="_blank"
          class="underline underline-offset-2"
        >
          {image.author}
        </a>{" "}
        on{" "}
        <a
          href={image.unsplashUrl}
          rel="noopener"
          target="_blank"
          class="underline underline-offset-2"
        >
          Unsplash
        </a>
      </p>
    )
  }
</div>
