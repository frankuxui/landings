---
// Solar Energy - root document for this landing.
// Fully self-contained: no platform Layout, no platform CSS/components.
// Rendered in isolation by src/pages/landings/[slug]/render.astro.
import "./styles/tailwind.css"

import Header from "./sections/Header.astro"
import Hero from "./sections/Hero.astro"
import Transition from "./sections/Transition.astro"
import Technology from "./sections/Technology.astro"
import Solutions from "./sections/Solutions.astro"
import Process from "./sections/Process.astro"
import Installations from "./sections/Installations.astro"
import Impact from "./sections/Impact.astro"
import Testimonials from "./sections/Testimonials.astro"
import Editorial from "./sections/Editorial.astro"
import Trust from "./sections/Trust.astro"
import CTAFinal from "./sections/CTAFinal.astro"
import Contact from "./sections/Contact.astro"
import Footer from "./sections/Footer.astro"
import BackToTop from "./components/BackToTop.astro"

const pageTitle = "Solar Energy - Photovoltaic solar power systems"
const pageDescription =
  "Solar Energy analyzes, designs, installs, and monitors photovoltaic solar energy systems for homes, businesses, industries, and organizations that want to reduce their reliance on the grid and move toward the energy transition."
const canonicalUrl = "/landings/solar-energy"
const thumbnailUrl =
  "https://images.unsplash.com/photo-1629726797843-618688139f5a?ixid=M3wxMDQwNDk5fDB8MXxzZWFyY2h8M3x8c29sYXIlMjBwYW5lbHMlMjBmaWVsZCUyMGluc3RhbGxhdGlvbnxlbnwxfDB8fHwxNzg3NDc1NzM3fDA&ixlib=rb-4.1.0&w=1200&auto=format&fit=crop&q=80"
---

<!doctype html>
<html
  lang="en"
  class="scroll-smooth overflow-x-clip scheme-light motion-reduce:scroll-auto dark:scheme-dark font-sans"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Restore the persisted theme choice before first paint, so this
    landing's own toggle survives a reload when viewed standalone (outside
    the platform preview shell). -->
    <script is:inline>
      ;(function () {
        const saved = localStorage.getItem("solar-energy:theme")
        if (saved === "dark" || saved === "light") {
          document.documentElement.setAttribute("data-theme", saved)
        }
      })()
    </script>

    <!-- Shared Landing Pages typeface — Wix Madefor Text (Google Fonts).
    Every landing loads the exact same weights/styles here; never via
    @import in CSS, and never a different family. See "Shared typography"
    in the astro-landing-pages Skill. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Wix+Madefor+Text:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />

    <!-- This document is only ever embedded as the preview iframe's render
    target (/landings/solar-energy/render). The indexable, canonical page
    for this landing is the platform's own detail page. -->
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="noindex" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={thumbnailUrl} />
    <meta property="og:url" content={canonicalUrl} />
  </head>
  <body
    class="min-h-full overflow-x-clip bg-background text-base leading-relaxed text-foreground antialiased font-sans"
  >
    <a
      class="absolute -top-full left-4 z-1000 inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-sm border-0 bg-primary px-5 py-3 text-base font-semibold text-primary-foreground no-underline transition duration-200 ease-landing focus-visible:top-4 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border hover:bg-emphasis active:bg-emphasis"
      href="#main-content"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main-content">
      <Hero />
      <Transition />
      <Technology />
      <Solutions />
      <Process />
      <Installations />
      <Impact />
      <Testimonials />
      <Editorial />
      <Trust />
      <CTAFinal />
      <Contact />
    </main>

    <Footer />

    <BackToTop />

    <script>
      import "./scripts/theme"
      import "./scripts/reveal"
      import "./scripts/navIndicator"
      import "./scripts/parallax"
      import "./scripts/backToTop"
    </script>
  </body>
</html>
