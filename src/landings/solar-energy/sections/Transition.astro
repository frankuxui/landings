---
import Photo from "../components/Photo.astro"
import { transitionImage } from "../data/images"

interface Statement {
  title: string
  description: string
}

const statements: Statement[] = [
  {
    title: "Less dependence on the grid",
    description:
      "Every installation reduces the share of consumption that relies exclusively on external supply.",
  },
  {
    title: "Generation where it's used",
    description:
      "Electricity is produced where it's consumed, without the losses that come with long-distance transport.",
  },
  {
    title: "Measurable decisions",
    description:
      "Every project comes with real production data, not a generic catalog estimate.",
  },
]
---

<section
  class="bg-inverted text-inverted-foreground"
  aria-labelledby="transition-heading"
>
  <div class="w-full px-container-x pt-section pb-16 sm:px-8 xl:px-14">
    <p
      class="mb-6 font-mono text-xs font-semibold tracking-widest text-current/70 uppercase"
    >
      Energy transition
    </p>
    <h2
      id="transition-heading"
      class="max-w-hero-heading text-balance text-headline-1 leading-[0.98] font-bold text-current"
    >
      Cutting dependence on fossil fuels starts on the roof.
    </h2>
    <p class="mt-8 max-w-copy text-lg text-current/80 sm:text-xl">
      Every photovoltaic system we bring online is a concrete decision: less
      consumption tied to the conventional grid, more distributed generation,
      and an energy setup designed at the real scale of each project — whether
      that's a home, an industrial warehouse, or an entire neighborhood
      community.
    </p>
  </div>

  <Photo
    image={transitionImage}
    ratio="16 / 10"
    parallax
    caption={false}
    class="w-full"
  />
  <p class="w-full px-container-x pt-2 sm:px-8 xl:px-14">
    <span class="font-mono text-xs tracking-wide text-current/60 uppercase">
      Photo by{" "}
      <a
        href={transitionImage.authorUrl}
        rel="noopener"
        target="_blank"
        class="underline underline-offset-2">{transitionImage.author}</a
      >{" "}
      on{" "}
      <a
        href={transitionImage.unsplashUrl}
        rel="noopener"
        target="_blank"
        class="underline underline-offset-2">Unsplash</a
      >
    </span>
  </p>

  <div class="w-full px-container-x py-16 sm:px-8 xl:px-14">
    <ul
      class="grid grid-cols-1 gap-10 sm:grid-cols-3 sm:gap-8"
      aria-label="Energy transition commitments"
    >
      {
        statements.map((statement: Statement, index: number) => (
          <li
            class:list={[
              "reveal relative pt-6",
              index !== 0 &&
                "before:absolute before:top-0 before:left-0 before:h-px before:w-full before:bg-current/15 before:content-[''] sm:before:h-full sm:before:w-px sm:pt-0 sm:pl-8",
            ]}
          >
            <h3 class="text-lg font-semibold text-current sm:text-xl">
              {statement.title}
            </h3>
            <p class="mt-3 text-current/75">{statement.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
