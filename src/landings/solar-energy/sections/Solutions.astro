---
import SolutionRow from "../components/SolutionRow.astro"
import { solutions } from "../data/solutions"
import type { Solution } from "../types"
---

<section
  class="bg-background py-section"
  id="solutions"
  aria-labelledby="solutions-heading"
>
  <div class="w-full px-container-x sm:px-8 xl:px-14">
    <div class="mb-6 max-w-5xl">
      <p
        class="mb-4 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
      >
        Solutions
      </p>
      <h2
        id="solutions-heading"
        class="text-balance text-headline-2 leading-tight font-semibold text-foreground"
      >
        One system, five ways to apply it.
      </h2>
    </div>

    <ul aria-label="Solar Energy's photovoltaic solutions">
      {
        solutions.map((solution: Solution, index: number) => (
          <SolutionRow solution={solution} isFirst={index === 0} />
        ))
      }
    </ul>
  </div>
</section>
