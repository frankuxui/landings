---
import { Menu, X, LayoutGrid, ArrowRight } from "@lucide/astro"
import { navLinks } from "../data/nav"
import type { NavLink } from "../types"
---

<header
  class="fixed top-0 z-40 w-full bg-background/95 shadow-[0_1px_0_0_rgb(0_0_0/0.08)] backdrop-blur-md"
>
  <div
    class="mx-auto flex w-full max-w-landing items-center justify-between gap-4 px-container-x py-4 sm:px-8 xl:px-14"
  >
    <a
      class="inline-flex items-center gap-3 text-foreground no-underline"
      href="#inicio"
    >
      <span
        class="inline-flex size-9 items-center justify-center rounded-sm bg-primary text-primary-foreground"
        aria-hidden="true"
      >
        <LayoutGrid width="18" height="18" stroke-width="1.75" />
      </span>
      <span class="text-lg font-semibold tracking-tight sm:text-xl"
        >Heliogrid</span
      >
    </a>

    <nav
      class="hidden items-center gap-1 nav:flex"
      aria-label="Navegación principal"
    >
      <div class="relative" data-scroll-nav>
        <span
          class="pointer-events-none absolute bottom-0 left-0 z-0 h-px w-0 bg-foreground opacity-0"
          data-nav-indicator
          aria-hidden="true"></span>
        <ul class="relative z-10 flex items-center gap-1">
          {
            navLinks.map((link: NavLink, index: number) => (
              <li>
                <a
                  class="relative flex min-h-11 items-center gap-2 px-3 py-2 text-sm font-medium text-foreground no-underline hover:text-emphasis focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
                  href={link.href}
                  data-nav-link
                  aria-current={index === 0 ? "location" : undefined}
                >
                  <span class="font-mono text-xs text-muted" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <a
      class="hidden min-h-11 cursor-pointer items-center gap-2 rounded-sm border-0 bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground no-underline transition duration-200 ease-landing hover:bg-emphasis focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-emphasis nav:inline-flex"
      href="#contacto"
    >
      Solicitar estudio
      <ArrowRight
        aria-hidden="true"
        width="16"
        height="16"
        stroke-width="1.5"
      />
    </a>

    <button
      type="button"
      class="group relative z-60 inline-flex size-11 min-h-11 cursor-pointer items-center justify-center rounded-sm border-0 bg-transparent p-0 text-foreground transition duration-200 ease-landing hover:bg-control focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-control-hover aria-expanded:bg-control nav:hidden"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="primary-navigation-mobile"
      aria-label="Abrir menú de navegación"
    >
      <Menu
        class="size-5.5 group-aria-expanded:hidden"
        aria-hidden="true"
        stroke-width="1.5"
      />
      <X
        class="hidden size-5.5 group-aria-expanded:block"
        aria-hidden="true"
        stroke-width="1.5"
      />
    </button>
  </div>

  <div
    class="fixed inset-0 z-50 flex h-dvh w-full translate-y-0 flex-col justify-between bg-background px-container-x pt-24 pb-10 text-foreground transition-[transform,visibility] duration-300 ease-landing aria-hidden:invisible aria-hidden:-translate-y-full motion-reduce:transition-none sm:px-8 nav:hidden"
    data-menu-panel
    aria-hidden="true"
  >
    <nav id="primary-navigation-mobile" aria-label="Navegación principal">
      <ol class="flex flex-col">
        {
          navLinks.map((link: NavLink, index: number) => (
            <li class="relative before:absolute before:top-0 before:left-0 before:h-px before:w-full before:bg-current/12 before:content-[''] first:before:hidden">
              <a
                class="flex min-h-16 items-center gap-4 py-3 text-3xl font-semibold text-foreground no-underline hover:text-emphasis focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border sm:text-4xl"
                href={link.href}
                data-mobile-nav-link
              >
                <span class="font-mono text-sm text-muted">
                  {String(index + 1).padStart(2, "0")}
                </span>
                {link.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <a
      class="inline-flex min-h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-sm border-0 bg-primary px-6 py-3 text-base font-semibold text-primary-foreground no-underline transition duration-200 ease-landing hover:bg-emphasis focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-emphasis"
      href="#contacto"
      data-mobile-nav-link
    >
      Solicitar estudio energético
      <ArrowRight
        aria-hidden="true"
        width="18"
        height="18"
        stroke-width="1.5"
      />
    </a>
  </div>
</header>

<script>
  import "../scripts/menu"
</script>
