---
import { sectors } from "../data/sectors"
---

<section class="bg-background-alt py-16" aria-labelledby="trust-heading">
  <div class="w-full px-container-x text-center sm:px-8 xl:px-14">
    <h2
      id="trust-heading"
      class="mb-8 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
    >
      We work with
    </h2>
    <p
      class="mx-auto flex max-w-landing flex-wrap items-center justify-center gap-x-3 gap-y-3 text-balance text-2xl font-semibold text-foreground sm:text-3xl xl:text-4xl"
    >
      {
        sectors.map((sector: string) => (
          <span class="inline-flex h-10 items-center justify-center rounded-sm bg-foreground/10 px-6 py-2 text-sm font-semibold text-foreground sm:text-base">
            {sector}
          </span>
        ))
      }
    </p>
  </div>
</section>
