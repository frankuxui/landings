---
import { MapPin, Phone, Mail, Clock } from "@lucide/astro"
---

<section
  class="bg-background-alt py-section"
  id="contacto"
  aria-labelledby="contacto-heading"
>
  <div
    class="mx-auto grid w-full max-w-landing gap-16 px-container-x sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start xl:gap-24 xl:px-14"
  >
    <div class="reveal">
      <p
        class="mb-4 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
      >
        Contacto
      </p>
      <h2
        id="contacto-heading"
        class="max-w-heading text-balance text-headline-2 leading-tight font-semibold text-foreground"
      >
        Hablemos de tu instalación.
      </h2>
      <p class="mt-5 text-base text-muted sm:text-lg">
        Ya representes un hogar, una empresa, una industria o una organización,
        respondemos en menos de 48 horas laborables con los siguientes pasos.
      </p>

      <address class="mt-10 flex flex-col gap-5 not-italic">
        <p class="flex items-center gap-3">
          <MapPin
            class="shrink-0"
            aria-hidden="true"
            width="20"
            height="20"
            stroke-width="1.5"
          />
          <span>Dirección de ejemplo, Ciudad, País</span>
        </p>
        <p class="flex items-center gap-3">
          <Phone
            class="shrink-0"
            aria-hidden="true"
            width="20"
            height="20"
            stroke-width="1.5"
          />
          <a
            class="underline underline-offset-3 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
            href="tel:+00000000000">+00 000 000 000</a
          >
        </p>
        <p class="flex items-center gap-3">
          <Mail
            class="shrink-0"
            aria-hidden="true"
            width="20"
            height="20"
            stroke-width="1.5"
          />
          <a
            class="underline underline-offset-3 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
            href="mailto:correo@ejemplo.com">correo@ejemplo.com</a
          >
        </p>
        <p class="flex items-center gap-3">
          <Clock
            class="shrink-0"
            aria-hidden="true"
            width="20"
            height="20"
            stroke-width="1.5"
          />
          <span>Horario de ejemplo</span>
        </p>
      </address>
    </div>

    <form
      class="reveal flex flex-col gap-6 bg-surface p-8 sm:p-10 xl:p-12"
      action="mailto:correo@ejemplo.com"
      method="post"
      enctype="text/plain"
    >
      <div class="flex flex-col gap-1">
        <label class="text-sm font-semibold" for="contact-name">Nombre</label>
        <input
          class="h-11 w-full min-w-0 rounded-xs border border-border bg-transparent px-3 py-2 text-base outline-none placeholder:text-muted focus-scan disabled:pointer-events-none disabled:cursor-not-allowed disabled:bg-control/50 disabled:opacity-50 aria-invalid:border-2 aria-invalid:border-foreground aria-invalid:ring-3 aria-invalid:ring-foreground/20"
          type="text"
          id="contact-name"
          name="nombre"
          autocomplete="name"
          required
        />
      </div>

      <div class="flex flex-col gap-1">
        <label class="text-sm font-semibold" for="contact-email"
          >Correo electrónico</label
        >
        <input
          class="h-11 w-full min-w-0 rounded-xs border border-border bg-transparent px-3 py-2 text-base outline-none placeholder:text-muted focus-scan disabled:pointer-events-none disabled:cursor-not-allowed disabled:bg-control/50 disabled:opacity-50 aria-invalid:border-2 aria-invalid:border-foreground aria-invalid:ring-3 aria-invalid:ring-foreground/20"
          type="email"
          id="contact-email"
          name="email"
          autocomplete="email"
          inputmode="email"
          required
        />
      </div>

      <div class="flex flex-col gap-1">
        <label class="text-sm font-semibold" for="contact-profile"
          >Perfil (hogar, empresa, industria u organización)</label
        >
        <input
          class="h-11 w-full min-w-0 rounded-xs border border-border bg-transparent px-3 py-2 text-base outline-none placeholder:text-muted focus-scan disabled:pointer-events-none disabled:cursor-not-allowed disabled:bg-control/50 disabled:opacity-50 aria-invalid:border-2 aria-invalid:border-foreground aria-invalid:ring-3 aria-invalid:ring-foreground/20"
          type="text"
          id="contact-profile"
          name="perfil"
          autocomplete="organization"
        />
      </div>

      <div class="flex flex-col gap-1">
        <label class="text-sm font-semibold" for="contact-message"
          >Mensaje</label
        >
        <textarea
          class="min-h-32 w-full min-w-0 resize-y rounded-xs border border-border bg-transparent px-3 py-2 text-base outline-none placeholder:text-muted focus-scan disabled:pointer-events-none disabled:cursor-not-allowed disabled:bg-control/50 disabled:opacity-50 aria-invalid:border-2 aria-invalid:border-foreground aria-invalid:ring-3 aria-invalid:ring-foreground/20"
          id="contact-message"
          name="mensaje"
          rows="4"
          required></textarea>
      </div>

      <button
        type="submit"
        class="inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 self-start rounded-sm border-0 bg-primary px-6 py-3 text-base font-semibold text-primary-foreground no-underline transition duration-200 ease-landing hover:bg-emphasis focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-emphasis"
      >
        Enviar mensaje
      </button>
    </form>
  </div>
</section>
