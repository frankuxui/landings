---
import InstallationTile from "../components/InstallationTile.astro"
import { installations } from "../data/installations"
import type { Installation } from "../types"
---

<section
  class="bg-background py-section"
  aria-labelledby="installations-heading"
>
  <div class="w-full px-container-x sm:px-8 xl:px-14">
    <div class="mb-12 sm:mb-16">
      <p
        class="mb-4 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
      >
        Installations
      </p>
      <h2
        id="installations-heading"
        class="max-w-heading text-balance text-headline-2 leading-tight font-semibold text-foreground"
      >
        Example projects, different scales.
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-6 xl:gap-10">
      {
        installations.map((installation: Installation) => (
          <InstallationTile installation={installation} />
        ))
      }
    </div>
  </div>
</section>
