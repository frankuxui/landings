---
import ArticleBlock from "../components/ArticleBlock.astro"
import { articles } from "../data/articles"
import type { Article } from "../types"
---

<section class="bg-background py-section" aria-labelledby="editorial-heading">
  <div class="mx-auto w-full max-w-copy px-container-x sm:px-8 xl:px-0">
    <p
      class="mb-4 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
    >
      Technical notes
    </p>
    <h2
      id="editorial-heading"
      class="text-balance text-headline-2 leading-tight font-semibold text-foreground"
    >
      Understanding solar energy before installing it.
    </h2>

    <div class="mt-4">
      {
        articles.map((article: Article, index: number) => (
          <ArticleBlock article={article} isFirst={index === 0} />
        ))
      }
    </div>
  </div>
</section>
