---
import ProcessStepRow from "../components/ProcessStepRow.astro"
import { processSteps } from "../data/process"
import type { ProcessStep } from "../types"
---

<section
  class="bg-background-alt py-section"
  id="proceso"
  aria-labelledby="proceso-heading"
>
  <div
    class="mx-auto grid w-full max-w-landing gap-12 px-container-x sm:px-8 lg:grid-cols-[0.7fr_1.3fr] lg:items-start xl:gap-20 xl:px-14"
  >
    <div class="reveal lg:sticky lg:top-28" data-process-sticky>
      <p
        class="mb-4 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
      >
        Cómo funciona
      </p>
      <h2
        id="proceso-heading"
        class="max-w-heading text-balance text-headline-2 leading-tight font-semibold text-foreground"
      >
        Seis etapas hasta el kilovatio propio.
      </h2>
      <p class="mt-5 text-base text-muted sm:text-lg">
        Desde el primer análisis hasta la optimización continua, cada
        instalación sigue el mismo proceso ordenado: nada se instala sin haberse
        diseñado antes.
      </p>
      <p class="mt-8 font-mono text-sm text-muted" aria-hidden="true">
        Etapa <span data-process-counter>01</span> / {
          String(processSteps.length).padStart(2, "0")
        }
      </p>
    </div>

    <div class="relative" data-process-track>
      <div
        class="absolute top-0 bottom-0 left-6 w-px bg-foreground/10 sm:left-8"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute top-0 left-6 w-px origin-top bg-foreground sm:left-8"
        data-process-fill
        aria-hidden="true"
      >
      </div>

      <ol class="relative" aria-label="Etapas del proceso de instalación">
        {
          processSteps.map((step: ProcessStep, index: number) => (
            <ProcessStepRow step={step} index={index} />
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import "../scripts/processProgress"
</script>
