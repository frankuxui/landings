---
import Photo from "../components/Photo.astro"
import { reelImage } from "../data/images"
import { gear, tips, type Gear, type Tip } from "../data/content"
---

<section id="field-guide" class="px-container-x py-section">
  <div class="mx-auto max-w-landing">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <header class="lg:sticky lg:top-28 lg:col-span-4 lg:self-start">
        <p class="mb-4 text-xs font-bold tracking-widest uppercase">
          Field guide / equipment
        </p>
        <h2
          class="max-w-heading text-balance text-headline-2 leading-tight font-semibold tracking-tight"
        >
          Carry less. Know every piece better.
        </h2>
        <p class="mt-6 max-w-copy text-muted">
          The working kit is selected around movement, reliability, and the
          conditions likely to end the day—not around owning more.
        </p>
        <div class="mt-8">
          <Photo image={reelImage} class="aspect-square w-full" />
        </div>
      </header>
      <div class="lg:col-span-8">
        <div class="space-y-px bg-border">
          {
            gear.map((item: Gear, index: number) => (
              <article
                class="grid gap-5 bg-background p-6 sm:grid-cols-[4rem_1fr] md:p-8"
                data-reveal
              >
                <span class="font-mono text-sm text-muted">0{index + 1}</span>
                <div class="grid gap-5 md:grid-cols-[0.8fr_1.2fr]">
                  <div>
                    <>
                      <p class="text-xs font-bold tracking-widest uppercase text-muted">
                        {item.type}
                      </p>
                      <h3 class="mt-2 text-headline-3 leading-tight font-semibold">
                        {item.name}
                      </h3>
                    </>
                  </div>
                  <div>
                    <>
                      <p>{item.reason}</p>
                      <p class="mt-4 text-sm text-muted">
                        Field note — {item.fieldNote}
                      </p>
                    </>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
    <div class="mt-section grid gap-12 lg:grid-cols-12">
      <header class="lg:sticky lg:top-28 lg:col-span-4 lg:self-start">
        <p class="mb-4 text-xs font-bold tracking-widest uppercase">
          Expert notes
        </p><h2
          class="max-w-heading text-balance text-headline-2 leading-tight font-semibold tracking-tight"
        >
          Five decisions that improve almost every session.
        </h2>
      </header>
      <ol class="lg:col-span-8">
        {
          tips.map((tip: Tip, index: number) => (
            <li
              class="grid gap-4 border-t border-border py-7 sm:grid-cols-[4rem_0.8fr_1.2fr]"
              data-reveal
            >
              <>
                <span class="font-mono text-sm text-muted">0{index + 1}</span>
                <strong class="text-lg">{tip.title}</strong>
                <p class="text-muted">{tip.guidance}</p>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
