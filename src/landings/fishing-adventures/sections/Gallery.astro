---
import Photo from "../components/Photo.astro"
import { galleryImages } from "../data/images"
---

<section
  id="gallery"
  class="bg-inverted palette-surface-primary px-container-x py-section text-inverted-foreground"
>
  <div class="mx-auto max-w-landing">
    <header class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="mb-4 text-xs font-bold tracking-widest uppercase">
          Immersive log
        </p><h2
          class="max-w-heading text-balance text-headline-2 leading-tight font-semibold tracking-tight"
        >
          Water, weather, hands, and the trail between.
        </h2>
      </div><p class="max-w-copy text-lg opacity-75 lg:justify-self-end">
        A visual record of the quiet work around each cast: arriving, watching,
        adjusting, and returning with better questions.
      </p>
    </header>
    <div class="mt-12 grid gap-5 md:grid-cols-12">
      <div class="md:col-span-7">
        <Photo image={galleryImages[0]} class="aspect-16/10 w-full" />
      </div>
      <div class="md:col-span-5 md:pt-24">
        <Photo image={galleryImages[1]} class="aspect-4/5 w-full" />
      </div>
      <div class="md:col-span-4">
        <Photo image={galleryImages[2]} class="aspect-4/5 w-full" />
      </div>
      <div class="md:col-span-8 md:pt-16">
        <Photo image={galleryImages[3]} class="aspect-16/10 w-full" />
      </div>
    </div>
  </div>
</section>
