---
// Budapest — "The City Between Two Worlds"
// Root document for this landing. Fully self-contained.
// Strictly monochrome by default with three thematic palettes
// (Archive, Winter, Summer) switchable via the preview toolbar.
import "./styles/tailwind.css"

import Header from "./sections/Header.astro"
import Hero from "./sections/Hero.astro"
import River from "./sections/River.astro"
import BudaPest from "./sections/BudaPest.astro"
import Bridges from "./sections/Bridges.astro"
import Monuments from "./sections/Monuments.astro"
import ThenNow from "./sections/ThenNow.astro"
import Unification from "./sections/Unification.astro"
import Details from "./sections/Details.astro"
import Words from "./sections/Words.astro"
import Seasons from "./sections/Seasons.astro"
import Thermal from "./sections/Thermal.astro"
import Cafe from "./sections/Cafe.astro"
import Stories from "./sections/Stories.astro"
import Gallery from "./sections/Gallery.astro"
import Footer from "./sections/Footer.astro"
import BackToTop from "./components/BackToTop.astro"

const pageTitle = "Budapest — The City Between Two Worlds"
const pageDescription =
  "An editorial digital experience exploring the architecture, history, and atmosphere of Budapest — bridges, thermal baths, imperial monuments, and the Danube that unites two cities."
const canonicalUrl = "/landings/budapest"
const thumbnailUrl =
  "https://images.unsplash.com/photo-1616432902940-b7a1acbc60b3?ixid=M3wxMDQwNDk5fDB8MXxzZWFyY2h8MXx8YnVkYXBlc3QlMjBkYW51YmUlMjBwYXJsaWFtZW50JTIwcGFub3JhbWF8ZW58MHwwfHx8MTc4Nzk5MTQzMXww&ixlib=rb-4.1.0&w=1200&auto=format&fit=crop&q=80"
---

<!doctype html>
<html
  lang="en"
  class="scroll-smooth overflow-x-clip scheme-light motion-reduce:scroll-auto dark:scheme-dark font-sans"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Restore persisted theme before first paint -->
    <script is:inline>
      ;(function () {
        var saved = localStorage.getItem("budapest:theme")
        if (saved === "dark" || saved === "light") {
          document.documentElement.setAttribute("data-theme", saved)
        }
      })()
    </script>

    <!-- Restore persisted palette before first paint -->
    <script is:inline>
      try {
        var storedPalette = localStorage.getItem("budapest:palette")
        if (storedPalette)
          document.documentElement.dataset.palette = storedPalette
      } catch (error) {}
    </script>

    <!-- Google Fonts — Bodoni Moda (display) + Manrope (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Manrope:wght@200..800&display=swap"
      rel="stylesheet"
    />

    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="noindex" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={thumbnailUrl} />
    <meta property="og:url" content={canonicalUrl} />
  </head>
  <body
    class="min-h-full overflow-x-clip bg-background text-base leading-relaxed text-foreground antialiased font-sans"
  >
    <a
      class="absolute -top-full left-4 z-1000 inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-sm border-0 bg-(--color-primary) px-5 py-3 text-base font-semibold text-(--color-light) no-underline transition duration-200 ease-landing hover:opacity-90 focus-visible:top-4 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:opacity-90"
      href="#main-content"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main-content">
      <Hero />
      <River />
      <BudaPest />
      <Bridges />
      <Monuments />
      <ThenNow />
      <Unification />
      <Details />
      <Words />
      <Seasons />
      <Thermal />
      <Cafe />
      <Stories />
      <Gallery />
    </main>

    <Footer />

    <BackToTop />

    <script>
      import "./scripts/theme"
      import "./scripts/palette"
      import "./scripts/reveal"
      import "./scripts/motion"
      import "./scripts/thenNow"
      import "./scripts/words"
      import "./scripts/backToTop"
    </script>
  </body>
</html>
