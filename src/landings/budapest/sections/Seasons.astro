---
import { winterImage, winterPanoramaImage, heroImage } from "../data/images"
---

<section
  id="seasons"
  class="seasons-experience relative overflow-hidden bg-background py-section"
  aria-labelledby="seasons-heading"
  data-seasons
>
  <div class="mx-auto max-w-landing px-container-x sm:px-8 xl:px-14">
    <p
      class="reveal mb-6 text-xs font-medium uppercase tracking-[0.2em] text-muted"
    >
      Winter / Summer
    </p>

    <h2
      id="seasons-heading"
      class="reveal max-w-heading font-display text-headline-1 font-bold leading-[1.05] text-foreground"
    >
      Two Seasons. Two Cities.
    </h2>

    <p
      class="reveal mt-6 max-w-copy text-base leading-relaxed text-muted sm:text-lg"
    >
      Budapest transforms completely between winter and summer. The same
      bridges, the same buildings, the same river — but a different city
      depending on the light.
    </p>
  </div>

  <!-- Winter block -->
  <div class="season-chapter mt-16 sm:mt-24" data-season-chapter="winter">
    <div class="mx-auto max-w-landing px-container-x sm:px-8 xl:px-14">
      <div class="grid gap-8 lg:grid-cols-5 lg:gap-12">
        <div class="flex flex-col justify-center lg:col-span-2">
          <span
            class="reveal font-display text-figure font-black leading-none text-foreground/[0.06]"
            aria-hidden="true"
          >
            Winter
          </span>
          <h3
            class="reveal mt-4 font-display text-headline-2 font-bold text-foreground"
          >
            When the Danube Turns Silver
          </h3>
          <p class="reveal mt-4 text-sm leading-relaxed text-muted">
            December through February, Budapest retreats into itself. Fog
            settles on the river, the bridges become silhouettes, Parliament
            emerges from the mist like a memory of something grand. The thermal
            baths release clouds of steam into the frozen air. The city becomes
            quieter, more introspective — a version of itself that only winter
            reveals.
          </p>
          <blockquote class="reveal mt-6 border-l-2 border-border/30 pl-4">
            <p class="font-display text-sm font-bold italic text-foreground/60">
              "When winter arrives, the Danube turns silver."
            </p>
          </blockquote>
        </div>

        <figure class="reveal lg:col-span-3">
          <div class="overflow-hidden rounded-sm">
            <img
              src={`${winterImage.src}&w=1200&auto=format&fit=crop&q=80`}
              srcset={`${winterImage.src}&w=600&auto=format&fit=crop&q=80 600w, ${winterImage.src}&w=900&auto=format&fit=crop&q=80 900w, ${winterImage.src}&w=1200&auto=format&fit=crop&q=80 1200w`}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 720px"
              alt={winterImage.alt}
              title={`Photo by ${winterImage.author} on Unsplash`}
              width={winterImage.width}
              height={winterImage.height}
              loading="lazy"
              decoding="async"
              class="photo-tone aspect-[16/10] w-full object-cover"
            />
          </div>
          <figcaption class="mt-3 text-xs text-muted">
            Photo by <a
              href={winterImage.authorUrl}
              class="underline hover:text-foreground"
              rel="noopener">{winterImage.author}</a
            >
            on <a
              href={winterImage.unsplashUrl}
              class="underline hover:text-foreground"
              rel="noopener">Unsplash</a
            >
          </figcaption>
        </figure>
      </div>
    </div>

    <!-- Winter panorama — full bleed -->
    <figure
      class="reveal mx-auto mt-12 max-w-landing px-container-x sm:px-8 xl:px-14"
    >
      <div class="overflow-hidden rounded-sm">
        <img
          src={`${winterPanoramaImage.src}&w=1600&auto=format&fit=crop&q=80`}
          srcset={`${winterPanoramaImage.src}&w=800&auto=format&fit=crop&q=80 800w, ${winterPanoramaImage.src}&w=1200&auto=format&fit=crop&q=80 1200w, ${winterPanoramaImage.src}&w=1600&auto=format&fit=crop&q=80 1600w`}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 1200px"
          alt={winterPanoramaImage.alt}
          title={`Photo by ${winterPanoramaImage.author} on Unsplash`}
          width={winterPanoramaImage.width}
          height={winterPanoramaImage.height}
          loading="lazy"
          decoding="async"
          class="photo-tone aspect-[21/9] w-full object-cover"
        />
      </div>
      <figcaption class="mt-3 text-xs text-muted">
        Photo by <a
          href={winterPanoramaImage.authorUrl}
          class="underline hover:text-foreground"
          rel="noopener">{winterPanoramaImage.author}</a
        >
        on <a
          href={winterPanoramaImage.unsplashUrl}
          class="underline hover:text-foreground"
          rel="noopener">Unsplash</a
        >
      </figcaption>
    </figure>
  </div>

  <!-- Summer block -->
  <div class="season-chapter mt-24 sm:mt-32" data-season-chapter="summer">
    <div class="mx-auto max-w-landing px-container-x sm:px-8 xl:px-14">
      <div class="grid gap-8 lg:grid-cols-5 lg:gap-12">
        <figure class="reveal lg:col-span-3">
          <div class="overflow-hidden rounded-sm">
            <img
              src={`${heroImage.src}&w=1200&auto=format&fit=crop&q=80`}
              srcset={`${heroImage.src}&w=600&auto=format&fit=crop&q=80 600w, ${heroImage.src}&w=900&auto=format&fit=crop&q=80 900w, ${heroImage.src}&w=1200&auto=format&fit=crop&q=80 1200w`}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 720px"
              alt="Parliament building and the Danube bathed in golden summer light"
              title={`Photo by ${heroImage.author} on Unsplash`}
              width={heroImage.width}
              height={heroImage.height}
              loading="lazy"
              decoding="async"
              class="photo-tone aspect-[16/10] w-full object-cover"
            />
          </div>
          <figcaption class="mt-3 text-xs text-muted">
            Photo by <a
              href={heroImage.authorUrl}
              class="underline hover:text-foreground"
              rel="noopener">{heroImage.author}</a
            >
            on <a
              href={heroImage.unsplashUrl}
              class="underline hover:text-foreground"
              rel="noopener">Unsplash</a
            >
          </figcaption>
        </figure>

        <div class="flex flex-col justify-center lg:col-span-2">
          <span
            class="reveal font-display text-figure font-black leading-none text-foreground/[0.06]"
            aria-hidden="true"
          >
            Summer
          </span>
          <h3
            class="reveal mt-4 font-display text-headline-2 font-bold text-foreground"
          >
            When the City Turns Gold
          </h3>
          <p class="reveal mt-4 text-sm leading-relaxed text-muted">
            May through September, Budapest opens outward. Terraces fill the
            streets, the Danube catches the evening light, and the city's
            Neo-Renaissance facades glow in shades of ochre and gold. Margaret
            Island becomes a garden city. The ruin bars fill with voices. Sunset
            arrives late and leaves slowly, painting Parliament in colors that
            photography can only approximate.
          </p>
          <blockquote class="reveal mt-6 border-l-2 border-border/30 pl-4">
            <p class="font-display text-sm font-bold italic text-foreground/60">
              "When summer arrives, the city turns gold."
            </p>
          </blockquote>
        </div>
      </div>
    </div>
  </div>
</section>
