---
// Journalist Dispatch - root document for this landing.
// Fully self-contained: no platform Layout, no platform CSS/components.
// Rendered in isolation by src/pages/landings/[slug]/render.astro.
import "./styles/tailwind.css"

import Header from "./sections/Header.astro"
import Hero from "./sections/Hero.astro"
import Manifesto from "./sections/Manifesto.astro"
import Feature from "./sections/Feature.astro"
import Stories from "./sections/Stories.astro"
import Investigations from "./sections/Investigations.astro"
import Gallery from "./sections/Gallery.astro"
import FieldNotes from "./sections/FieldNotes.astro"
import Timeline from "./sections/Timeline.astro"
import Quote from "./sections/Quote.astro"
import Publications from "./sections/Publications.astro"
import Awards from "./sections/Awards.astro"
import About from "./sections/About.astro"
import Archive from "./sections/Archive.astro"
import Newsletter from "./sections/Newsletter.astro"
import Contact from "./sections/Contact.astro"
import Footer from "./sections/Footer.astro"

const pageTitle =
  "Journalist Dispatch - Independent reporting, investigations, and field notes"
const pageDescription =
  "Journalist Dispatch is the portfolio of an independent journalist and field reporter: long-form dispatches, investigations, photojournalism, field notes, and a browsable archive of past coverage."
const canonicalUrl = "/landings/journalist-dispatch"
const thumbnailUrl =
  "https://images.unsplash.com/photo-1756561841472-786e926ad5b2?ixid=M3wxMDQwNDk5fDB8MXxzZWFyY2h8OHx8ZG9jdW1lbnRhcnklMjBwaG90b2pvdXJuYWxpc20lMjByZXBvcnRhZ2UlMjBibGFjayUyMGFuZCUyMHdoaXRlfGVufDF8MHx8fDE3ODc2NjA4ODR8MA&ixlib=rb-4.1.0&w=1200&auto=format&fit=crop&q=80"
---

<!doctype html>
<html
  lang="en"
  class="scroll-smooth overflow-x-clip scheme-light motion-reduce:scroll-auto dark:scheme-dark font-sans"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Restore the persisted theme choice before first paint, so this
    landing's own toggle survives a reload when viewed standalone (outside
    the platform preview shell). -->
    <script is:inline>
      ;(function () {
        const saved = localStorage.getItem("journalist-dispatch-theme")
        if (saved === "dark" || saved === "light") {
          document.documentElement.setAttribute("data-theme", saved)
        }
      })()
    </script>

    <!-- Shared Landing Pages typeface — Wix Madefor Text (Google Fonts).
    Every landing loads the exact same weights/styles here; never via
    @import in CSS, and never a different family. See "Shared typography"
    in the astro-landing-pages Skill. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Wix+Madefor+Text:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />

    <!-- This document is only ever embedded as the preview iframe's render
    target (/landings/journalist-dispatch/render). The indexable, canonical
    page for this landing is the platform's own detail page. -->
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="noindex" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={thumbnailUrl} />
    <meta property="og:url" content={canonicalUrl} />
  </head>
  <body
    class="min-h-full overflow-x-clip bg-background text-base leading-relaxed text-foreground antialiased font-sans"
  >
    <a
      class="absolute -top-full left-4 z-1000 inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-md border-0 bg-primary px-5 py-3 text-base font-semibold text-primary-foreground no-underline transition duration-200 ease-landing focus-visible:top-4 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border hover:bg-emphasis active:bg-emphasis"
      href="#main-content"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main-content">
      <Hero />
      <Manifesto />
      <Feature />
      <Stories />
      <Investigations />
      <Gallery />
      <FieldNotes />
      <Timeline />
      <Quote />
      <Publications />
      <Awards />
      <About />
      <Archive />
      <Newsletter />
      <Contact />
    </main>

    <Footer />

    <script>
      import "./scripts/theme"
      import "./scripts/reveal"
      import "./scripts/navIndicator"
    </script>
  </body>
</html>
