---
import { ArrowRight } from "@lucide/astro"
---

<section
  class="border-t border-border bg-background-alt px-container-x py-section sm:px-8 xl:px-14"
  aria-labelledby="newsletter-heading"
>
  <div
    class="mx-auto grid w-full max-w-landing gap-10 footer:grid-cols-2 footer:items-center"
  >
    <div class="reveal">
      <p class="text-xs font-semibold tracking-wide text-muted uppercase">
        Newsletter
      </p>
      <h2
        id="newsletter-heading"
        class="mt-3 max-w-heading text-headline-2 leading-tight font-semibold text-foreground"
      >
        Stories, field notes, and the ones that never made it to print
      </h2>
      <p class="mt-4 max-w-copy text-muted">
        A short, occasional dispatch — reporting in progress, notes from the
        road, and pieces still looking for the right outlet.
      </p>
    </div>

    <form
      class="reveal flex flex-col gap-3 sm:flex-row"
      action="mailto:desk@example.com"
      method="post"
      enctype="text/plain"
    >
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        required
        placeholder="correo@ejemplo.com"
        autocomplete="email"
        class="focus-underline min-h-14 w-full flex-1 border-0 border-b border-border bg-transparent px-1 text-lg text-foreground placeholder:text-placeholder outline-none"
      />
      <button
        type="submit"
        class="inline-flex min-h-14 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-full border-0 bg-primary px-6 text-sm font-semibold text-primary-foreground transition duration-200 ease-landing hover:bg-emphasis focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-emphasis"
      >
        Subscribe
        <ArrowRight
          aria-hidden="true"
          width="16"
          height="16"
          stroke-width="2"
        />
      </button>
    </form>
  </div>
</section>
