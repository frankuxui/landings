---
import { awards } from "../data/awards"
import type { Award } from "../types"
---

<section
  class="border-t border-border bg-background px-container-x py-section sm:px-8 xl:px-14"
  aria-labelledby="awards-heading"
>
  <div class="mx-auto w-full max-w-landing">
    <div class="reveal">
      <p class="text-xs font-semibold tracking-wide text-muted uppercase">
        Recognitions
      </p>
      <h2
        id="awards-heading"
        class="max-w-heading mt-3 text-headline-2 leading-tight font-semibold text-foreground"
      >
        A short, honest list
      </h2>
    </div>

    <ul class="mt-14 flex flex-col">
      {
        awards.map((award: Award) => (
          <li class="reveal border-t border-border py-6 transition-transform duration-300 ease-landing hover:translate-x-2 motion-reduce:hover:translate-x-0">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 footer:flex-nowrap">
              <p class="font-mono text-sm text-muted">{award.year}</p>
              <p class="text-lg font-semibold text-foreground">{award.title}</p>
              <p class="text-sm text-muted footer:ml-auto">
                {award.organization}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
