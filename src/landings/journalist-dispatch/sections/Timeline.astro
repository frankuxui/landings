---
import TimelineStop from "../components/TimelineStop.astro"
import { timelineStops } from "../data/timeline"
import type { TimelineStop as TimelineStopType } from "../types"
---

<section
  id="coverage"
  class="overflow-hidden border-t border-border bg-background py-section"
  aria-labelledby="coverage-heading"
  data-timeline-section
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <div class="reveal max-w-heading">
      <p class="text-xs font-semibold tracking-wide text-muted uppercase">
        Coverage
      </p>
      <h2
        id="coverage-heading"
        class="mt-3 text-headline-2 leading-tight font-semibold text-foreground"
      >
        Five years on the road
      </h2>
      <p class="mt-4 max-w-copy text-muted">
        A running line of where the work has taken me — scroll to travel it, or
        drag through it directly on touch devices.
      </p>
    </div>
  </div>

  <div
    class="mt-12 flex w-full snap-x snap-mandatory gap-8 overflow-x-auto px-container-x pb-4 sm:px-8 xl:px-14 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]"
    data-timeline-track
  >
    {
      timelineStops.map((stop: TimelineStopType, index: number) => (
        <TimelineStop stop={stop} index={index} />
      ))
    }
    <div class="w-px shrink-0" aria-hidden="true"></div>
  </div>
</section>

<script>
  import "../scripts/timelineScroll"
</script>
