---
import StoryItem from "../components/StoryItem.astro"
import { stories } from "../data/stories"
import type { Story } from "../types"
---

<section
  id="stories"
  class="border-t border-border bg-background px-container-x py-section sm:px-8 xl:px-14"
  aria-labelledby="stories-heading"
>
  <div class="mx-auto w-full max-w-landing">
    <div class="reveal">
      <p class="text-xs font-semibold tracking-wide text-muted uppercase">
        Selected stories
      </p>
      <h2
        id="stories-heading"
        class="max-w-heading mt-3 text-headline-2 leading-tight font-semibold text-foreground"
      >
        Reporting that stayed with me
      </h2>
    </div>

    <div class="mt-12 grid gap-x-8 gap-y-14 cards:grid-cols-3">
      {
        stories.map((story: Story) => (
          <div class:list={[story.layout === "wide" && "cards:col-span-2"]}>
            <StoryItem story={story} />
          </div>
        ))
      }
    </div>
  </div>
</section>
