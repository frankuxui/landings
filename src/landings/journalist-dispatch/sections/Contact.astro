---
import { Mail, AtSign } from "@lucide/astro"
---

<section
  id="contact"
  class="border-t border-border bg-background px-container-x py-section sm:px-8 xl:px-14"
  aria-labelledby="contact-heading"
>
  <div
    class="mx-auto grid w-full max-w-landing gap-16 lg:grid-cols-[0.9fr_1.1fr] lg:items-start"
  >
    <div class="reveal">
      <p class="text-xs font-semibold tracking-wide text-muted uppercase">
        Contact
      </p>
      <h2
        id="contact-heading"
        class="mt-3 max-w-heading text-headline-2 leading-tight font-semibold text-foreground"
      >
        Propose a story
      </h2>
      <p class="mt-5 max-w-copy text-lg text-muted">
        Available for assignment, collaboration, and syndication. Editors,
        producers, and organizations can reach the desk directly — most pitches
        get a reply within a week.
      </p>

      <ul class="mt-10 flex flex-col gap-4">
        <li class="flex items-center gap-3">
          <Mail
            class="shrink-0 text-muted"
            aria-hidden="true"
            width="20"
            height="20"
            stroke-width="1.5"
          />
          <a
            class="focus-underline text-foreground no-underline focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
            href="mailto:desk@example.com">desk@example.com</a
          >
        </li>
        <li class="flex items-center gap-3">
          <AtSign
            class="shrink-0 text-muted"
            aria-hidden="true"
            width="20"
            height="20"
            stroke-width="1.5"
          />
          <span class="text-foreground">Instagram</span>
        </li>
        <li class="flex items-center gap-3">
          <AtSign
            class="shrink-0 text-muted"
            aria-hidden="true"
            width="20"
            height="20"
            stroke-width="1.5"
          />
          <span class="text-foreground">LinkedIn</span>
        </li>
      </ul>
    </div>

    <form
      class="reveal flex flex-col gap-6"
      action="mailto:desk@example.com"
      method="post"
      enctype="text/plain"
    >
      <div class="flex flex-col gap-1">
        <label class="text-sm font-semibold text-foreground" for="contact-name"
          >Name</label
        >
        <input
          class="focus-underline min-h-12 w-full min-w-0 border-0 border-b border-border bg-transparent px-1 py-2 text-base text-foreground outline-none placeholder:text-placeholder"
          type="text"
          id="contact-name"
          name="name"
          autocomplete="name"
          required
        />
      </div>

      <div class="flex flex-col gap-1">
        <label
          class="text-sm font-semibold text-foreground"
          for="contact-outlet">Outlet or organization</label
        >
        <input
          class="focus-underline min-h-12 w-full min-w-0 border-0 border-b border-border bg-transparent px-1 py-2 text-base text-foreground outline-none placeholder:text-placeholder"
          type="text"
          id="contact-outlet"
          name="organization"
          autocomplete="organization"
        />
      </div>

      <div class="flex flex-col gap-1">
        <label class="text-sm font-semibold text-foreground" for="contact-email"
          >Email</label
        >
        <input
          class="focus-underline min-h-12 w-full min-w-0 border-0 border-b border-border bg-transparent px-1 py-2 text-base text-foreground outline-none placeholder:text-placeholder"
          type="email"
          id="contact-email"
          name="email"
          autocomplete="email"
          inputmode="email"
          required
        />
      </div>

      <div class="flex flex-col gap-1">
        <label class="text-sm font-semibold text-foreground" for="contact-pitch"
          >The story</label
        >
        <textarea
          class="focus-underline min-h-36 w-full min-w-0 resize-y border-0 border-b border-border bg-transparent px-1 py-2 text-base text-foreground outline-none placeholder:text-placeholder"
          id="contact-pitch"
          name="message"
          rows="4"
          required></textarea>
      </div>

      <button
        type="submit"
        class="inline-flex min-h-12 cursor-pointer items-center gap-2 self-start rounded-full border-0 bg-primary px-6 py-3 text-base font-semibold text-primary-foreground no-underline transition duration-200 ease-landing hover:bg-emphasis focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-emphasis"
      >
        Send pitch
      </button>
    </form>
  </div>
</section>
