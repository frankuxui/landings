---
import { Menu, X, Camera, ArrowRight, Moon, Sun } from "@lucide/astro"
import { navLinks } from "../data/nav"
import type { NavLink } from "../types"
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 ease-landing"
  data-header
>
  <div
    class="mx-auto flex w-full max-w-landing items-center justify-between gap-4 px-6 py-5 sm:px-10 xl:px-14"
  >
    <!-- Logo -->
    <a
      class="inline-flex items-center gap-3 text-white no-underline mix-blend-difference focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white/60"
      href="#main-content"
      aria-label="Silver Print — home"
    >
      <span
        class="inline-flex size-8 items-center justify-center"
        aria-hidden="true"
      >
        <Camera width="22" height="22" stroke-width="1.5" />
      </span>
      <span class="text-xl font-bold tracking-tight">Silver Print</span>
    </a>

    <!-- Desktop nav -->
    <nav
      class="hidden items-center gap-1 nav:flex"
      aria-label="Section navigation"
    >
      {
        navLinks.map((link: NavLink) => (
          <a
            class="relative flex min-h-11 items-center px-4 py-2 text-sm font-medium text-white/90 no-underline mix-blend-difference transition duration-200 ease-landing hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white/60"
            href={link.href}
            data-nav-link
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <!-- Theme toggle -->
      <button
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-full border-0 bg-transparent text-white mix-blend-difference transition duration-200 ease-landing hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white/60 active:bg-white/20"
        data-theme-toggle
        aria-label="Toggle dark mode"
      >
        <Moon
          class="size-4.5 dark:hidden"
          aria-hidden="true"
          stroke-width="1.5"
        />
        <Sun
          class="hidden size-4.5 dark:block"
          aria-hidden="true"
          stroke-width="1.5"
        />
      </button>

      <!-- CTA — desktop -->
      <a
        class="hidden min-h-10 cursor-pointer items-center gap-2 rounded-sm border-0 bg-white px-5 py-2 text-sm font-semibold text-black no-underline transition duration-200 ease-landing hover:bg-white/85 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white/60 active:bg-white/70 nav:inline-flex"
        href="#galeria"
      >
        Start collecting
        <ArrowRight
          aria-hidden="true"
          width="15"
          height="15"
          stroke-width="2"
        />
      </a>

      <!-- Hamburger — mobile -->
      <button
        type="button"
        class="group relative z-60 inline-flex size-10 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent text-white mix-blend-difference transition duration-200 ease-landing hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white/60 active:bg-white/20 nav:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open navigation"
      >
        <Menu
          class="size-5 group-aria-expanded:hidden"
          aria-hidden="true"
          stroke-width="1.5"
        />
        <X
          class="hidden size-5 group-aria-expanded:block"
          aria-hidden="true"
          stroke-width="1.5"
        />
      </button>
    </div>
  </div>

  <!-- Mobile nav panel -->
  <div
    id="mobile-nav"
    class="fixed inset-0 z-40 flex h-dvh w-full translate-y-0 flex-col justify-between bg-background px-6 pt-24 pb-10 transition-[transform,visibility] duration-400 ease-landing aria-hidden:invisible aria-hidden:-translate-y-full motion-reduce:transition-none sm:px-10 nav:hidden"
    data-menu-panel
    aria-hidden="true"
  >
    <nav aria-label="Section navigation">
      <ol class="flex flex-col">
        {
          navLinks.map((link: NavLink, index: number) => (
            <li class="border-t border-border/30 first:border-t-0">
              <a
                class="flex min-h-16 items-center gap-4 py-3 text-3xl font-bold tracking-tight text-foreground no-underline transition duration-200 ease-landing hover:text-emphasis focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-border sm:text-4xl"
                href={link.href}
                data-mobile-link
              >
                <span class="font-mono text-xs font-normal text-muted">
                  {String(index + 1).padStart(2, "0")}
                </span>
                {link.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <a
      class="inline-flex min-h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-sm border-0 bg-primary px-6 py-3 text-base font-semibold text-primary-foreground no-underline transition duration-200 ease-landing hover:bg-emphasis focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-border active:bg-emphasis"
      href="#galeria"
      data-mobile-link
    >
      Start collecting
      <ArrowRight aria-hidden="true" width="18" height="18" stroke-width="2" />
    </a>
  </div>
</header>

<script>
  // Menu toggle
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]")
  const panel = document.querySelector<HTMLDivElement>("[data-menu-panel]")
  const mobileLinks =
    document.querySelectorAll<HTMLAnchorElement>("[data-mobile-link]")

  function openMenu(): void {
    if (!toggle || !panel) return
    toggle.setAttribute("aria-expanded", "true")
    panel.setAttribute("aria-hidden", "false")
    document.body.style.overflow = "hidden"
  }

  function closeMenu(): void {
    if (!toggle || !panel) return
    toggle.setAttribute("aria-expanded", "false")
    panel.setAttribute("aria-hidden", "true")
    document.body.style.overflow = ""
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true"
    isOpen ? closeMenu() : openMenu()
  })

  mobileLinks.forEach((link: HTMLAnchorElement) => {
    link.addEventListener("click", closeMenu)
  })

  // Header scroll effect — adds bg when user scrolls past hero
  const header = document.querySelector<HTMLElement>("[data-header]")

  function updateHeader(): void {
    if (!header) return
    if (window.scrollY > 80) {
      header.classList.add(
        "bg-background/95",
        "backdrop-blur-md",
        "shadow-[0_1px_0_0_rgb(0_0_0/0.08)]",
      )
      header.classList.remove("mix-blend-difference")
      // Switch logo/nav colors to use normal blend
      const logo = header.querySelector<HTMLAnchorElement>(
        'a[href="#main-content"]',
      )
      const navLinks =
        header.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")
      const themeBtn = header.querySelector<HTMLButtonElement>(
        "[data-theme-toggle]",
      )
      const menuBtn =
        header.querySelector<HTMLButtonElement>("[data-menu-toggle]")
      if (logo) {
        logo.classList.remove("text-white", "mix-blend-difference")
        logo.classList.add("text-foreground")
      }
      navLinks.forEach((link: HTMLAnchorElement) => {
        link.classList.remove(
          "text-white/90",
          "text-white",
          "mix-blend-difference",
        )
        link.classList.add("text-foreground")
      })
      if (themeBtn) {
        themeBtn.classList.remove("text-white", "mix-blend-difference")
        themeBtn.classList.add("text-foreground")
      }
      if (menuBtn) {
        menuBtn.classList.remove("text-white", "mix-blend-difference")
        menuBtn.classList.add("text-foreground")
      }
    } else {
      header.classList.remove(
        "bg-background/95",
        "backdrop-blur-md",
        "shadow-[0_1px_0_0_rgb(0_0_0/0.08)]",
      )
      const logo = header.querySelector<HTMLAnchorElement>(
        'a[href="#main-content"]',
      )
      const navLinks =
        header.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")
      const themeBtn = header.querySelector<HTMLButtonElement>(
        "[data-theme-toggle]",
      )
      const menuBtn =
        header.querySelector<HTMLButtonElement>("[data-menu-toggle]")
      if (logo) {
        logo.classList.add("text-white", "mix-blend-difference")
        logo.classList.remove("text-foreground")
      }
      navLinks.forEach((link: HTMLAnchorElement) => {
        link.classList.add("text-white/90", "mix-blend-difference")
        link.classList.remove("text-foreground")
      })
      if (themeBtn) {
        themeBtn.classList.add("text-white", "mix-blend-difference")
        themeBtn.classList.remove("text-foreground")
      }
      if (menuBtn) {
        menuBtn.classList.add("text-white", "mix-blend-difference")
        menuBtn.classList.remove("text-foreground")
      }
    }
  }

  window.addEventListener("scroll", updateHeader, { passive: true })
  updateHeader()

  // Theme toggle
  const themeToggle = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  )
  themeToggle?.addEventListener("click", () => {
    const current = document.documentElement.dataset.theme
    const next = current === "dark" ? "light" : "dark"
    document.documentElement.dataset.theme = next
    localStorage.setItem("sp-theme", next)
  })
</script>
