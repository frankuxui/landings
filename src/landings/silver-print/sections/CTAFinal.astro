---
import { ArrowRight } from "@lucide/astro"
import { featuredWorks } from "../data/featuredWorks"

// Use the nature work's image (more universally appealing for CTA)
const ctaImage = featuredWorks[1].image
---

<section
  class="relative overflow-hidden bg-black py-40 sm:py-52"
  aria-labelledby="cta-heading"
>
  <!-- Background image -->
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src={ctaImage.src.replace("w=1200", "w=2000")}
      alt=""
      width={ctaImage.width}
      height={ctaImage.height}
      class="h-full w-full object-cover grayscale"
      loading="lazy"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/70"
    >
    </div>
  </div>

  <!-- Content -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-landing flex-col items-center px-6 text-center sm:px-10 xl:px-14"
  >
    <p
      class="mb-6 font-mono text-xs font-semibold tracking-[0.25em] text-white/50 uppercase reveal"
      data-reveal
    >
      Start your collection
    </p>
    <h2
      id="cta-heading"
      class="mb-8 max-w-[16ch] text-headline-1 font-bold leading-[0.97] tracking-tight text-white reveal"
      data-reveal
    >
      The work you&rsquo;ve been waiting for is here.
    </h2>
    <p class="mb-12 max-w-[42ch] text-lg text-white/60 reveal" data-reveal>
      Join thousands of collectors who own original fine art photography from
      the photographers that matter.
    </p>
    <div
      class="flex flex-wrap items-center justify-center gap-4 reveal"
      data-reveal
    >
      <a
        href="#galeria"
        class="inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-sm border-0 bg-white px-8 py-3 text-base font-semibold text-black no-underline transition duration-200 ease-landing hover:bg-white/85 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white/60 active:bg-white/70"
      >
        Browse the gallery
        <ArrowRight
          aria-hidden="true"
          width="18"
          height="18"
          stroke-width="2"
        />
      </a>
      <a
        href="#fotografos"
        class="inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-sm border border-white/30 px-8 py-3 text-base font-medium text-white no-underline transition duration-200 ease-landing hover:border-white/60 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white/60 active:bg-white/20"
      >
        Meet the photographers
      </a>
    </div>
  </div>

  <!-- Photo credit -->
  <p
    class="absolute bottom-4 right-6 z-10 font-mono text-[0.6rem] text-white/30 sm:right-10"
  >
    Photo by
    <a
      href={ctaImage.authorUrl}
      class="underline underline-offset-2 hover:text-white/60 focus-visible:outline-1 focus-visible:outline-white/40"
      target="_blank"
      rel="noopener noreferrer">{ctaImage.author}</a
    > on
    <a
      href={ctaImage.unsplashUrl}
      class="underline underline-offset-2 hover:text-white/60 focus-visible:outline-1 focus-visible:outline-white/40"
      target="_blank"
      rel="noopener noreferrer">Unsplash</a
    >
  </p>
</section>
