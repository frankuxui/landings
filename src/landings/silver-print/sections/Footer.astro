---
import { Camera } from "@lucide/astro"
import { navLinks } from "../data/nav"
import type { NavLink } from "../types"
import { collections } from "../data/collections"
import { featuredWorks } from "../data/featuredWorks"
import { galleryItems } from "../data/gallery"
import { spotlightItems } from "../data/spotlight"
import { photographers } from "../data/photographers"
import type { UnsplashImage } from "../types"

// Collect all Unsplash attributions from every data source
interface Attribution {
  author: string
  authorUrl: string
}

function unique(attrs: Attribution[]): Attribution[] {
  const seen = new Set<string>()
  return attrs.filter((a: Attribution) => {
    const key = a.authorUrl
    if (seen.has(key)) return false
    seen.add(key)
    return true
  })
}

const allImages: UnsplashImage[] = [
  ...collections.map((c) => c.image),
  ...featuredWorks.map((w) => w.image),
  ...galleryItems.map((g) => g.image),
  ...spotlightItems.map((s) => s.image),
  ...photographers.map((p) => p.image),
]

const credits = unique(
  allImages.map((img: UnsplashImage) => ({
    author: img.author,
    authorUrl: img.authorUrl,
  })),
)

const UTM = "utm_source=astro_landings_gallery&utm_medium=referral"
const unsplashUrl = `https://unsplash.com/?${UTM}`

const legalLinks = [
  { label: "Privacy", href: "#" },
  { label: "Terms", href: "#" },
  { label: "Cookies", href: "#" },
]
---

<footer class="bg-background-alt pt-20 pb-12">
  <div class="mx-auto w-full max-w-landing px-6 sm:px-10 xl:px-14">
    <!-- Top row -->
    <div
      class="mb-16 grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]"
    >
      <!-- Brand -->
      <div>
        <a
          class="mb-5 inline-flex items-center gap-2.5 text-foreground no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-border"
          href="#main-content"
        >
          <Camera
            aria-hidden="true"
            width="20"
            height="20"
            stroke-width="1.5"
          />
          <span class="text-lg font-bold tracking-tight">Silver Print</span>
        </a>
        <p class="mt-4 max-w-[30ch] text-sm leading-relaxed text-muted">
          A curated marketplace for fine art photography — digital files and
          archival prints from photographers whose work endures.
        </p>
      </div>

      <!-- Navigation -->
      <nav aria-label="Footer navigation">
        <p
          class="mb-4 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
        >
          Explore
        </p>
        <ul class="flex flex-col gap-2.5">
          {
            navLinks.map((link: NavLink) => (
              <li>
                <a
                  class="text-sm font-medium text-foreground no-underline transition duration-150 hover:text-emphasis focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Collections quick links -->
      <nav aria-label="Collections navigation">
        <p
          class="mb-4 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
        >
          Collections
        </p>
        <ul class="flex flex-col gap-2.5">
          {
            collections.slice(0, 5).map((col) => (
              <li>
                <a
                  class="text-sm font-medium text-foreground no-underline transition duration-150 hover:text-emphasis focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border"
                  href="#colecciones"
                >
                  {col.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contact placeholder -->
      <div>
        <p
          class="mb-4 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
        >
          Contact
        </p>
        <ul class="flex flex-col gap-2.5 text-sm text-muted">
          <li>
            <a
              href="mailto:correo@ejemplo.com"
              class="text-foreground no-underline transition duration-150 hover:text-emphasis focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border"
              >correo@ejemplo.com</a
            >
          </li>
          <li>+00 000 000 000</li>
          <li>Dirección de ejemplo</li>
          <li>Ciudad, País</li>
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="mb-8 h-px w-full bg-border/40"></div>

    <!-- Photo credits — REQUIRED by Unsplash guidelines -->
    <div class="mb-8">
      <p
        class="mb-3 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
      >
        Photography Credits
      </p>
      <p class="mb-2 text-xs text-muted">
        All photographs in this landing page demo are sourced from
        <a
          href={unsplashUrl}
          class="font-semibold text-foreground no-underline hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border"
          target="_blank"
          rel="noopener noreferrer">Unsplash</a
        >. Thank you to these photographers:
      </p>
      <ul
        class="flex flex-wrap gap-x-4 gap-y-1.5"
        aria-label="Unsplash photo credits"
      >
        {
          credits.map((credit: Attribution) => (
            <li class="text-xs text-muted">
              <a
                href={credit.authorUrl}
                class="font-medium text-foreground no-underline hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border"
                target="_blank"
                rel="noopener noreferrer"
              >
                {credit.author}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Bottom bar -->
    <div
      class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-xs text-muted">
        &copy; 2026 Silver Print. Design demonstration — all brands, names and
        content are entirely fictional.
      </p>
      <nav aria-label="Legal navigation">
        <ul class="flex gap-4">
          {
            legalLinks.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-xs text-muted no-underline transition duration-150 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>
