---

---

<section
  id="manifiesto"
  class="bg-inverted py-32 sm:py-40"
  aria-labelledby="manifesto-heading"
>
  <div class="mx-auto w-full max-w-landing px-6 sm:px-10 xl:px-14">
    <p
      class="mb-10 font-mono text-xs font-semibold tracking-[0.25em] text-inverted-foreground/40 uppercase"
    >
      Manifesto
    </p>

    <h2
      id="manifesto-heading"
      class="text-headline-1 font-bold leading-[1.0] tracking-tight text-inverted-foreground"
      data-manifesto-heading
    >
      Photography is not a record.<br />
      It is a position.
    </h2>

    <div
      class="mt-16 grid grid-cols-1 gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-20"
    >
      <div class="manifesto-para">
        <p class="text-lg leading-[1.8] text-inverted-foreground/70 sm:text-xl">
          Every photograph here began with a person who chose to stand in a
          particular place at a particular time and point a lens at something
          they found worth attending to. That act of attention is the work. The
          print is its transmission.
        </p>
      </div>

      <div class="flex flex-col gap-8 manifesto-para">
        <p class="text-base leading-[1.9] text-inverted-foreground/60">
          Silver Print was built on the conviction that fine art photography
          deserves the same distribution infrastructure as music, literature and
          film — frictionless access to original work, with the full provenance,
          craft and edition information that collectors need and artists
          deserve.
        </p>
        <p class="text-base leading-[1.9] text-inverted-foreground/60">
          We do not aggregate. We curate. Every photographer on this platform
          has been selected by editors who themselves shoot — who understand the
          difference between a technically accomplished photograph and one that
          has something to say.
        </p>
        <p class="text-base leading-[1.9] text-inverted-foreground/60">
          Our standard is simple: we only sell work we would hang on our own
          walls.
        </p>
      </div>
    </div>

    <!-- Pull quote -->
    <div class="mt-20 border-l-2 border-inverted-foreground/20 pl-8 sm:pl-12">
      <blockquote>
        <p
          class="text-headline-3 font-bold italic leading-[1.3] tracking-tight text-inverted-foreground/80"
          data-manifesto-quote
        >
          "A photograph that asks nothing of the viewer is a photograph that
          says nothing."
        </p>
        <footer class="mt-5">
          <cite
            class="font-mono text-xs font-semibold tracking-widest text-inverted-foreground/40 uppercase not-italic"
          >
            — Silver Print Editorial Board
          </cite>
        </footer>
      </blockquote>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  gsap.registerPlugin(ScrollTrigger)

  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches

  if (!prefersReduced) {
    // Word-by-word reveal on the main heading
    const heading = document.querySelector<HTMLElement>(
      "[data-manifesto-heading]",
    )
    if (heading) {
      const html = heading.innerHTML
      const words = html.split(/(\s+|<br\s*\/?>)/g)
      const wrapped = words
        .map((word: string) => {
          if (/^(\s+|<br\s*\/?>)$/.test(word)) return word
          return `<span class="manifesto-word inline-block" style="opacity:0;transform:translateY(20px)">${word}</span>`
        })
        .join("")
      heading.innerHTML = wrapped

      const wordEls = heading.querySelectorAll<HTMLElement>(".manifesto-word")
      ScrollTrigger.create({
        trigger: heading,
        start: "top 80%",
        once: true,
        onEnter: () => {
          gsap.to(wordEls, {
            opacity: 1,
            y: 0,
            duration: 0.6,
            ease: "power3.out",
            stagger: 0.03,
          })
        },
      })
    }

    // Paragraph reveals
    const paras = document.querySelectorAll<HTMLElement>(".manifesto-para")
    paras.forEach((para: HTMLElement) => {
      gsap.from(para, {
        opacity: 0,
        y: 32,
        duration: 0.9,
        ease: "power3.out",
        scrollTrigger: {
          trigger: para,
          start: "top 85%",
          once: true,
        },
      })
    })

    // Quote reveal
    const quote = document.querySelector<HTMLElement>("[data-manifesto-quote]")
    if (quote) {
      gsap.from(quote, {
        opacity: 0,
        x: -20,
        duration: 1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: quote,
          start: "top 85%",
          once: true,
        },
      })
    }
  }
</script>
