---
import { ArrowRight } from "@lucide/astro"
import { collections } from "../data/collections"
import type { Collection } from "../types"

const featured = collections[0]
const rest = collections.slice(1)
---

<section
  id="colecciones"
  class="bg-background py-24 sm:py-32"
  aria-labelledby="collections-heading"
>
  <div class="mx-auto w-full max-w-landing px-6 sm:px-10 xl:px-14">
    <!-- Section header -->
    <div
      class="mb-14 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <p
          class="mb-3 font-mono text-xs font-semibold tracking-[0.25em] text-muted uppercase reveal"
          data-reveal
        >
          Collections
        </p>
        <h2
          id="collections-heading"
          class="text-headline-2 font-bold leading-[1.05] tracking-tight text-foreground reveal"
          data-reveal
        >
          Seven categories.<br />One standard.
        </h2>
      </div>
      <a
        class="inline-flex min-h-10 cursor-pointer items-center gap-2 self-start rounded-sm border-0 bg-surface-strong px-5 py-2.5 text-sm font-semibold text-foreground no-underline transition duration-200 ease-landing hover:bg-control focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-border active:bg-control-hover sm:self-auto reveal"
        data-reveal
        href="#galeria"
      >
        Browse all
        <ArrowRight
          aria-hidden="true"
          width="15"
          height="15"
          stroke-width="2"
        />
      </a>
    </div>

    <!-- Collections layout: featured large + 6 smaller -->
    <div
      class="grid grid-cols-1 gap-3 lg:grid-cols-[1.6fr_1fr] lg:grid-rows-[auto_auto_auto]"
    >
      <!-- Featured collection — large card -->
      <div
        class="group relative overflow-hidden bg-placeholder lg:row-span-3 reveal"
        data-reveal
      >
        <a
          href={`#galeria`}
          class="block h-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border"
          aria-label={`Explore ${featured.name} collection`}
        >
          <div class="relative aspect-[3/4] lg:h-full lg:min-h-[640px]">
            <img
              src={featured.image.src}
              alt={featured.image.alt}
              width={featured.image.width}
              height={featured.image.height}
              class="h-full w-full object-cover object-center grayscale transition duration-700 ease-landing can-hover:group-hover:scale-105"
              loading="lazy"
            />
            <!-- Overlay — always visible on touch, hover-only on pointer devices -->
            <div
              class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/80 via-black/20 to-transparent p-8 transition-opacity duration-400 ease-landing can-hover:opacity-0 can-hover:group-hover:opacity-100 can-hover:group-focus-within:opacity-100"
            >
              <p
                class="mb-1 font-mono text-xs font-semibold tracking-widest text-white/60 uppercase"
              >
                {featured.worksCount} works
              </p>
              <h3
                class="mb-2 text-3xl font-bold tracking-tight text-white sm:text-4xl"
              >
                {featured.name}
              </h3>
              <p class="mb-1 text-sm text-white/70">{featured.photographer}</p>
              <p class="mb-4 text-sm font-semibold text-white">
                {featured.price}
              </p>
              <p
                class="mb-5 text-sm leading-relaxed text-white/60 max-w-[36ch]"
              >
                {featured.description}
              </p>
              <span
                class="inline-flex min-h-10 w-fit items-center gap-2 rounded-sm border-0 bg-white px-5 py-2 text-sm font-semibold text-black transition duration-200 hover:bg-white/85"
              >
                Explore
                <ArrowRight
                  aria-hidden="true"
                  width="14"
                  height="14"
                  stroke-width="2"
                />
              </span>
            </div>
            <!-- Always-visible info on touch (below overlay, no hover) -->
            <div
              class="absolute bottom-0 left-0 right-0 flex items-end justify-between p-6 can-hover:hidden"
            >
              <div>
                <h3 class="text-xl font-bold text-white">{featured.name}</h3>
                <p class="text-sm text-white/70">{featured.price}</p>
              </div>
              <span class="font-mono text-xs text-white/50"
                >{featured.worksCount} works</span
              >
            </div>
          </div>
        </a>
        <!-- Photo credit -->
        <p
          class="absolute bottom-2 right-3 font-mono text-[0.55rem] text-white/25"
        >
          <a
            href={featured.image.authorUrl}
            class="hover:text-white/50"
            target="_blank"
            rel="noopener noreferrer">{featured.image.author}</a
          > / Unsplash
        </p>
      </div>

      <!-- Smaller collections grid -->
      {
        rest.map((col: Collection) => (
          <div
            class="group relative overflow-hidden bg-placeholder reveal"
            data-reveal
          >
            <a
              href={`#galeria`}
              class="block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border"
              aria-label={`Explore ${col.name} collection`}
            >
              <div class="relative aspect-[4/3]">
                <img
                  src={col.image.src}
                  alt={col.image.alt}
                  width={col.image.width}
                  height={col.image.height}
                  class="h-full w-full object-cover object-center grayscale transition duration-700 ease-landing can-hover:group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/75 via-black/15 to-transparent p-5 transition-opacity duration-400 ease-landing can-hover:opacity-0 can-hover:group-hover:opacity-100 can-hover:group-focus-within:opacity-100">
                  <p class="mb-0.5 font-mono text-[0.6rem] font-semibold tracking-widest text-white/60 uppercase">
                    {col.worksCount} works
                  </p>
                  <h3 class="mb-1 text-xl font-bold tracking-tight text-white">
                    {col.name}
                  </h3>
                  <p class="mb-1 text-xs text-white/70">{col.photographer}</p>
                  <p class="text-sm font-semibold text-white">{col.price}</p>
                </div>
                <div class="absolute bottom-0 left-0 right-0 flex items-end justify-between p-4 can-hover:hidden">
                  <div>
                    <h3 class="text-base font-bold text-white">{col.name}</h3>
                    <p class="text-xs text-white/70">{col.price}</p>
                  </div>
                </div>
              </div>
            </a>
            <p class="absolute bottom-1.5 right-2.5 font-mono text-[0.5rem] text-white/20">
              <a
                href={col.image.authorUrl}
                class="hover:text-white/50"
                target="_blank"
                rel="noopener noreferrer"
              >
                {col.image.author}
              </a>{" "}
              / Unsplash
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import gsap from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  gsap.registerPlugin(ScrollTrigger)

  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches

  if (!prefersReduced) {
    document.body.classList.add("js-reveal-ready")

    const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]")
    revealEls.forEach((el: HTMLElement) => {
      ScrollTrigger.create({
        trigger: el,
        start: "top 88%",
        onEnter: () => el.classList.add("is-visible"),
        once: true,
      })
    })
  } else {
    const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]")
    revealEls.forEach((el: HTMLElement) => el.classList.add("is-visible"))
  }
</script>
