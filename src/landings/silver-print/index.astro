---
// Silver Print — root document for this landing.
// Fully self-contained: no platform Layout, no platform CSS/components.
// Rendered in isolation by src/pages/landings/[slug]/render.astro.
import "./styles/tailwind.css"

import Header from "./sections/Header.astro"
import Hero from "./sections/Hero.astro"
import Collections from "./sections/Collections.astro"
import FeaturedWorks from "./sections/FeaturedWorks.astro"
import Gallery from "./sections/Gallery.astro"
import Spotlight from "./sections/Spotlight.astro"
import Photographers from "./sections/Photographers.astro"
import Manifesto from "./sections/Manifesto.astro"
import PrintInfo from "./sections/PrintInfo.astro"
import CTAFinal from "./sections/CTAFinal.astro"
import Footer from "./sections/Footer.astro"

const pageTitle = "Silver Print — Fine Art Photography"
const pageDescription =
  "A curated marketplace for fine art photography. Buy original prints and digital files from the world's leading contemporary photographers. Museum-quality archival prints delivered worldwide."
const canonicalUrl = "/landings/silver-print"
const thumbnailUrl =
  "https://images.unsplash.com/photo-1516912481800-cf969d5d6b23?auto=format&fit=crop&w=1200&q=80"
---

<!doctype html>
<html
  lang="en"
  class="scroll-smooth overflow-x-clip scheme-light motion-reduce:scroll-auto dark:scheme-dark font-sans"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Shared Landing Pages typeface — Wix Madefor Text (Google Fonts).
         Never loaded via @import in CSS; never a different family.
         See "Shared typography" in the astro-landing-pages Skill. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Wix+Madefor+Text:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />

    <!-- This document is only ever embedded as the preview iframe's render
         target (/landings/silver-print/render). The indexable, canonical
         page for this landing is the platform's own detail page. -->
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="noindex" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={thumbnailUrl} />
    <meta property="og:url" content={canonicalUrl} />
  </head>
  <body
    class="min-h-full overflow-x-clip bg-background text-base leading-relaxed text-foreground antialiased font-sans"
  >
    <!-- Skip link -->
    <a
      class="absolute -top-full left-4 z-[1000] inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-sm border-0 bg-primary px-5 py-3 text-base font-semibold text-primary-foreground no-underline transition duration-200 ease-landing focus-visible:top-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      href="#main-content"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main-content">
      <Hero />
      <Collections />
      <FeaturedWorks />
      <Gallery />
      <Spotlight />
      <Photographers />
      <Manifesto />
      <PrintInfo />
      <CTAFinal />
    </main>

    <Footer />

    <!-- Theme: restore persisted preference without flash, then listen for
         the preview shell's postMessage to sync the platform's own toggle. -->
    <script is:inline>
      ;(function () {
        const root = document.documentElement
        const saved = localStorage.getItem("sp-theme")
        if (saved === "dark" || saved === "light") {
          root.dataset.theme = saved
          return
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches)
          root.dataset.theme = "dark"
      })()
    </script>

    <script>
      window.addEventListener("message", (e: MessageEvent) => {
        if (e.data?.type === "set-theme") {
          document.documentElement.dataset.theme = e.data.theme
        }
      })
    </script>
  </body>
</html>
