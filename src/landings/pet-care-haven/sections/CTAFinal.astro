---
// Final call to action — a full-bleed photograph with a fixed dark scrim,
// so `text-white` here is a deliberate, theme-independent choice (not a
// semantic-token bug: the scrim never lightens in Dark theme). The
// Unsplash credit sits in its own strip below the photo, in normal
// document flow — never overlaid on top of it.
import { ArrowRight } from "@lucide/astro"
import PhotoCredit from "../components/PhotoCredit.astro"
import { ctaImage } from "../data/ctaBackground"
---

<section class="bg-inverted-surface">
  <div class="relative isolate overflow-hidden">
    <img
      src={ctaImage.src}
      alt={ctaImage.alt}
      title={`Photo by ${ctaImage.author} on Unsplash`}
      width={ctaImage.width}
      height={ctaImage.height}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover grayscale"
    />
    <div
      class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/90 via-black/50 to-black/30"
      aria-hidden="true"
    >
    </div>

    <div
      class="reveal relative mx-auto flex min-h-[26rem] w-full max-w-landing flex-col items-start justify-center gap-8 px-container-x py-section sm:px-8 xl:px-14"
    >
      <h2
        class="max-w-heading text-balance text-headline-2 leading-tight font-semibold text-white"
      >
        Book your first visit and get to know us, no commitment.
      </h2>
      <p class="max-w-copy text-lg text-white/80">
        No fine print: a short chat, a profile for your pet, and a care plan
        shaped around how they actually live at home.
      </p>
      <a
        href="#contact"
        class="inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-full border-0 bg-white px-7 py-3 text-base font-semibold text-black no-underline transition duration-200 ease-landing hover:bg-white/85 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-white active:bg-white/75"
      >
        Book a visit
        <ArrowRight
          aria-hidden="true"
          width="18"
          height="18"
          stroke-width="1.5"
        />
      </a>
    </div>
  </div>

  <div
    class="mx-auto w-full max-w-landing px-container-x py-3 sm:px-8 xl:px-14"
  >
    <PhotoCredit image={ctaImage} tone="inverted" />
  </div>
</section>
