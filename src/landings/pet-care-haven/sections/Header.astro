---
// Zero-JS navigation: the mobile menu is a native <details>/<summary>
// disclosure, styled with Tailwind's `open:`/`group-open:` variants — no
// menu script required, unlike other landings in this gallery.
//
// The primary CTA only appears from `xl:` up so the wordmark, nav links,
// and theme toggle never compete for room right at the `nav:` breakpoint
// edge — it still reaches every visitor through the mobile disclosure panel.
import { Menu, X, Moon, Sun, ArrowRight } from "@lucide/astro"
import { navLinks } from "../data/nav"
import type { NavLink } from "../types"
---

<header
  class="fixed top-0 z-40 w-full bg-background/95 shadow-[0_1px_0_0_rgb(0_0_0/0.08)] backdrop-blur-md"
>
  <div
    class="mx-auto flex w-full max-w-landing items-center justify-between gap-4 px-container-x py-4 sm:px-8 xl:px-14"
  >
    <a
      class="shrink-0 text-base font-semibold tracking-tight text-foreground no-underline sm:text-lg"
      href="#home"
    >
      Pet Care Haven
    </a>

    <nav
      class="hidden items-center gap-1 nav:flex"
      aria-label="Primary navigation"
    >
      <ul class="flex items-center gap-1">
        {
          navLinks.map((link: NavLink) => (
            <li>
              <a
                class="flex min-h-11 items-center px-2.5 py-2 text-sm font-medium text-foreground no-underline hover:text-emphasis focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
                href={link.href}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <button
        type="button"
        class="inline-flex size-11 min-h-11 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-0 text-foreground transition duration-200 ease-landing hover:bg-control focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-control-hover"
        data-theme-toggle
        aria-label="Toggle dark mode"
      >
        <Moon
          class="size-5 dark:hidden"
          aria-hidden="true"
          stroke-width="1.5"
        />
        <Sun
          class="hidden size-5 dark:block"
          aria-hidden="true"
          stroke-width="1.5"
        />
      </button>

      <a
        class="hidden min-h-11 cursor-pointer items-center gap-2 rounded-full border-0 bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground no-underline transition duration-200 ease-landing hover:bg-emphasis focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-emphasis xl:inline-flex"
        href="#contact"
      >
        Book a visit
        <ArrowRight
          aria-hidden="true"
          width="16"
          height="16"
          stroke-width="1.5"
        />
      </a>

      <details class="group relative nav:hidden">
        <summary
          class="flex size-11 min-h-11 cursor-pointer list-none items-center justify-center rounded-full text-foreground transition duration-200 ease-landing hover:bg-control focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border marker:content-none [&::-webkit-details-marker]:hidden"
          aria-label="Open navigation menu"
        >
          <Menu
            class="size-5.5 group-open:hidden"
            aria-hidden="true"
            stroke-width="1.5"
          />
          <X
            class="hidden size-5.5 group-open:block"
            aria-hidden="true"
            stroke-width="1.5"
          />
        </summary>

        <div
          class="absolute top-full right-0 mt-3 flex w-72 flex-col gap-4 bg-surface p-6 shadow-[0_20px_45px_-15px_rgb(0_0_0/0.35)]"
        >
          <nav aria-label="Primary navigation">
            <ul class="flex flex-col">
              {
                navLinks.map((link: NavLink) => (
                  <li class="relative before:absolute before:top-0 before:left-0 before:h-px before:w-full before:bg-border before:content-[''] first:before:hidden">
                    <a
                      class="flex min-h-12 items-center text-base font-semibold text-foreground no-underline hover:text-emphasis focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
                      href={link.href}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <a
            class="inline-flex min-h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-full border-0 bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground no-underline transition duration-200 ease-landing hover:bg-emphasis focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-emphasis"
            href="#contact"
          >
            Book a visit
            <ArrowRight
              aria-hidden="true"
              width="16"
              height="16"
              stroke-width="1.5"
            />
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
