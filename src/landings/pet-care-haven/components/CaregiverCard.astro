---
// The Unsplash credit sits in normal document flow below the photograph,
// alongside the caregiver's own bio — never overlaid on top of the image.
import Photo from "./Photo.astro"
import PhotoCredit from "./PhotoCredit.astro"
import type { Caregiver } from "../types"

export interface Props {
  caregiver: Caregiver
}

const { caregiver } = Astro.props
---

<article class="reveal flex flex-col gap-4">
  <Photo
    image={caregiver.image}
    ratio="3 / 4"
    sizes="(min-width: 1024px) 25vw, (min-width: 640px) 40vw, 80vw"
    caption={false}
    imgClass="grayscale"
  />
  <div class="flex flex-col gap-1.5">
    <h3 class="text-lg font-semibold text-foreground">{caregiver.name}</h3>
    <p class="text-sm font-semibold text-muted">{caregiver.role}</p>
    <p class="text-sm text-muted">{caregiver.specialty}</p>
    <p class="mt-1 text-sm text-foreground/80 italic">“{caregiver.trait}”</p>
    <PhotoCredit image={caregiver.image} class="mt-2" />
  </div>
</article>
