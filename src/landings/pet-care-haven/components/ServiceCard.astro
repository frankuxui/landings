---
// One service in the "Services" grid — image, name, description, benefit,
// and a CTA into the contact section. Hover/focus reveals the description
// and benefit progressively over the photograph. The Unsplash credit sits
// below the photo, in normal flow — never overlaid on top of it.
import { ArrowUpRight } from "@lucide/astro"
import Photo from "./Photo.astro"
import PhotoCredit from "./PhotoCredit.astro"
import type { Service } from "../types"

export interface Props {
  service: Service
}

const { service } = Astro.props
---

<article class="reveal group flex flex-col overflow-hidden bg-surface">
  <Photo
    image={service.image}
    ratio="4 / 5"
    sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
    caption={false}
  >
    <div
      class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/85 via-black/20 to-transparent"
      aria-hidden="true"
    >
    </div>

    <div class="absolute inset-x-0 bottom-0 flex flex-col gap-3 p-6 text-white">
      <h3 class="text-xl leading-snug font-semibold">{service.name}</h3>

      <div
        class="grid grid-rows-[1fr] gap-3 opacity-100 lg:grid-rows-[0fr] lg:opacity-0 lg:transition-[grid-template-rows,opacity] lg:duration-500 lg:ease-landing lg:group-hover:grid-rows-[1fr] lg:group-hover:opacity-100 lg:group-focus-within:grid-rows-[1fr] lg:group-focus-within:opacity-100 motion-reduce:grid-rows-[1fr]! motion-reduce:opacity-100!"
      >
        <div class="overflow-hidden">
          <p class="text-sm text-white/85">{service.description}</p>
          <p
            class="mt-3 text-xs font-semibold tracking-wide text-white/70 uppercase"
          >
            {service.benefit}
          </p>
        </div>
      </div>

      <a
        href="#contact"
        class="mt-1 inline-flex min-h-11 w-fit cursor-pointer items-center gap-1.5 text-sm font-semibold text-white underline underline-offset-4 transition duration-200 ease-landing hover:gap-2.5 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-white"
      >
        Check availability
        <ArrowUpRight
          aria-hidden="true"
          width="16"
          height="16"
          stroke-width="2"
        />
      </a>
    </div>
  </Photo>

  <div class="px-1 pt-2 pb-1">
    <PhotoCredit image={service.image} class="text-[11px]" />
  </div>
</article>
