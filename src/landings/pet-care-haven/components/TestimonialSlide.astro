---
import { Star } from "@lucide/astro"
import type { Testimonial } from "../types"

export interface Props {
  testimonial: Testimonial
}

const { testimonial } = Astro.props
---

<figure
  class="reveal relative m-0 flex h-full flex-col justify-between gap-8 overflow-hidden bg-surface p-7 xl:p-9"
>
  <span
    class="pointer-events-none absolute -top-6 -left-2 font-serif text-[7rem] leading-none text-foreground/8 select-none"
    aria-hidden="true">”</span
  >

  <div class="relative flex flex-col gap-4">
    <div class="flex items-center gap-1" aria-hidden="true">
      {
        Array.from({ length: 5 }).map((_, index: number) => (
          <Star
            width="14"
            height="14"
            stroke-width="1.5"
            class={
              index < testimonial.rating
                ? "fill-foreground text-foreground"
                : "text-border"
            }
          />
        ))
      }
      <span class="sr-only">{testimonial.rating} out of 5 stars</span>
    </div>
    <blockquote class="m-0 text-xl leading-snug sm:text-2xl">
      <p>{testimonial.quote}</p>
    </blockquote>
  </div>

  <figcaption class="relative flex flex-col gap-1">
    <p class="text-sm font-semibold text-foreground">
      {testimonial.ownerName} · {testimonial.petName}
    </p>
    <p class="font-mono text-xs tracking-widest text-muted uppercase">
      {testimonial.service} — {testimonial.location}
    </p>
  </figcaption>
</figure>
