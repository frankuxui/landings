---
import Sparkles from "../components/Sparkles.astro"
---

<section
  class="relative -mt-10 overflow-hidden rounded-t-4xl bg-background-alt px-4 py-section text-foreground palette-surface-light sm:px-6"
>
  <Sparkles class="text-foreground opacity-60" />
  <div class="relative mx-auto max-w-2xl text-center">
    <p class="text-sm font-medium tracking-wide text-muted uppercase">
      One small thing
    </p>
    <h2
      class="mx-auto mt-6 max-w-hero-heading text-headline-1 leading-tight font-semibold tracking-tight text-balance"
    >
      Make more room for joy.
    </h2>
    <p class="mx-auto mt-6 max-w-copy text-lg leading-relaxed text-muted">
      One walk. One conversation. One laugh. One good moment at a time.
    </p>
    <a
      href="#top"
      class="mt-10 inline-flex min-h-12 items-center justify-center rounded-full bg-(--color-primary) px-8 py-4 text-sm font-semibold tracking-wide text-(--color-light) no-underline transition hover:scale-[1.03] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-ring active:scale-95 motion-reduce:transition-none"
    >
      Start with one small thing
    </a>
  </div>
</section>
