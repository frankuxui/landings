---
import Photo from "../components/Photo.astro"
import { gallery } from "../data/content"
import type { GalleryMoment } from "../types"
---

<section class="bg-background px-4 py-section text-foreground sm:px-6">
  <div class="mx-auto max-w-landing">
    <div
      class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between lg:mb-16"
    >
      <div>
        <p class="text-sm font-medium tracking-wide text-muted uppercase">
          Portrait gallery
        </p>
        <h2
          class="mt-4 max-w-heading text-headline-2 leading-tight font-semibold tracking-tight text-balance"
        >
          A contact sheet of ordinary aliveness.
        </h2>
      </div>
      <p class="max-w-xs text-sm leading-relaxed text-muted">
        Six frames, one strip. Faces, tables, daylight, and walks — the small
        human evidence that the day can still hold us.
      </p>
    </div>

    <div
      data-gallery
      class="grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-3 lg:gap-x-6"
    >
      {
        gallery.map((moment: GalleryMoment, index: number) => (
          <article data-gallery-item class="group">
            <div class="flex items-center gap-3 pb-3">
              <span class="font-mono text-xs text-muted">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="h-px flex-1 bg-border/40" />
            </div>
            <Photo
              image={moment.image}
              ratio="3 / 4"
              imageClass="rounded-xl transition duration-700 ease-landing group-hover:scale-105 motion-reduce:transition-none"
            />
            <p class="mt-3 text-sm leading-relaxed text-muted">
              {moment.caption}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
