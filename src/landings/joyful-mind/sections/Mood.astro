---
import { moods } from "../data/content"
import type { MoodState } from "../types"
---

<section
  id="mood"
  data-mood-section
  data-mood="low"
  class="relative overflow-hidden bg-inverted px-4 py-section text-inverted-foreground palette-surface-primary sm:px-6"
>
  <div
    data-mood-glow
    class="pointer-events-none absolute top-1/2 left-1/2 size-96 -translate-x-1/2 -translate-y-1/2 rounded-full blur-3xl transition-all duration-700 ease-landing"
  >
  </div>

  <div
    class="relative mx-auto grid max-w-landing gap-12 lg:grid-cols-[1fr_0.85fr] lg:items-center"
  >
    <div>
      <p
        class="text-sm font-medium tracking-wide text-inverted-foreground/55 uppercase"
      >
        Mood spectrum
      </p>
      <h2
        class="mt-4 max-w-heading text-headline-2 leading-tight font-semibold tracking-tight text-balance"
      >
        How are you feeling today?
      </h2>
      <div
        class="mt-8 flex flex-wrap gap-2"
        role="listbox"
        aria-label="Mood options"
      >
        {
          moods.map((mood: MoodState, index: number) => (
            <button
              type="button"
              data-mood-button={mood.id}
              aria-selected={index === 0 ? "true" : "false"}
              class="min-h-11 cursor-pointer rounded-full border-0 bg-inverted-foreground/10 px-4 py-2 text-sm font-medium tracking-wide text-inverted-foreground transition hover:bg-inverted-foreground/20 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-ring data-[active=true]:bg-inverted-foreground data-[active=true]:font-semibold data-[active=true]:text-inverted"
              data-active={index === 0 ? "true" : "false"}
            >
              {mood.label}
            </button>
          ))
        }
      </div>

      <div class="relative mt-10 min-h-52">
        {
          moods.map((mood: MoodState, index: number) => (
            <article
              data-mood-copy={mood.id}
              class:list={[
                "absolute inset-0",
                index !== 0 && "pointer-events-none opacity-0",
              ]}
            >
              <h3 class="text-headline-3 leading-tight font-semibold tracking-tight">
                {mood.title}
              </h3>
              <p class="mt-3 max-w-copy leading-relaxed text-inverted-foreground/70">
                {mood.copy}
              </p>
              <p class="mt-5 text-xs text-inverted-foreground/55">
                Photo by{" "}
                <a
                  href={mood.image.authorUrl}
                  target="_blank"
                  rel="noopener"
                  class="underline underline-offset-3 hover:text-inverted-foreground focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-ring"
                >
                  {mood.image.author}
                </a>{" "}
                on{" "}
                <a
                  href={mood.image.unsplashUrl}
                  target="_blank"
                  rel="noopener"
                  class="underline underline-offset-3 hover:text-inverted-foreground focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-ring"
                >
                  Unsplash
                </a>
              </p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="relative aspect-3/4 overflow-hidden rounded-3xl bg-placeholder">
      {
        moods.map((mood: MoodState, index: number) => (
          <div
            data-mood-panel={mood.id}
            class:list={[
              "absolute inset-0",
              index !== 0 && "pointer-events-none opacity-0",
            ]}
          >
            <img
              src={mood.image.src}
              alt={mood.image.alt}
              title={`Photo by ${mood.image.author} on Unsplash`}
              width={mood.image.width}
              height={mood.image.height}
              loading="lazy"
              decoding="async"
              class="photo-tone h-full w-full object-cover"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
