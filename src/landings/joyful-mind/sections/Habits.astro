---
import { habits } from "../data/content"
import type { Habit } from "../types"
---

<section
  id="habits"
  class="bg-background px-4 py-section text-foreground sm:px-6"
>
  <div class="mx-auto max-w-landing">
    <div class="max-w-2xl">
      <p class="text-sm font-medium tracking-wide text-muted uppercase">
        Tiny things, big difference
      </p>
      <h2
        class="mt-4 max-w-heading text-headline-2 leading-tight font-semibold tracking-tight text-balance"
      >
        Care can look wonderfully ordinary.
      </h2>
    </div>

    <div class="mt-16 lg:mt-20">
      <ul class="divide-y divide-border/15">
        {
          habits.map((habit: Habit, index: number) => (
            <li class="group grid grid-cols-[auto_1fr] items-baseline gap-x-5 gap-y-1 py-6 first:pt-0 last:pb-0 sm:grid-cols-[auto_auto_1fr] sm:gap-x-8 sm:py-8">
              <span class="self-start font-mono text-xs text-muted/50 sm:pt-1.5">
                {String(index + 1).padStart(2, "0")}
              </span>
              <p class="text-2xl font-semibold tracking-tight sm:text-3xl lg:text-4xl">
                {habit.label}
              </p>
              <p class="col-start-2 max-w-md text-sm leading-relaxed text-muted sm:col-start-3 sm:text-base">
                {habit.note}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
