---
import Sparkles from "../components/Sparkles.astro"

const lines = [
  "Laugh louder.",
  "Move your body.",
  "Call your people.",
  "Rest without guilt.",
  "Make room for joy.",
] as const
---

<section
  class="relative overflow-hidden rounded-t-4xl bg-inverted-surface px-4 py-section text-inverted-foreground sm:px-6"
>
  <Sparkles class="text-inverted-foreground opacity-60" />
  <div class="relative mx-auto max-w-landing">
    <p
      class="text-sm font-medium tracking-wide text-inverted-foreground/55 uppercase"
    >
      A small manifesto
    </p>
    <div class="mt-10 grid gap-4 lg:mt-14 lg:gap-6">
      {
        lines.map((line: (typeof lines)[number], index: number) => (
          <p
            data-manifesto-line
            class:list={[
              "overflow-hidden text-headline-2 leading-tight font-semibold tracking-tight text-balance",
              index % 3 === 1 && "lg:pl-16",
              index % 3 === 2 && "lg:pl-32",
            ]}
          >
            <span class="inline-block">{line}</span>
          </p>
        ))
      }
    </div>
  </div>
</section>
