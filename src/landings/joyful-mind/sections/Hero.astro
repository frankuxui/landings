---
import { ArrowUpRight } from "@lucide/astro"
import Photo from "../components/Photo.astro"
import Sparkles from "../components/Sparkles.astro"
import {
  conversationImage,
  coupleImage,
  heroMainImage,
  laughingWomenImage,
  outdoorGatheringImage,
} from "../data/images"
---

<section
  id="top"
  data-hero
  class="relative flex min-h-dvh flex-col overflow-hidden bg-inverted px-4 pt-24 pb-6 text-inverted-foreground sm:px-6 lg:pt-24"
>
  <div class="mx-auto flex w-full max-w-landing flex-1 flex-col">
    <div class="flex shrink-0 flex-col items-center text-center">
      <p
        class="inline-flex rounded-full bg-inverted-foreground/12 px-4 py-2 text-xs font-bold tracking-wide text-inverted-foreground uppercase"
      >
        Everyday emotional care
      </p>
      <h1
        class="mx-auto mt-5 max-w-hero-heading text-headline-1 leading-[1.05] font-bold tracking-tight text-balance"
      >
        Feel good. Live more.
      </h1>
      <p
        class="mx-auto mt-4 max-w-copy text-base leading-relaxed text-inverted-foreground/70 sm:text-lg"
      >
        Happiness does not solve everything. But making room for it can change
        the way we carry everything else.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a
          href="#moment"
          class="inline-flex min-h-12 items-center gap-2 rounded-full bg-(--color-primary) px-6 py-3.5 text-sm font-bold tracking-wide text-(--color-light) no-underline transition hover:scale-[1.03] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-ring active:scale-95 motion-reduce:transition-none"
        >
          Start feeling better
        </a>
        <a
          href="#habits"
          class="inline-flex min-h-12 items-center gap-1.5 rounded-full bg-inverted-foreground/12 px-6 py-3.5 text-sm font-bold tracking-wide text-inverted-foreground no-underline transition hover:bg-inverted-foreground/20 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-ring"
        >
          Explore small habits
          <ArrowUpRight aria-hidden="true" width="16" height="16" />
        </a>
      </div>
    </div>

    <div class="relative mt-6 flex flex-1 items-center justify-center">
      <Sparkles class="text-inverted-foreground opacity-70" />
      <div
        data-hero-collage
        class="relative aspect-4/3 max-h-full w-full max-w-5xl sm:aspect-16/10 lg:aspect-21/9"
      >
        <Photo
          image={heroMainImage}
          ratio="16 / 10"
          loading="eager"
          class="hero-main absolute top-1/2 left-1/2 z-30 w-11/12 -translate-x-1/2 -translate-y-1/2 sm:w-3/4 lg:w-7/12"
          imageClass="rounded-3xl shadow-2xl"
        />

        <Photo
          image={laughingWomenImage}
          ratio="4 / 3"
          class="hero-card hero-card-a absolute top-2 left-2 z-10 w-2/5 sm:top-4 sm:left-4 lg:w-1/3"
          imageClass="rounded-2xl"
        />
        <Photo
          image={coupleImage}
          ratio="4 / 3"
          class="hero-card hero-card-b absolute right-2 bottom-2 z-20 w-2/5 sm:right-4 sm:bottom-4 lg:w-1/3"
          imageClass="rounded-2xl"
        />
        <Photo
          image={conversationImage}
          ratio="4 / 3"
          class="hero-card hero-card-c absolute top-2 right-2 z-10 hidden w-1/3 sm:top-4 sm:right-4 md:block"
          imageClass="rounded-2xl"
        />
        <Photo
          image={outdoorGatheringImage}
          ratio="4 / 3"
          class="hero-card hero-card-d absolute bottom-2 left-2 z-10 hidden w-1/3 sm:bottom-4 sm:left-4 lg:block"
          imageClass="rounded-2xl"
        />
      </div>
    </div>
  </div>
</section>
