---
import { ArrowRight, ShoppingBag } from "@lucide/astro"
import { getWork } from "../data/works"

const work = getWork("hero-summit")
const srcset = [800, 1200, 1600, 2000, 2400]
  .map(
    (width: number) =>
      `${work.image.src}?w=${width}&auto=format&fit=crop&q=80 ${width}w`,
  )
  .join(", ")
---

<section
  id="top"
  class="relative flex min-h-[92vh] w-full items-end overflow-hidden bg-inverted-surface text-inverted-foreground"
  aria-labelledby="hero-heading"
>
  <div class="absolute inset-0 [clip-path:inset(0_0_0_0)]" data-hero-image-wrap>
    <img
      src={`${work.image.src}?w=2000&auto=format&fit=crop&q=80`}
      srcset={srcset}
      sizes="100vw"
      alt={work.image.alt}
      width={work.image.width}
      height={work.image.height}
      fetchpriority="high"
      decoding="async"
      class="h-full w-full scale-110 object-cover grayscale contrast-110"
      data-hero-parallax
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-black/10"
      aria-hidden="true"
    >
    </div>
  </div>

  <div
    class="relative z-10 mx-auto flex w-full max-w-landing flex-col gap-10 px-container-x pt-32 pb-14 sm:px-8 sm:pb-20 xl:px-14"
  >
    <div data-hero-headline>
      <p
        class="mb-5 font-mono text-xs font-semibold tracking-widest text-current/70 uppercase"
      >
        Editor's cover edition
      </p>
      <h1
        id="hero-heading"
        class="max-w-hero-heading text-balance text-headline-1 leading-[0.98] font-semibold"
      >
        Original photography, sold direct from the artist.
      </h1>
      <p class="mt-6 max-w-copy text-lg text-current/80 sm:text-xl">
        Aperture Editions is a marketplace of independent photographers selling
        their work as archival prints and licensed digital downloads — no
        galleries, no markup, no anonymous stock.
      </p>
    </div>

    <div
      class="flex flex-col gap-6 border-t border-current/15 pt-6 sm:flex-row sm:items-end sm:justify-between"
      data-hero-meta
    >
      <div>
        <p class="text-sm text-current/60">Featured this week</p>
        <p class="mt-1 text-xl font-semibold sm:text-2xl">
          "{work.title}" — {work.photographer}
        </p>
        <p class="mt-1 text-sm text-current/70">
          {work.location} · {work.technique} · from{" "}
          <span class="font-semibold text-current">{work.price}</span>
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a
          class="inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-none border-0 bg-inverted-foreground px-6 py-3 text-base font-semibold text-inverted no-underline transition duration-200 ease-landing hover:bg-current/85 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-current active:bg-current/75"
          href="#gallery"
        >
          Explore the gallery
          <ArrowRight
            aria-hidden="true"
            width="18"
            height="18"
            stroke-width="1.5"
          />
        </a>
        <a
          class="inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-none border-0 bg-white/10 px-6 py-3 text-base font-semibold text-inverted-foreground no-underline backdrop-blur-sm transition duration-200 ease-landing hover:bg-white/20 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-current active:bg-white/25"
          href={`#featured-works`}
        >
          <ShoppingBag
            aria-hidden="true"
            width="18"
            height="18"
            stroke-width="1.5"
          />
          Shop this edition
        </a>
      </div>
    </div>
  </div>

  <p
    class="absolute right-4 bottom-4 z-10 text-right text-[0.7rem] text-current/60 sm:right-8 xl:right-14"
  >
    Photo by{" "}
    <a
      href={work.image.authorUrl}
      rel="noopener"
      class="underline underline-offset-2 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
      >{work.image.author}</a
    >
    {" "}on{" "}
    <a
      href={work.image.unsplashUrl}
      rel="noopener"
      class="underline underline-offset-2 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
      >Unsplash</a
    >
  </p>
</section>

<script>
  import "../scripts/heroReveal"
</script>
