---
import { ChevronLeft, ChevronRight } from "@lucide/astro"
import PhotoCredit from "../components/PhotoCredit.astro"
import { allImages } from "../data/images"
import type { CommonsImage } from "../types"

const captions = [
  "Un borde de postal que sigue siendo real, sigue incompleto.",
  "Luz rural, fuera del marco del resort.",
  "Arquitectura que carga belleza y fatiga a la vez.",
  "Vida cotidiana moviéndose por calles construidas por otras épocas.",
  "Memoria colonial, aire de montaña y la presión de la preservación.",
  "La edad como archivo, no como símbolo.",
  "El mar como frontera, horizonte y salida.",
  "El cliché del movimiento, reconstruido como necesidad práctica.",
  "Una ciudad vista como capas, no como una sola imagen.",
]
---

<section
  class="overflow-hidden bg-background-alt px-container-x py-section palette-surface-light"
>
  <div class="mx-auto grid max-w-landing gap-12">
    <div
      class="grid min-h-[44vh] content-end gap-6 md:grid-cols-[1fr_auto] md:items-end"
    >
      <div>
        <p class="mb-5 font-condensed text-sm font-black uppercase text-muted">
          10 — Archivo visual
        </p>
        <h2
          class="max-w-heading font-display text-headline-1 leading-none uppercase"
        >
          La isla sin filtro.
        </h2>
      </div>
      <p class="font-condensed text-sm font-black uppercase text-muted">
        Arrastra →
      </p>
    </div>
    <div class="grid gap-5 md:grid-cols-[0.55fr_1fr] md:items-end">
      <p class="max-w-copy text-muted">
        Una secuencia documental de costa, ciudad, vejez, calle, arquitectura,
        turismo y vida ordinaria. Rechaza la historia única: ni toda miseria, ni
        toda postal.
      </p>
    </div>
    <div class="island-slider swiper overflow-visible" data-island-slider>
      <div class="swiper-wrapper">
        {
          allImages.map((image: CommonsImage, index: number) => (
            <div
              class:list={[
                "swiper-slide",
                index % 3 === 0 && "gallery-slide-cinema",
                index % 3 === 1 && "gallery-slide-tall",
                index % 3 === 2 && "gallery-slide-wide",
              ]}
            >
              <figure class="m-0 grid gap-3">
                <div
                  data-slide-image
                  class:list={[
                    "relative overflow-hidden bg-placeholder",
                    index % 3 === 1 ? "aspect-3/4" : "aspect-video",
                  ]}
                >
                  <img
                    src={image.src}
                    alt={image.alt}
                    width={image.width}
                    height={image.height}
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full object-cover photo-tone"
                  />
                </div>
                <figcaption class="grid gap-2 border-t border-border pt-3">
                  <div class="flex items-start justify-between gap-5">
                    <p
                      data-slide-number
                      class="font-display text-headline-3 leading-none"
                    >
                      {String(index + 1).padStart(2, "0")}
                    </p>
                    <p
                      data-slide-title
                      class="max-w-copy font-condensed text-lg font-black uppercase leading-tight text-right"
                    >
                      {image.creditLine}
                    </p>
                  </div>
                  <p data-slide-copy class="text-sm leading-relaxed text-muted">
                    {captions[index] ??
                      "Un fragmento de la isla leído como evidencia, no como decoración."}
                  </p>
                  <PhotoCredit image={image} class="opacity-80" />
                </figcaption>
              </figure>
            </div>
          ))
        }
      </div>
    </div>
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-island-prev
          aria-label="Imagen anterior"
          class="inline-flex size-11 min-h-11 items-center justify-center border border-border bg-control text-foreground hover:bg-control-hover focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border disabled:cursor-not-allowed disabled:opacity-40"
        >
          <ChevronLeft aria-hidden="true" width="18" height="18" />
        </button>
        <button
          type="button"
          data-island-next
          aria-label="Imagen siguiente"
          class="inline-flex size-11 min-h-11 items-center justify-center border border-border bg-control text-foreground hover:bg-control-hover focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border disabled:cursor-not-allowed disabled:opacity-40"
        >
          <ChevronRight aria-hidden="true" width="18" height="18" />
        </button>
      </div>
      <p data-island-counter class="font-mono text-xs uppercase text-muted">
        01 / 07
      </p>
      <div class="h-px flex-1 bg-border">
        <div
          data-island-progress
          class="h-px origin-left scale-x-0 bg-foreground"
        >
        </div>
      </div>
    </div>
  </div>
</section>
