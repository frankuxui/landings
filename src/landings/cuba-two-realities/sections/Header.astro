---
import { Menu, Moon, Sun, X } from "@lucide/astro"

const links = [
  { href: "#postcard", label: "01 — La postal" },
  { href: "#two-cubas", label: "02 — Dos Cubas" },
  { href: "#havana", label: "03 — La Habana" },
  { href: "#living", label: "04 — Vivir" },
  { href: "#leaving", label: "05 — Salir" },
  { href: "#voices", label: "06 — Voces" },
  { href: "#sources", label: "07 — Archivo" },
]
---

<header
  class="fixed top-4 right-4 left-4 z-50 border border-border bg-inverted/90 text-inverted-foreground shadow-lg backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-landing items-center justify-between gap-3 px-4 py-3 sm:px-6"
  >
    <a
      href="#top"
      class="group inline-flex items-center gap-2.5 font-display text-sm uppercase tracking-wide no-underline focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border sm:text-base"
    >
      <span
        aria-hidden="true"
        class="size-2 shrink-0 bg-inverted-foreground transition group-hover:scale-125"
      ></span>
      Cuba — Dos Realidades
    </a>
    <p
      class="hidden items-center gap-2 text-xs uppercase tracking-wide text-inverted-foreground/70 md:flex"
    >
      <span
        aria-hidden="true"
        class="size-1.5 animate-pulse rounded-full bg-inverted-foreground/70"
      ></span>
      23.1136° N / 82.3666° W
    </p>
    <nav
      aria-label="Secciones principales"
      class="hidden items-center gap-6 nav:flex"
    >
      {
        links.slice(0, 5).map((link: (typeof links)[number]) => (
          <a
            href={link.href}
            class="relative py-1 text-xs uppercase tracking-wide text-inverted-foreground/75 transition after:absolute after:-bottom-0.5 after:left-0 after:h-px after:w-0 after:bg-inverted-foreground after:transition-all after:duration-300 after:ease-landing hover:text-inverted-foreground hover:after:w-full focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
          >
            {link.label.replace(/^\d+ — /, "")}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2.5">
      <button
        type="button"
        data-theme-toggle
        aria-label="Cambiar a tema oscuro"
        aria-pressed="false"
        class="relative inline-flex h-9 w-16 shrink-0 items-center rounded-full border border-inverted-foreground/30 bg-inverted-surface p-1 transition hover:border-inverted-foreground/60 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
      >
        <span
          data-theme-thumb
          aria-hidden="true"
          class="flex size-7 items-center justify-center rounded-full bg-inverted-foreground text-inverted transition-transform duration-300 ease-landing dark:translate-x-7"
        >
          <Sun aria-hidden="true" width="14" height="14" class="dark:hidden" />
          <Moon
            aria-hidden="true"
            width="14"
            height="14"
            class="hidden dark:block"
          />
        </span>
      </button>
      <button
        type="button"
        data-menu-toggle
        aria-label="Abrir navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex min-h-10 items-center gap-2 border border-inverted-foreground/30 bg-inverted-surface px-3 text-xs font-semibold uppercase tracking-wide text-inverted-foreground transition hover:bg-inverted-foreground hover:text-inverted focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
      >
        <Menu aria-hidden="true" width="17" height="17" />
        Menú
      </button>
    </div>
  </div>
  <div
    aria-hidden="true"
    class="documentary-rule h-px w-full text-inverted-foreground/25"
  >
  </div>
</header>

<div
  id="mobile-menu"
  data-menu-panel
  aria-hidden="true"
  class="fixed inset-0 z-60 flex min-h-dvh flex-col justify-between overflow-hidden bg-inverted/95 px-5 py-6 text-inverted-foreground backdrop-blur-xl"
>
  <div class="flex items-center justify-between">
    <p class="font-display text-sm uppercase">Cuba — Dos Realidades</p>
    <button
      type="button"
      data-menu-close
      aria-label="Cerrar navegación"
      class="inline-flex size-11 min-h-11 items-center justify-center border border-inverted-foreground/30 bg-inverted-surface text-inverted-foreground focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
    >
      <X aria-hidden="true" width="18" height="18" />
    </button>
  </div>
  <nav aria-label="Navegación móvil" class="grid gap-2 py-12">
    {
      links.map((link: (typeof links)[number]) => (
        <a
          href={link.href}
          class="overflow-hidden font-display text-headline-2 leading-none uppercase text-inverted-foreground no-underline focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
  <div
    data-menu-meta
    class="grid gap-4 border-t border-inverted-foreground/20 pt-5 text-sm text-inverted-foreground/70 sm:grid-cols-3"
  >
    <p>El panel se abre de izquierda a derecha.</p>
    <p>Teclado: Tab, Shift+Tab, Escape.</p>
    <p>Paleta: escala de grises por defecto, color por elección.</p>
  </div>
</div>
