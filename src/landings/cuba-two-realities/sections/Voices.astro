---
import { ChevronLeft, ChevronRight } from "@lucide/astro"
import PhotoCredit from "../components/PhotoCredit.astro"
import { images } from "../data/images"
import { sources, voices } from "../data/sources"
import type { SourceReference, VoiceFragment } from "../types"

const sourceById = new Map(
  sources.map((source: SourceReference) => [source.id, source]),
)
---

<section id="voices" class="bg-background px-container-x py-section">
  <div class="mx-auto grid max-w-landing gap-10">
    <div class="grid gap-6 md:grid-cols-2 md:items-end">
      <h2
        class="max-w-heading font-display text-headline-2 leading-none uppercase"
      >
        Voces sin invención.
      </h2>
      <p class="max-w-copy text-muted">
        Ningún testimonio es fabricado. Son fragmentos editoriales basados en
        reportajes documentados, con la fuente citada en cada cuadro.
      </p>
    </div>
    <div class="voices-slider swiper overflow-visible" data-voices-slider>
      <div class="swiper-wrapper">
        {
          voices.map((voice: VoiceFragment) => {
            const source = sourceById.get(voice.sourceId)
            const image = images[voice.imageId]
            return (
              <article class="swiper-slide voice-slide border border-border bg-surface">
                <div class="grid md:grid-cols-[0.82fr_1fr]">
                  <div class="relative min-h-80 overflow-hidden bg-placeholder">
                    <img
                      src={image.src}
                      alt={image.alt}
                      width={image.width}
                      height={image.height}
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 h-full w-full object-cover photo-tone"
                    />
                  </div>
                  <div class="flex min-h-96 flex-col justify-between p-6">
                    <div>
                      <p class="font-display text-figure leading-none">
                        {voice.number}
                      </p>
                      <h3 class="mt-5 font-display text-headline-3 leading-none uppercase">
                        {voice.title}
                      </h3>
                      <p class="mt-2 text-xs font-semibold uppercase text-muted">
                        {voice.place}
                      </p>
                      <p class="mt-6 font-serif text-xl leading-snug text-muted">
                        {voice.text}
                      </p>
                    </div>
                    <div class="mt-8 grid gap-2">
                      {source && (
                        <a
                          href={source.url}
                          rel="noopener"
                          target="_blank"
                          class="text-sm font-semibold underline underline-offset-4"
                        >
                          Fuente: {source.publisher}
                        </a>
                      )}
                      <PhotoCredit image={image} />
                    </div>
                  </div>
                </div>
              </article>
            )
          })
        }
      </div>
    </div>
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-voices-prev
          aria-label="Voz anterior"
          class="inline-flex size-11 min-h-11 items-center justify-center border border-border bg-control text-foreground hover:bg-control-hover focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border disabled:cursor-not-allowed disabled:opacity-40"
        >
          <ChevronLeft aria-hidden="true" width="18" height="18" />
        </button>
        <button
          type="button"
          data-voices-next
          aria-label="Voz siguiente"
          class="inline-flex size-11 min-h-11 items-center justify-center border border-border bg-control text-foreground hover:bg-control-hover focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border disabled:cursor-not-allowed disabled:opacity-40"
        >
          <ChevronRight aria-hidden="true" width="18" height="18" />
        </button>
      </div>
      <p data-voices-counter class="font-mono text-xs uppercase text-muted">
        01 / 04
      </p>
      <div class="h-px flex-1 bg-border">
        <div
          data-voices-progress
          class="h-px origin-left scale-x-0 bg-foreground"
        >
        </div>
      </div>
    </div>
  </div>
</section>
