---
import PhotoCredit from "../components/PhotoCredit.astro"
import { images } from "../data/images"

const scenes = [
  {
    label: "Water",
    verb: "Finding it.",
    body: "A practical question before it becomes a political one: where, when, how much, and who carries it home.",
    motion: "from-left",
  },
  {
    label: "Food",
    verb: "Getting it.",
    body: "The day bends around what is available, what is rationed, what appears through family, neighbors or informal exchange.",
    motion: "mask",
  },
  {
    label: "Light",
    verb: "Waiting for it.",
    body: "Electricity becomes a schedule, a rumor, a battery percentage, a room growing hotter while everyone recalculates.",
    motion: "dark",
  },
  {
    label: "Transport",
    verb: "Solving it.",
    body: "Distance is not only geography. It is fuel, parts, buses, time, heat, work, school and the body arriving tired.",
    motion: "side",
  },
  {
    label: "Family",
    verb: "Holding it.",
    body: "Remittances, calls, shared rooms, older relatives, children, someone abroad and someone at home doing the emotional math.",
    motion: "lines",
  },
  {
    label: "Future",
    verb: "Imagining it.",
    body: "The hardest scarcity is sometimes not a product. It is the ability to picture a life that does not require leaving.",
    motion: "focus",
  },
]
---

<section
  id="living"
  data-living
  class="bg-inverted px-container-x py-section text-inverted-foreground"
>
  <div class="mx-auto grid max-w-landing gap-12">
    <div
      class="grid min-h-dvh gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-start"
    >
      <div
        class="grid content-start gap-12 pt-20 lg:sticky lg:top-24 lg:min-h-[calc(100vh-6rem)]"
      >
        <div>
          <p
            class="mb-4 font-condensed text-sm font-black uppercase text-inverted-foreground/60"
          >
            05 / Daily Life
          </p>
          <h2
            class="max-w-heading font-display text-headline-1 leading-none uppercase"
          >
            Living also means resolving.
          </h2>
        </div>
        <p class="max-w-copy text-xl leading-snug text-inverted-foreground/70">
          This is not a melodrama of survival. It is the ordinary intelligence
          of a day organized around what might be missing.
        </p>
      </div>

      <div class="grid gap-12 lg:grid-cols-[1fr_0.78fr]">
        <div class="lg:sticky lg:top-24 lg:h-[calc(100vh-6rem)]">
          <div
            class="relative h-[64vh] overflow-hidden border border-inverted-foreground/20 lg:h-full"
          >
            <img
              src={images.streetLife.src}
              alt={images.streetLife.alt}
              width={images.streetLife.width}
              height={images.streetLife.height}
              loading="lazy"
              decoding="async"
              data-living-image
              class="absolute inset-0 h-full w-full object-cover photo-tone"
            />
            <img
              src={images.oldHavana.src}
              alt={images.oldHavana.alt}
              width={images.oldHavana.width}
              height={images.oldHavana.height}
              loading="lazy"
              decoding="async"
              data-living-image-next
              class="absolute inset-0 h-full w-full object-cover opacity-0 photo-tone"
            />
            <div data-living-shade class="absolute inset-0 bg-inverted/10">
            </div>
          </div>
          <div class="mt-2 grid gap-2 sm:grid-cols-2">
            <PhotoCredit
              image={images.streetLife}
              class="text-inverted-foreground/70"
            />
            <PhotoCredit
              image={images.oldHavana}
              class="text-inverted-foreground/70 sm:text-right"
            />
          </div>
        </div>

        <div class="grid gap-16 py-8 lg:py-[35vh]">
          {
            scenes.map((scene: (typeof scenes)[number]) => (
              <article
                data-living-scene
                data-motion={scene.motion}
                class="min-h-64 border-t border-inverted-foreground/20 pt-6"
              >
                <p class="font-condensed text-sm font-black uppercase text-inverted-foreground/50">
                  {scene.label}
                </p>
                <h3 class="mt-3 font-display text-headline-3 leading-none uppercase">
                  {scene.verb}
                </h3>
                <p class="mt-5 text-lg leading-snug text-inverted-foreground/70">
                  {scene.body}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
