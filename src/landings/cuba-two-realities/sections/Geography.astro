---

---

<section
  data-geography
  class="relative bg-inverted px-container-x py-section text-inverted-foreground"
>
  <div class="mx-auto grid max-w-landing gap-16">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-end">
      <div class="reveal">
        <p
          class="mb-4 text-xs font-semibold uppercase text-inverted-foreground/60"
        >
          90 millas no son nada
        </p>
        <h2
          class="max-w-heading font-display text-headline-2 leading-none uppercase"
        >
          La distancia es geográfica. La decisión es íntima.
        </h2>
      </div>
      <p class="max-w-copy text-lg text-inverted-foreground/75">
        El mar puede parecer pequeño en un mapa. En la vida familiar, puede
        convertirse en una frontera entre cumpleaños, medicinas, cuidados,
        dinero, noticias y silencio.
      </p>
    </div>

    <div
      class="relative min-h-[60vh] overflow-hidden border border-inverted-foreground/20 bg-inverted-surface p-6 sm:p-10"
    >
      <svg
        viewBox="0 0 800 400"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="mx-auto h-full w-full max-w-4xl"
        aria-label="Mapa esquemático mostrando Cuba, Florida y el estrecho de 90 millas entre ambos"
        role="img"
      >
        <text
          x="580"
          y="60"
          class="fill-inverted-foreground/40 text-xs uppercase"
          font-family="Archivo Black, sans-serif"
        >
          Florida, EE.UU.
        </text>
        <path
          d="M520 80 C560 75, 620 70, 680 85 C720 95, 740 110, 750 140 C755 160, 745 175, 730 185 C720 192, 710 196, 700 200"
          stroke="currentColor"
          stroke-opacity="0.3"
          stroke-width="2"
          fill="none"></path>
        <line
          x1="400"
          y1="180"
          x2="400"
          y2="220"
          stroke="currentColor"
          stroke-opacity="0.2"
          stroke-dasharray="4 4"></line>
        <text
          x="400"
          y="210"
          text-anchor="middle"
          class="fill-inverted-foreground/50 text-xs uppercase"
          font-family="Archivo Black, sans-serif"
        >
          90 millas / 150 km
        </text>
        <path
          d="M80 280 C120 275, 180 260, 260 255 C340 250, 420 248, 500 252 C560 255, 620 262, 680 275 C720 282, 740 288, 760 295"
          stroke="currentColor"
          stroke-width="3"
          fill="none"></path>
        <text
          x="400"
          y="310"
          text-anchor="middle"
          class="fill-inverted-foreground text-sm font-bold uppercase"
          font-family="Archivo Black, sans-serif"
        >
          Cuba
        </text>
        <text
          x="150"
          y="360"
          class="fill-inverted-foreground/30 text-xs"
          font-family="Archivo Black, sans-serif"
        >
          Mar Caribe
        </text>
        <text
          x="600"
          y="360"
          class="fill-inverted-foreground/30 text-xs"
          font-family="Archivo Black, sans-serif"
        >
          23.1136° N / 82.3666° W
        </text>
      </svg>
    </div>

    <div class="grid min-h-[50vh] content-center gap-6">
      <p
        data-geo-word-leave
        class="font-display text-headline-1 leading-none uppercase"
      >
        Irse.
      </p>
      <p
        data-geo-word-stay
        class="text-right font-display text-headline-1 leading-none uppercase text-inverted-foreground/50"
      >
        Quedarse.
      </p>
      <p
        class="mx-auto mt-8 max-w-copy text-center text-lg text-inverted-foreground/70"
      >
        Dos verbos. Un estrecho. Millones de decisiones que no caben en una
        estadística.
      </p>
    </div>
  </div>
</section>
