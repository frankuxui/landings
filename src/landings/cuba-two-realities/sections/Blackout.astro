---
import { images } from "../data/images"

const words = [
  "otra vez.",
  "esperando.",
  "calor.",
  "silencio.",
  "batería.",
  "mañana.",
]
---

<section
  data-blackout
  class="relative overflow-hidden bg-inverted px-container-x py-section text-inverted-foreground"
>
  <img
    src={images.malecon.src}
    alt={images.malecon.alt}
    width={images.malecon.width}
    height={images.malecon.height}
    loading="lazy"
    decoding="async"
    data-blackout-image
    class="absolute inset-0 h-full w-full object-cover opacity-30 photo-tone"
  />
  <div class="absolute inset-0 bg-inverted/70"></div>
  <div
    class="relative mx-auto grid min-h-dvh max-w-landing content-center gap-8"
  >
    <p
      class="font-condensed text-sm font-black uppercase text-inverted-foreground/60"
    >
      Acto III — Energía
    </p>
    <h2
      data-blackout-text
      class="max-w-heading font-display text-headline-1 leading-none uppercase"
    >
      Se fue la luz.
    </h2>
    <div class="flex flex-wrap gap-x-6 gap-y-3">
      {
        words.map((word: string) => (
          <span
            data-blackout-word
            class="blackout-word font-display text-headline-3 leading-none uppercase text-inverted-foreground/80"
          >
            {word}
          </span>
        ))
      }
    </div>
    <p class="max-w-copy text-xl leading-snug text-inverted-foreground/75">
      Esta sección no simula un temporizador dramático. El dato documentado es
      suficiente: los apagones prolongados y nacionales han condicionado el
      acceso a alimentos, educación, salud y trabajo.
    </p>
    <div
      class="mt-8 grid gap-4 border-t border-inverted-foreground/20 pt-8 sm:grid-cols-2"
    >
      <div>
        <p class="font-display text-figure leading-none uppercase">5</p>
        <p class="mt-2 text-sm text-inverted-foreground/60">
          Apagones nacionales documentados entre octubre de 2024 y septiembre de
          2025.
        </p>
      </div>
      <p class="max-w-copy text-inverted-foreground/60">
        Fuente: Human Rights Watch, Informe Mundial 2026. La crisis energética
        refleja factores internos como infraestructura envejecida y dependencia
        de combustible importado, junto con restricciones externas que complican
        la inversión en el sector.
      </p>
    </div>
  </div>
</section>
