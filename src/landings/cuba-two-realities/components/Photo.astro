---
import PhotoCredit from "./PhotoCredit.astro"
import type { CommonsImage } from "../types"

type PhotoRatio = "1 / 1" | "3 / 4" | "4 / 3" | "16 / 9"

export interface Props {
  image: CommonsImage
  ratio?: PhotoRatio
  loading?: "eager" | "lazy"
  caption?: boolean
  parallax?: boolean
  class?: string
  imgClass?: string
}

const {
  image,
  ratio = "4 / 3",
  loading = "lazy",
  caption = true,
  parallax = false,
  class: className,
  imgClass,
} = Astro.props
---

<figure class:list={["m-0 flex w-full flex-col", className]}>
  <div
    class:list={[
      "relative w-full overflow-hidden bg-placeholder",
      ratio === "1 / 1" && "aspect-square",
      ratio === "3 / 4" && "aspect-3/4",
      ratio === "4 / 3" && "aspect-4/3",
      ratio === "16 / 9" && "aspect-video",
    ]}
  >
    <img
      src={image.src}
      alt={image.alt}
      title={`${image.creditLine} by ${image.author}`}
      width={image.width}
      height={image.height}
      loading={loading}
      decoding="async"
      data-parallax={parallax ? "true" : undefined}
      class:list={[
        "absolute inset-0 h-full w-full object-cover photo-tone",
        parallax && "scale-110",
        imgClass,
      ]}
    />
  </div>
  {
    caption && (
      <figcaption class="mt-2">
        <PhotoCredit image={image} />
      </figcaption>
    )
  }
</figure>
