---
// Egypt — Hero: "The Sands Remember"
// Full viewport cinematic opening with the Pyramids of Giza.
// GSAP parallax on scroll: image scales, text separates and fades.
import { heroImage } from "../data/images"
---

<section
  id="home"
  class="relative flex min-h-svh items-end overflow-hidden bg-[var(--egypt-obsidian)]"
  aria-label="Hero — The Sands Remember"
>
  <!-- Background image with parallax -->
  <div class="absolute inset-0 z-0" data-hero-image>
    <img
      src={`${heroImage.src}&w=2000&auto=format&fit=crop&q=80`}
      srcset={`${heroImage.src}&w=1200&auto=format&fit=crop&q=80 1200w, ${heroImage.src}&w=1600&auto=format&fit=crop&q=80 1600w, ${heroImage.src}&w=2000&auto=format&fit=crop&q=80 2000w, ${heroImage.src}&w=2400&auto=format&fit=crop&q=80 2400w`}
      sizes="100vw"
      alt={heroImage.alt}
      title={`Photo by ${heroImage.author} on Unsplash`}
      width={heroImage.width}
      height={heroImage.height}
      loading="eager"
      decoding="async"
      class="photo-tone h-full w-full object-cover opacity-70"
    />
    <!-- Sand/gradient overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-[var(--egypt-obsidian)] via-[var(--egypt-obsidian)]/40 to-transparent"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Content -->
  <div
    class="relative z-10 mx-auto w-full max-w-landing px-container-x pb-16 pt-32 sm:px-8 sm:pb-24 xl:px-14 xl:pb-32"
  >
    <!-- Coordinates -->
    <div
      class="mb-8 flex items-center gap-4 font-mono text-xs tracking-widest text-white/60 sm:text-sm"
      data-hero-coords
    >
      <span>29.9792&#176; N / 31.1342&#176; E</span>
      <span class="h-px w-8 bg-white/30" aria-hidden="true"></span>
      <span>GIZA &mdash; EGYPT</span>
    </div>

    <!-- Title -->
    <h1
      class="font-display text-[clamp(4rem,8vw+1rem,12rem)] font-normal uppercase leading-none tracking-wider text-white"
      data-hero-title
    >
      Egypt
    </h1>

    <!-- Subtitle -->
    <p
      class="mt-6 max-w-xl text-lg leading-relaxed text-white/80 italic sm:text-xl lg:text-2xl"
      data-hero-subtitle
    >
      Beneath the sands, eternity waits.
    </p>
  </div>

  <!-- Photo credit below the hero image area -->
  <div
    class="absolute bottom-3 right-4 z-10 text-[10px] text-white/40 sm:bottom-4 sm:right-8"
  >
    Photo by <a
      href={heroImage.authorUrl}
      rel="noopener"
      class="text-white/50 underline hover:text-white/70">{heroImage.author}</a
    >
    on <a
      href={heroImage.unsplashUrl}
      rel="noopener"
      class="text-white/50 underline hover:text-white/70">Unsplash</a
    >
  </div>
</section>
