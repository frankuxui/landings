---
// Egypt — Section 04: "The Gods Were Everywhere"
// Image-dominant god panels. Dark, mystical section with horizontal scroll
// on desktop revealing each god with a full background image.
import type { UnsplashImage } from "../data/images"
import {
  raImage,
  osirisImage,
  isisImage,
  anubisImage,
  horusImage,
} from "../data/images"

interface EgyptianGod {
  name: string
  domain: string
  description: string
  ambientColor: string
  image: UnsplashImage
}

const gods: EgyptianGod[] = [
  {
    name: "Ra",
    domain: "Sun, Creation",
    description:
      "The supreme solar deity. Each dawn, Ra was reborn. Each dusk, he descended into the underworld to battle chaos. The sun itself was his eye.",
    ambientColor: "var(--egypt-gold)",
    image: raImage,
  },
  {
    name: "Osiris",
    domain: "Death, Resurrection",
    description:
      "Murdered by his brother Set, resurrected by his wife Isis. He became lord of the underworld and judge of the dead — proof that death was not the end.",
    ambientColor: "var(--egypt-turquoise)",
    image: osirisImage,
  },
  {
    name: "Isis",
    domain: "Magic, Motherhood",
    description:
      "The most powerful magician in Egyptian mythology. She reassembled Osiris, protected Horus, and her worship spread across the entire ancient world.",
    ambientColor: "var(--egypt-sand)",
    image: isisImage,
  },
  {
    name: "Anubis",
    domain: "Mummification, the Dead",
    description:
      "Jackal-headed guide of souls. He invented embalming, weighed the hearts of the dead, and stood sentinel at the boundary between life and the afterlife.",
    ambientColor: "var(--egypt-obsidian)",
    image: anubisImage,
  },
  {
    name: "Horus",
    domain: "Sky, Royalty",
    description:
      "Falcon-headed son of Osiris and Isis. Every living pharaoh was considered an incarnation of Horus — the sky made flesh, kingship made divine.",
    ambientColor: "var(--egypt-lapis)",
    image: horusImage,
  },
]
---

<section
  id="gods"
  class="relative overflow-hidden bg-[var(--egypt-obsidian)] py-section"
  aria-labelledby="gods-heading"
  data-gods-container
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <!-- Chapter marker -->
    <p
      class="mb-4 font-mono text-xs uppercase tracking-widest text-[var(--egypt-gold)]/60"
    >
      04 &mdash; The Gods Were Everywhere
    </p>

    <h2
      id="gods-heading"
      class="font-display text-headline-1 uppercase leading-none tracking-wider text-white"
    >
      The Gods<br />Were<br />Everywhere
    </h2>

    <p
      class="mt-6 max-w-copy text-lg leading-relaxed text-[var(--egypt-sand)]/70 italic"
    >
      Religion was not separate from life. It was life itself. Every harvest,
      every flood, every breath was a conversation with the divine.
    </p>
  </div>

  <!-- Horizontal scroll track (GSAP pins on desktop, vertical on mobile) -->
  <div
    class="mt-16 flex flex-col gap-8 px-container-x sm:px-8 lg:mt-24 lg:flex-row lg:gap-0 xl:px-14"
    data-gods-track
  >
    {
      gods.map((god: EgyptianGod) => (
        <article
          class="group relative shrink-0 overflow-hidden rounded-sm lg:flex lg:h-screen lg:w-screen lg:items-end lg:rounded-none"
          data-god-panel
        >
          {/* Background image */}
          <img
            src={`${god.image.src}&w=1600&auto=format&fit=crop&q=80`}
            srcset={`${god.image.src}&w=800&auto=format&fit=crop&q=80 800w, ${god.image.src}&w=1200&auto=format&fit=crop&q=80 1200w, ${god.image.src}&w=1600&auto=format&fit=crop&q=80 1600w`}
            sizes="(max-width: 1024px) 100vw, 100vw"
            alt={god.image.alt}
            width={god.image.width}
            height={god.image.height}
            loading="lazy"
            decoding="async"
            class="photo-tone aspect-3/4 w-full object-cover transition-transform duration-700 ease-landing group-hover:scale-[1.05] sm:aspect-[4/5] lg:absolute lg:inset-0 lg:aspect-auto lg:h-full"
            data-god-image
          />

          {/* Dark gradient overlay from bottom */}
          <div
            class="pointer-events-none absolute inset-0 bg-linear-to-t from-[var(--egypt-obsidian)] via-[var(--egypt-obsidian)]/60 to-transparent lg:via-[var(--egypt-obsidian)]/40"
            aria-hidden="true"
          />

          {/* Ambient glow — complements the image */}
          <div
            class="pointer-events-none absolute inset-0 hidden opacity-[0.08] lg:block"
            style={`background: radial-gradient(ellipse at center bottom, ${god.ambientColor} 0%, transparent 60%);`}
            aria-hidden="true"
          />

          {/* Text content at bottom */}
          <div class="relative z-10 w-full p-6 sm:p-8 lg:max-w-xl lg:p-12">
            <p class="font-mono text-[10px] uppercase tracking-widest text-[var(--egypt-gold)]">
              {god.domain}
            </p>
            <h3 class="mt-2 font-display text-[clamp(2.5rem,5vw,5rem)] uppercase leading-none tracking-wider text-white">
              {god.name}
            </h3>
            <p class="mt-4 text-sm leading-relaxed text-[var(--egypt-sand)]/80 lg:text-base">
              {god.description}
            </p>
            <p class="mt-3 text-[10px] text-[var(--egypt-sand)]/30">
              Photo by{" "}
              <a
                href={god.image.authorUrl}
                rel="noopener"
                class="underline hover:text-[var(--egypt-sand)]/50"
              >
                {god.image.author}
              </a>{" "}
              on{" "}
              <a
                href={god.image.unsplashUrl}
                rel="noopener"
                class="underline hover:text-[var(--egypt-sand)]/50"
              >
                Unsplash
              </a>
            </p>
          </div>
        </article>
      ))
    }
  </div>
</section>
