---
// Egypt — "Beneath the Sands"
// Root document for this landing. Fully self-contained.
// This landing intentionally uses chromatic colors (Ancient Egyptian palette)
// as a user-approved exception to the gallery's monochrome rule.
import "./styles/tailwind.css"

import Header from "./sections/Header.astro"
import Hero from "./sections/Hero.astro"
import Timeline from "./sections/Timeline.astro"
import Architecture from "./sections/Architecture.astro"
import Pharaohs from "./sections/Pharaohs.astro"
import Gods from "./sections/Gods.astro"
import BookOfDead from "./sections/BookOfDead.astro"
import WeighingHeart from "./sections/WeighingHeart.astro"
import Treasures from "./sections/Treasures.astro"
import Hieroglyphs from "./sections/Hieroglyphs.astro"
import HieroglyphsTorch from "./sections/HieroglyphsTorch.astro"
import Sky from "./sections/Sky.astro"
import Valley from "./sections/Valley.astro"
import Discovery from "./sections/Discovery.astro"
import StillBeneath from "./sections/StillBeneath.astro"
import Footer from "./sections/Footer.astro"
import BackToTop from "./components/BackToTop.astro"

const pageTitle = "Egypt — Beneath the Sands"
const pageDescription =
  "An immersive digital experience exploring five thousand years of Ancient Egyptian civilization — pyramids, pharaohs, gods, hieroglyphs, and the treasures beneath the sand."
const canonicalUrl = "/landings/egypt"
const thumbnailUrl =
  "https://images.unsplash.com/photo-1539650116574-8efeb43e2750?ixid=M3wxMDQwNDk5fDB8MXxzZWFyY2h8Mnx8cHlyYW1pZHMlMjBvZiUyMGdpemElMjBkZXNlcnQlMjBjaW5lbWF0aWN8ZW58MXwwfHx8MTcyNDg1MjAwMHww&ixlib=rb-4.1.0&w=1200&auto=format&fit=crop&q=80"
---

<!doctype html>
<html
  lang="en"
  class="scroll-smooth overflow-x-clip scheme-light motion-reduce:scroll-auto dark:scheme-dark font-sans"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Restore persisted theme before first paint -->
    <script is:inline>
      ;(function () {
        var saved = localStorage.getItem("egypt:theme")
        if (saved === "dark" || saved === "light") {
          document.documentElement.setAttribute("data-theme", saved)
        }
      })()
    </script>

    <!-- Restore persisted palette before first paint -->
    <script is:inline>
      try {
        var storedPalette = localStorage.getItem("egypt:palette")
        if (storedPalette)
          document.documentElement.dataset.palette = storedPalette
      } catch (error) {}
    </script>

    <!-- Google Fonts — Marcellus SC (display) + Cormorant Garamond (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Marcellus+SC&display=swap"
      rel="stylesheet"
    />

    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="noindex" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={thumbnailUrl} />
    <meta property="og:url" content={canonicalUrl} />
  </head>
  <body
    class="min-h-full overflow-x-clip bg-background text-base leading-relaxed text-foreground antialiased font-sans"
  >
    <a
      class="absolute -top-full left-4 z-1000 inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-sm border-0 bg-(--color-primary) px-5 py-3 text-base font-semibold text-(--color-light) no-underline transition duration-200 ease-landing hover:opacity-90 focus-visible:top-4 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:opacity-90"
      href="#main-content"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main-content">
      <Hero />
      <Timeline />
      <Architecture />
      <Pharaohs />
      <Gods />
      <BookOfDead />
      <WeighingHeart />
      <Treasures />
      <Hieroglyphs />
      <HieroglyphsTorch />
      <Sky />
      <Valley />
      <Discovery />
      <StillBeneath />
    </main>

    <Footer />

    <BackToTop />

    <script>
      import "./scripts/theme"
      import "./scripts/palette"
      import "./scripts/reveal"
      import "./scripts/backToTop"
      import "./scripts/gsapAnimations"
      import "./scripts/treasuresSlider"
    </script>
  </body>
</html>
