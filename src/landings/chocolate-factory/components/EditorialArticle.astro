---
import Photo from "./Photo.astro"
import type { EditorialPiece } from "../types"

export interface Props {
  piece: EditorialPiece
}

const { piece } = Astro.props
---

<article
  class:list={[
    "reveal @container flex flex-col gap-6 bg-surface p-6 xl:p-8",
    piece.featured && "md:col-span-2",
  ]}
>
  <div
    class:list={[
      "flex flex-col gap-6",
      piece.featured && "@md:flex-row @md:items-center @md:gap-10",
    ]}
  >
    <Photo
      image={piece.image}
      ratio={piece.featured ? "16 / 10" : "4 / 3"}
      class:list={[piece.featured && "@md:w-1/2"]}
    />
    <div class:list={["flex flex-col gap-3", piece.featured && "@md:w-1/2"]}>
      <p
        class="font-mono text-xs font-semibold tracking-widest text-muted uppercase"
      >
        {piece.eyebrow}
      </p>
      <h3
        class:list={[
          "text-balance leading-tight font-semibold text-foreground",
          piece.featured ? "text-headline-2" : "text-headline-3",
        ]}
      >
        {piece.title}
      </h3>
      <p class="text-muted">{piece.excerpt}</p>
    </div>
  </div>
</article>
