---
// Real photography sourced from Unsplash via the `unsplash-images` Skill.
// Renders the persisted, hotlinked `images.unsplash.com` URL with the
// landing's monochrome treatment and a visible, keyboard-reachable credit —
// see src/landings/chocolate-factory/data/images.ts for the source metadata.
import type { UnsplashImage } from "../types"

type PhotoRatio = "1 / 1" | "3 / 4" | "4 / 3" | "16 / 10" | "9 / 16"

export interface Props {
  image: UnsplashImage
  ratio?: PhotoRatio
  class?: string
}

const { image, ratio = "4 / 3", class: className } = Astro.props
---

<figure
  class:list={[
    "relative m-0 w-full overflow-hidden rounded-xs",
    ratio === "1 / 1" && "aspect-square",
    ratio === "3 / 4" && "aspect-3/4",
    ratio === "4 / 3" && "aspect-4/3",
    ratio === "16 / 10" && "aspect-16/10",
    ratio === "9 / 16" && "aspect-9/16",
    className,
  ]}
>
  <img
    src={image.src}
    alt={image.alt}
    width={image.width}
    height={image.height}
    loading="lazy"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover grayscale contrast-125"
  />
  <figcaption
    class="absolute inset-x-0 bottom-0 flex items-center gap-1 bg-gradient-to-t from-black/60 to-transparent px-3 py-2 font-mono text-[0.65rem] tracking-wide text-white uppercase"
  >
    Foto:
    <a
      href={image.authorUrl}
      rel="noopener"
      target="_blank"
      class="underline underline-offset-2">{image.author}</a
    >
    ·
    <a
      href={image.unsplashUrl}
      rel="noopener"
      target="_blank"
      class="underline underline-offset-2">Unsplash</a
    >
  </figcaption>
</figure>
