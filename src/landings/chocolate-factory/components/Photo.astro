---
// Real photography sourced from Unsplash via the `unsplash-images` Skill.
// Renders the persisted, hotlinked `images.unsplash.com` URL with the
// landing's monochrome treatment. Credit is a discreet caption below the
// photo (never overlaid on top of it) plus a `title` tooltip on the image
// itself — see src/landings/chocolate-factory/data/images.ts for the source
// metadata, and the consolidated "Photo credits" list in Footer.astro.
import type { UnsplashImage } from "../types"

type PhotoRatio = "1 / 1" | "3 / 4" | "4 / 3" | "16 / 10" | "9 / 16"

export interface Props {
  image: UnsplashImage
  ratio?: PhotoRatio
  /** Applied to the outer <figure> — layout/position (e.g. `reveal`, `sticky`, width). */
  class?: string
  /** Whether the image itself keeps this landing's near-square `rounded-xs`
   * corner treatment. Set to `false` for cards whose own container is
   * already square-edged, so the photo doesn't visually mismatch it. */
  rounded?: boolean
}

const { image, ratio = "4 / 3", class: className, rounded = true } = Astro.props
---

<figure class:list={["m-0 w-full", className]}>
  <div
    class:list={[
      "w-full overflow-hidden",
      rounded && "rounded-xs",
      ratio === "1 / 1" && "aspect-square",
      ratio === "3 / 4" && "aspect-3/4",
      ratio === "4 / 3" && "aspect-4/3",
      ratio === "16 / 10" && "aspect-16/10",
      ratio === "9 / 16" && "aspect-9/16",
    ]}
  >
    <img
      src={image.src}
      alt={image.alt}
      title={`Photo by ${image.author} on Unsplash`}
      width={image.width}
      height={image.height}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover photo-tone"
    />
  </div>
  <figcaption
    class="mt-2 font-mono text-[0.65rem] tracking-wide text-muted uppercase"
  >
    Photo:
    <a
      href={image.authorUrl}
      rel="noopener"
      target="_blank"
      class="underline underline-offset-2">{image.author}</a
    >
    ·
    <a
      href={image.unsplashUrl}
      rel="noopener"
      target="_blank"
      class="underline underline-offset-2">Unsplash</a
    >
  </figcaption>
</figure>
