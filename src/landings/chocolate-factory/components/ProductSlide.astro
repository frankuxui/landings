---
import Photo from "./Photo.astro"
import type { Product } from "../types"

export interface Props {
  product: Product
  index: number
}

const { product, index } = Astro.props
const position = String(index + 1).padStart(2, "0")
---

<article class="reveal flex h-full flex-col bg-surface">
  <div class="relative">
    <Photo image={product.image} ratio="3 / 4" rounded={false} />
    <span
      class="absolute top-3 left-3 bg-background-alt px-2 py-1 font-mono text-xs font-semibold text-foreground"
      aria-hidden="true"
    >
      No. {position}
    </span>
  </div>
  <div class="flex h-full flex-col gap-3 p-5 xl:p-6">
    <div class="flex items-baseline justify-between gap-3">
      <h3
        class="text-balance text-headline-3 leading-tight font-semibold text-foreground"
      >
        {product.name}
      </h3>
      <span class="shrink-0 font-mono text-xs text-muted"
        >{product.cacaoContent}</span
      >
    </div>
    <p class="text-sm text-muted xl:text-base">{product.description}</p>
    <ul
      class="mt-auto flex flex-wrap gap-2 pt-4"
      aria-label={`Notes for ${product.name}`}
    >
      {
        product.notes.map((note: string) => (
          <li class="bg-surface-strong px-3 py-1 text-xs font-semibold text-foreground">
            {note}
          </li>
        ))
      }
    </ul>
    <p
      class="relative pt-3 text-xs text-muted before:absolute before:top-0 before:left-0 before:h-px before:w-full before:bg-current/12 before:content-['']"
    >
      {product.format}
    </p>
  </div>
</article>
