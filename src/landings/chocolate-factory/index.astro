---
// Fundición Ónix - root document for this landing.
// Fully self-contained: no platform Layout, no platform CSS/components.
// Rendered in isolation by src/pages/landings/[slug]/render.astro.
import "./styles/tailwind.css"

import Header from "./sections/Header.astro"
import Hero from "./sections/Hero.astro"
import Origin from "./sections/Origin.astro"
import Factory from "./sections/Factory.astro"
import Process from "./sections/Process.astro"
import Products from "./sections/Products.astro"
import Editorial from "./sections/Editorial.astro"
import Distribution from "./sections/Distribution.astro"
import CTAFinal from "./sections/CTAFinal.astro"
import Contact from "./sections/Contact.astro"
import Footer from "./sections/Footer.astro"

const pageTitle = "Fundición Ónix - Chocolate de precisión, de fábrica"
const pageDescription =
  "Fundición Ónix selecciona, tuesta, refina, conchea y templa su propio chocolate en Vado de Ceniza. Descubre la colección o trabaja con nosotros como tienda, restauración, hotel o distribuidor."
const canonicalUrl = "/landings/chocolate-factory"
const thumbnailUrl = "/landings/chocolate-factory/cover.png"
---

<!doctype html>
<html
  lang="es"
  class="scroll-smooth overflow-x-clip scheme-light motion-reduce:scroll-auto dark:scheme-dark font-sans"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Shared Landing Pages typeface — Wix Madefor Text (Google Fonts).
    Every landing loads the exact same weights/styles here; never via
    @import in CSS, and never a different family. See "Shared typography"
    in the astro-landing-pages Skill. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Wix+Madefor+Text:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />

    <!-- This document is only ever embedded as the preview iframe's render
    target (/landings/chocolate-factory/render). The indexable, canonical
    page for this landing is the platform's own detail page. -->
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="noindex" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={thumbnailUrl} />
    <meta property="og:url" content={canonicalUrl} />
  </head>
  <body
    class="min-h-full overflow-x-hidden bg-background text-base leading-relaxed text-foreground antialiased font-sans"
  >
    <a
      class="absolute -top-full left-4 z-1000 inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-sm border-0 bg-primary px-5 py-3 text-base font-semibold text-primary-foreground no-underline transition duration-200 ease-landing focus-visible:top-4 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border hover:bg-emphasis active:bg-emphasis"
      href="#main-content"
    >
      Saltar al contenido principal
    </a>

    <Header />

    <main id="main-content">
      <Hero />
      <Origin />
      <Factory />
      <Process />
      <Products />
      <Editorial />
      <Distribution />
      <CTAFinal />
      <Contact />
    </main>

    <Footer />

    <script>
      import "./scripts/theme"
      import "./scripts/reveal"
      import "./scripts/navIndicator"
    </script>
  </body>
</html>
