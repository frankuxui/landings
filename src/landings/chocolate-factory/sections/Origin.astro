---
import Photo from "../components/Photo.astro"
import { originImage } from "../data/images"

interface CacaoVariety {
  name: string
  detail: string
}

const varieties: CacaoVariety[] = [
  {
    name: "Criollo",
    detail: "Aromatic, low-yield, reserved for micro-batches.",
  },
  {
    name: "Trinitario",
    detail: "A balanced hybrid between aroma and yield.",
  },
  { name: "Forastero", detail: "The base of our higher-volume blends." },
]
---

<section
  class="bg-background-alt py-section"
  id="origin"
  aria-labelledby="origin-heading"
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <div
      class="grid gap-16 lg:grid-cols-[1.1fr_0.9fr] lg:items-start xl:gap-24"
    >
      <article class="reveal max-w-copy">
        <p
          class="mb-4 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
        >
          Raw material
        </p>
        <h2
          id="origin-heading"
          class="max-w-heading text-balance text-headline-2 leading-tight font-semibold text-foreground"
        >
          Cacao makes its decisions before it reaches the factory.
        </h2>
        <p class="mt-6 text-base text-muted sm:text-lg">
          We work with cacao beans from fictional origin farms, selected by
          variety, altitude, and fermentation process before they ever enter our
          factory. No batch is blended without knowing where it comes from.
        </p>
        <blockquote
          class="mt-8 border-0 pl-0 text-xl leading-snug font-medium text-foreground italic"
        >
          "We don't roast anonymous cacao: every sack arrives with its own
          origin record, altitude, and harvest date."
        </blockquote>
        <p class="mt-8 text-base text-muted sm:text-lg">
          That discipline in selection is what later lets roasting, conching,
          and tempering reveal each origin's real nuances, instead of masking
          them with added sugar or vanilla.
        </p>

        <dl class="mt-10 flex flex-col gap-6">
          {
            varieties.map((variety: CacaoVariety) => (
              <div class="flex items-baseline gap-6">
                <dt class="w-28 shrink-0 font-mono text-sm font-semibold text-foreground">
                  {variety.name}
                </dt>
                <dd class="m-0 text-sm text-muted sm:text-base">
                  {variety.detail}
                </dd>
              </div>
            ))
          }
        </dl>
      </article>

      <Photo
        image={originImage}
        ratio="3 / 4"
        class="reveal lg:sticky lg:top-28"
      />
    </div>
  </div>
</section>
