---
import { FileDown } from "@lucide/astro"
import SegmentRow from "../components/SegmentRow.astro"
import { segments } from "../data/segments"
import type { Segment } from "../types"
---

<section
  class="bg-background-alt py-section"
  id="distribucion"
  aria-labelledby="distribucion-heading"
>
  <div
    class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14 grid gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:items-start xl:gap-20"
  >
    <div class="reveal max-w-heading lg:sticky lg:top-28">
      <p
        class="mb-4 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
      >
        Distribución
      </p>
      <h2
        id="distribucion-heading"
        class="text-balance text-headline-2 leading-tight font-semibold text-foreground"
      >
        Fábrica abierta a profesionales.
      </h2>
      <p class="mt-5 text-base text-muted sm:text-lg">
        Trabajamos condiciones específicas según volumen, frecuencia y tipo de
        negocio. Estos son los perfiles con los que colaboramos hoy.
      </p>
      <a
        class="mt-8 inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-sm border-0 bg-control px-5 py-2.5 text-sm font-semibold text-foreground no-underline transition duration-200 ease-landing hover:bg-control-hover focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-control-hover"
        href="#contacto"
      >
        Descargar dossier
        <FileDown
          aria-hidden="true"
          width="16"
          height="16"
          stroke-width="1.5"
        />
      </a>
    </div>

    <ul class="reveal flex flex-col">
      {segments.map((segment: Segment) => <SegmentRow segment={segment} />)}
    </ul>
  </div>
</section>
