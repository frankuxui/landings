---
import { FileDown } from "@lucide/astro"
import SegmentRow from "../components/SegmentRow.astro"
import { segments } from "../data/segments"
import type { Segment } from "../types"
---

<section
  class="bg-background-alt palette-surface-light py-section transition-colors duration-400 ease-landing"
  id="distribution"
  aria-labelledby="distribution-heading"
>
  <div
    class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14 grid gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:items-start xl:gap-20"
  >
    <div class="reveal lg:sticky lg:top-28">
      <p
        class="mb-4 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
      >
        Distribution
      </p>
      <h2
        id="distribution-heading"
        class="max-w-heading text-balance text-headline-2 leading-tight font-semibold text-foreground"
      >
        A factory open to professionals.
      </h2>
      <p class="mt-5 max-w-copy text-base text-muted sm:text-lg">
        We work out specific terms based on volume, frequency, and business
        type. These are the profiles we partner with today.
      </p>
      <a
        class="palette-control mt-8 inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-sm border-0 bg-foreground px-5 py-2.5 text-sm font-semibold text-background no-underline transition duration-200 ease-landing hover:bg-foreground/90 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-foreground/90"
        href="#contact"
      >
        Download dossier
        <FileDown
          aria-hidden="true"
          width="16"
          height="16"
          stroke-width="1.5"
        />
      </a>
    </div>

    <ul class="reveal flex flex-col">
      {segments.map((segment: Segment) => <SegmentRow segment={segment} />)}
    </ul>
  </div>
</section>
