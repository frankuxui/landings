---
import { ArrowRight, Mail } from "@lucide/astro"
---

<section
  class="bg-inverted palette-surface-primary text-inverted-foreground transition-colors duration-400 ease-landing"
  aria-labelledby="cta-final-heading"
>
  <div
    class="mx-auto w-full max-w-landing px-container-x py-section sm:px-8 xl:px-14 grid gap-10 lg:grid-cols-[1.3fr_0.7fr] lg:items-end xl:gap-16"
  >
    <h2
      id="cta-final-heading"
      class="max-w-heading text-balance text-headline-2 leading-[1.05] font-semibold text-current"
    >
      Exact chocolate, made at the scale you need.
    </h2>
    <div class="flex flex-col items-start gap-4 lg:items-end">
      <p class="text-current/75 lg:text-right">
        From the shelf bar to factory orders for restaurants or distribution.
      </p>
      <div class="flex flex-wrap gap-4 lg:justify-end">
        <a
          class="inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-sm border-0 bg-inverted-foreground px-6 py-3 text-base font-semibold text-inverted no-underline transition duration-200 ease-landing hover:opacity-90 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-current active:opacity-80"
          href="#products"
        >
          Request catalog
          <ArrowRight
            aria-hidden="true"
            width="18"
            height="18"
            stroke-width="1.5"
          />
        </a>
        <a
          class="inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-sm border-0 bg-current/10 px-6 py-3 text-base font-semibold text-current no-underline transition duration-200 ease-landing hover:bg-current/15 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-current active:bg-current/20"
          href="#contact"
        >
          Talk to sales
          <Mail aria-hidden="true" width="18" height="18" stroke-width="1.5" />
        </a>
      </div>
    </div>
  </div>
</section>
