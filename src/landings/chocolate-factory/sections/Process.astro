---
import ProcessStepCard from "../components/ProcessStepCard.astro"
import { processSteps } from "../data/process"
import type { ProcessStep } from "../types"
---

<section
  class="bg-background py-section"
  id="process"
  aria-labelledby="process-heading"
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <div class="mb-12 flex flex-col gap-5 sm:mb-16">
      <p
        class="font-mono text-xs font-semibold tracking-widest text-muted uppercase"
      >
        Eight stages, one workshop
      </p>
      <h2
        id="process-heading"
        class="max-w-heading text-balance text-headline-2 leading-tight font-semibold text-foreground"
      >
        From selected bean to finished piece.
      </h2>
      <p class="max-w-copy text-base text-muted sm:text-lg">
        On wide screens, the section pins in place as you scroll: keep scrolling
        down to move through the eight stages horizontally. On Mobile and
        Tablet, swipe the row with your finger.
      </p>
    </div>
  </div>

  <div data-process-pin class="relative">
    <div
      class="process-rail overflow-x-auto px-container-x pb-2 sm:px-8 lg:px-14"
      data-process-scroll
    >
      <ol
        class="flex w-max snap-x snap-mandatory gap-4 xl:gap-6"
        data-process-list
        aria-label="Production process stages"
      >
        {
          processSteps.map((step: ProcessStep) => (
            <ProcessStepCard step={step} />
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import "../scripts/processScroll"
</script>
