---
import Photo from "../components/Photo.astro"
import StatFigure from "../components/StatFigure.astro"
import { productionStats } from "../data/stats"
import { factoryArtisanImage, factoryIndustrialImage } from "../data/images"
import type { ProductionStat } from "../types"
---

<section
  class="bg-inverted text-inverted-foreground"
  id="fabrica"
  aria-labelledby="fabrica-heading"
>
  <div
    class="mx-auto w-full max-w-landing px-container-x py-section sm:px-8 xl:px-14"
  >
    <div class="mb-16 max-w-heading">
      <p
        class="mb-4 font-mono text-xs font-semibold tracking-widest text-current/70 uppercase"
      >
        La fábrica
      </p>
      <h2
        id="fabrica-heading"
        class="text-balance text-headline-2 leading-tight font-semibold text-current"
      >
        Artesanía a escala industrial.
      </h2>
    </div>

    <div class="grid gap-10 md:grid-cols-2 xl:gap-16">
      <div class="reveal flex flex-col gap-5">
        <Photo image={factoryArtisanImage} ratio="4 / 3" />
        <h3 class="text-headline-3 font-semibold text-current">Lo artesanal</h3>
        <p class="text-current/75">
          Catadores, control visual pieza a pieza y ajustes de receta que solo
          un oficio con años de práctica puede hacer con criterio.
        </p>
      </div>
      <div class="reveal flex flex-col gap-5">
        <Photo image={factoryIndustrialImage} ratio="4 / 3" />
        <h3 class="text-headline-3 font-semibold text-current">
          Lo industrial
        </h3>
        <p class="text-current/75">
          Líneas de refinado, conchado y moldeado con control de temperatura
          constante, para que cada lote se repita sin perder carácter.
        </p>
      </div>
    </div>

    <div
      class="reveal mt-20 grid grid-cols-2 gap-x-6 gap-y-10 sm:mt-24 sm:grid-cols-4 sm:gap-x-0"
      data-stats-row
    >
      {
        productionStats.map((stat: ProductionStat, index: number) => (
          <StatFigure
            stat={stat}
            isLast={index === productionStats.length - 1}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import "../scripts/statsCounter"
</script>
