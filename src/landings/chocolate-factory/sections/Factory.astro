---
import Photo from "../components/Photo.astro"
import StatFigure from "../components/StatFigure.astro"
import { productionStats } from "../data/stats"
import { factoryArtisanImage, factoryIndustrialImage } from "../data/images"
import type { ProductionStat } from "../types"
---

<section
  class="bg-inverted palette-surface-primary text-inverted-foreground transition-colors duration-400 ease-landing"
  id="factory"
  aria-labelledby="factory-heading"
>
  <div
    class="mx-auto w-full max-w-landing px-container-x py-section sm:px-8 xl:px-14"
  >
    <div class="mb-16">
      <p
        class="mb-4 font-mono text-xs font-semibold tracking-widest text-current/70 uppercase"
      >
        The factory
      </p>
      <h2
        id="factory-heading"
        class="max-w-heading text-balance text-headline-2 leading-tight font-semibold text-current"
      >
        Craftsmanship at industrial scale.
      </h2>
    </div>

    <div class="grid gap-10 md:grid-cols-2 xl:gap-16">
      <div class="reveal flex flex-col gap-5">
        <Photo image={factoryArtisanImage} ratio="4 / 3" />
        <h3 class="text-headline-3 font-semibold text-current">The craft</h3>
        <p class="text-current/75">
          Tasters, piece-by-piece visual control, and recipe adjustments that
          only years of practice can make with judgment.
        </p>
      </div>
      <div class="reveal flex flex-col gap-5">
        <Photo image={factoryIndustrialImage} ratio="4 / 3" />
        <h3 class="text-headline-3 font-semibold text-current">The industry</h3>
        <p class="text-current/75">
          Refining, conching, and molding lines with constant temperature
          control, so every batch repeats without losing character.
        </p>
      </div>
    </div>

    <div
      class="reveal mt-20 grid grid-cols-2 gap-x-6 gap-y-10 sm:mt-24 sm:grid-cols-4 sm:gap-x-0"
      data-stats-row
    >
      {
        productionStats.map((stat: ProductionStat, index: number) => (
          <StatFigure
            stat={stat}
            isLast={index === productionStats.length - 1}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import "../scripts/statsCounter"
</script>
