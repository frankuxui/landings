---
// Terraltura - root document for this landing.
// Fully self-contained: no platform Layout, no platform CSS/components.
// Rendered in isolation by src/pages/landings/[slug]/render.astro.
import "./styles/tailwind.css"

import Header from "./sections/Header.astro"
import Hero from "./sections/Hero.astro"
import About from "./sections/About.astro"
import OurCoffee from "./sections/OurCoffee.astro"
import Process from "./sections/Process.astro"
import Products from "./sections/Products.astro"
import Values from "./sections/Values.astro"
import Stats from "./sections/Stats.astro"
import Testimonials from "./sections/Testimonials.astro"
import CTAFinal from "./sections/CTAFinal.astro"
import Contact from "./sections/Contact.astro"
import Footer from "./sections/Footer.astro"

const pageTitle = "Terraltura - Café de origen cultivado en altura"
const pageDescription =
  "Terraltura cultiva, selecciona y tuesta café de especialidad en los Altos de Vientoclaro. Descubre nuestras variedades y trabaja con nosotros como cafetería, restaurante o distribuidor."
const canonicalUrl = "/landings/coffee-producer"
const thumbnailUrl =
  "https://images.unsplash.com/photo-1672851612794-6687bf0bf1a3?ixid=M3wxMDQwNDk5fDB8MXxzZWFyY2h8M3x8Y29mZmVlJTIwY2hlcnJpZXMlMjBicmFuY2glMjBwbGFudCUyMGNsb3NldXB8ZW58MXwwfHx8MTc4NzQ3NTcwNHww&ixlib=rb-4.1.0&w=1200&auto=format&fit=crop&q=80"
---

<!doctype html>
<html
  lang="es"
  class="scroll-smooth overflow-x-clip scheme-light motion-reduce:scroll-auto dark:scheme-dark font-sans"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Shared Landing Pages typeface — Wix Madefor Text (Google Fonts).
    Every landing loads the exact same weights/styles here; never via
    @import in CSS, and never a different family. See "Shared typography"
    in the astro-landing-pages Skill. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Wix+Madefor+Text:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />

    <!-- This document is only ever embedded as the preview iframe's render
    target (/landings/coffee-producer/render). The indexable, canonical page
    for this landing is the platform's own detail page. -->
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="noindex" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={thumbnailUrl} />
    <meta property="og:url" content={canonicalUrl} />
  </head>
  <body
    class="min-h-full overflow-x-hidden bg-background text-base leading-relaxed text-foreground antialiased font-sans"
  >
    <a
      class="absolute -top-full left-4 z-1000 inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-md px-5 py-3 text-base font-semibold no-underline transition duration-200 ease-landing focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border border-0 bg-primary text-primary-foreground hover:bg-emphasis active:bg-emphasis focus-visible:top-4"
      href="#main-content"
    >
      Saltar al contenido principal
    </a>

    <Header />

    <main id="main-content">
      <Hero />
      <About />
      <OurCoffee />
      <Process />
      <Products />
      <Values />
      <Stats />
      <Testimonials />
      <CTAFinal />
      <Contact />
    </main>

    <Footer />

    <script>
      import "./scripts/theme"
      import "./scripts/reveal"
      import "./scripts/navIndicator"
    </script>
  </body>
</html>
