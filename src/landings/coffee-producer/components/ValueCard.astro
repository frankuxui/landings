---
import {
  MapPin,
  Leaf,
  Award,
  ScanSearch,
  Recycle,
  Handshake,
} from "@lucide/astro"
import type { ValueItem } from "../types"

export interface Props {
  value: ValueItem
  index: number
}

const { value, index } = Astro.props

const icons = [MapPin, Leaf, Award, ScanSearch, Recycle, Handshake]
const Icon = icons[index % icons.length]
---

<li class="reveal flex h-full flex-col gap-4 rounded-2xl bg-surface p-6 xl:p-8">
  <Icon class="size-8 text-foreground" aria-hidden="true" stroke-width="1.5" />
  <h3
    class="text-balance text-headline-3 leading-tight font-semibold text-foreground"
  >
    {value.title}
  </h3>
  <p class="text-muted display:text-lg">
    {value.description}
  </p>
</li>
