---
import Photo from "../components/Photo.astro"
import { aboutImage } from "../data/images"
---

<section
  class="bg-background-alt palette-surface-light py-section"
  id="about"
  aria-labelledby="about-heading"
>
  <div
    class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14 grid items-center gap-16 nav:grid-cols-[0.72fr_1.28fr] xl:gap-24"
  >
    <Photo image={aboutImage} ratio="3 / 4" class="reveal" />

    <div class="reveal">
      <div class="mb-0 max-w-5xl">
        <p
          class="mb-4 inline-block font-sans text-sm font-semibold tracking-widest text-muted uppercase"
        >
          Our story
        </p>
        <h2
          id="about-heading"
          class="text-balance text-headline-2 leading-tight font-semibold text-foreground"
        >
          Three generations growing the same hillside.
        </h2>
        <p class="mt-5 text-base text-muted sm:text-lg">
          Coffee Producer was founded in 1994, when a family of growers decided
          to stop selling their harvest to middlemen and start roasting their
          own coffee in the Altos de Vientoclaro. Thirty years later, we still
          farm the same mountain plots, now alongside twelve neighboring farms
          that share our way of understanding coffee.
        </p>
      </div>
      <p class="mt-7 text-lg text-muted">
        We don't chase volume: we chase a clear story of farm, altitude, and
        process in every lot. We believe an exceptional coffee begins long
        before roasting — it begins in the soil, in the shade of the trees, and
        in the hands that pick every cherry.
      </p>
    </div>
  </div>
</section>
