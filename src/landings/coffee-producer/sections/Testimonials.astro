---
import TestimonialCard from "../components/TestimonialCard.astro"
import { testimonials } from "../data/testimonials"
import type { Testimonial } from "../types"
---

<section
  class="bg-background-alt palette-surface-light py-section"
  aria-labelledby="testimonials-heading"
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <div class="mb-16 max-w-5xl">
      <p
        class="mb-4 inline-block font-sans text-sm font-semibold tracking-widest text-muted uppercase"
      >
        Trusted by
      </p>
      <h2
        id="testimonials-heading"
        class="max-w-heading text-balance text-headline-2 leading-tight font-semibold text-foreground"
      >
        Cafés, restaurants, and homes already savoring it.
      </h2>
    </div>

    <div
      class="grid grid-cols-1 gap-6 cards:grid-cols-2 display:grid-cols-4 xl:gap-8"
    >
      {
        testimonials.map((testimonial: Testimonial) => (
          <TestimonialCard testimonial={testimonial} />
        ))
      }
    </div>
  </div>
</section>
