---
import StatItem from "../components/StatItem.astro"
import { stats } from "../data/stats"
import type { Stat } from "../types"
---

<section
  class="bg-inverted py-16 text-inverted-foreground"
  id="estadisticas"
  aria-labelledby="estadisticas-heading"
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <h2 id="estadisticas-heading" class="sr-only text-balance">
      Terraltura en cifras
    </h2>
    <div
      class="grid grid-cols-2 gap-4 min-[700px]:grid-cols-3 stats:grid-cols-6 xl:gap-6"
      data-stats-grid
    >
      {stats.map((stat: Stat) => <StatItem stat={stat} />)}
    </div>
  </div>
</section>

<script>
  import "../scripts/statsCounter"
</script>
