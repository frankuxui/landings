---
import { ArrowRight, Compass } from "@lucide/astro"
import Photo from "../components/Photo.astro"
import { heroImage } from "../data/images"
---

<section
  class="bg-background py-20 sm:py-section"
  id="home"
  aria-label="Introduction"
>
  <div
    class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14 grid items-center gap-16 lg:grid-cols-[1.18fr_0.82fr] xl:gap-24"
  >
    <div>
      <p
        class="mb-4 inline-block font-sans text-sm font-semibold tracking-widest text-muted uppercase"
      >
        Single-origin coffee · Altos de Vientoclaro
      </p>
      <h1
        class="max-w-hero-heading text-balance text-headline-1 leading-none font-bold text-foreground"
      >
        Highland coffee, grown with purpose.
      </h1>
      <p
        class="mt-7 max-w-[60ch] text-lg text-muted sm:text-xl display:text-2xl"
      >
        Coffee Producer grows, selects, and roasts specialty coffee on mountain
        farms, following every bean from the plot to the cup of cafés,
        restaurants, and homes that value where their coffee comes from.
      </p>
      <div class="mt-12 flex flex-wrap gap-4">
        <a
          class="inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-full px-6 py-3 text-base font-semibold no-underline transition duration-200 ease-landing focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border border-0 bg-primary text-primary-foreground hover:bg-emphasis active:bg-emphasis"
          href="#products"
        >
          Discover our coffee
          <ArrowRight
            aria-hidden="true"
            width="18"
            height="18"
            stroke-width="1.5"
          />
        </a>
        <a
          class="inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-full px-6 py-3 text-base font-semibold no-underline transition duration-200 ease-landing focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border border-0 bg-control text-foreground hover:bg-control-hover active:bg-control-hover"
          href="#process"
        >
          See our process
          <Compass
            aria-hidden="true"
            width="18"
            height="18"
            stroke-width="1.5"
          />
        </a>
      </div>
    </div>

    <Photo image={heroImage} ratio="4 / 5" />
  </div>
</section>
