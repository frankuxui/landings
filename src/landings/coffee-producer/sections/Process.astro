---
import ProcessStepCard from "../components/ProcessStepCard.astro"
import { processSteps } from "../data/process"
import type { ProcessStep } from "../types"
---

<section
  class="bg-background py-section"
  id="process"
  aria-labelledby="process-heading"
>
  <div
    class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14 grid gap-12 lg:grid-cols-[0.78fr_1.22fr] lg:items-start xl:gap-20"
  >
    <div class="mb-0 max-w-5xl lg:sticky lg:top-28">
      <p
        class="mb-4 inline-block font-sans text-sm font-semibold tracking-widest text-muted uppercase"
      >
        From crop to cup
      </p>
      <h2
        id="process-heading"
        class="max-w-heading text-balance text-headline-2 leading-tight font-semibold text-foreground"
      >
        Six stages, the same standard.
      </h2>
      <p class="mt-5 text-base text-muted sm:text-lg">
        No step is skipped or rushed. This is how a coffee cherry becomes, weeks
        later, a cup with a character of its own.
      </p>
    </div>

    <ol class="grid gap-4 footer:grid-cols-2 xl:gap-5">
      {processSteps.map((step: ProcessStep) => <ProcessStepCard step={step} />)}
    </ol>
  </div>
</section>
