---
import { MapPin, Leaf, Hand, Flame, Wind, Smile } from "@lucide/astro"

interface CoffeeAttribute {
  term: string
  detail: string
  icon: typeof MapPin
}

const attributes: CoffeeAttribute[] = [
  {
    term: "Origin",
    detail: "Altos de Vientoclaro, 1,400–2,100 m above sea level",
    icon: MapPin,
  },
  { term: "Variety", detail: "Typica, Bourbon, and Caturra", icon: Leaf },
  {
    term: "Selection",
    detail: "Cherries hand-picked at their peak ripeness",
    icon: Hand,
  },
  {
    term: "Roast",
    detail: "Small batches, hand-crafted, in our own roastery",
    icon: Flame,
  },
  {
    term: "Aroma",
    detail: "Floral, with toasted cacao and seasonal fruit notes",
    icon: Wind,
  },
  {
    term: "Flavor",
    detail: "Medium body, bright acidity, sweet finish",
    icon: Smile,
  },
]
---

<section
  class="bg-inverted py-section text-inverted-foreground"
  id="our-coffee"
  aria-labelledby="our-coffee-heading"
>
  <div
    class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14 grid gap-16 lg:grid-cols-[0.82fr_1.18fr] lg:items-start xl:gap-24"
  >
    <div class="reveal lg:sticky lg:top-28">
      <div class="mb-0 max-w-5xl">
        <p
          class="mb-4 inline-block font-sans text-sm font-semibold tracking-widest text-current uppercase opacity-85"
        >
          Our coffee
        </p>
        <h2
          id="our-coffee-heading"
          class="max-w-heading text-balance text-headline-2 leading-tight font-semibold text-current"
        >
          A character you recognize from the first cup.
        </h2>
      </div>
      <p class="mt-5 text-base text-current/80 sm:text-lg">
        Every bag of Coffee Producer starts from the same commitment: grow at
        altitude, select with judgment, and roast without rushing. The result is
        a specialty coffee with its own identity, made for those who brew it at
        home and those who pour it behind a bar every day.
      </p>
    </div>

    <dl class="reveal flex flex-col gap-3">
      {
        attributes.map((attribute: CoffeeAttribute, index: number) => {
          const Icon = attribute.icon
          return (
            <div
              class:list={[
                "grid grid-cols-[10rem_1fr] gap-6 rounded-md p-5 display:grid-cols-[12rem_1fr]",
                index % 2 === 0 && "bg-current/7",
              ]}
            >
              <dt class="flex items-center gap-4 text-lg sm:text-xl">
                <span class="inline-flex items-center justify-center rounded-full bg-current/10 text-current size-10">
                  <Icon size={20} class="shrink-0" />
                </span>
                {attribute.term}
              </dt>
              <dd class="flex items-center justify-start m-0 text-sm text-current/80 sm:text-base">
                {attribute.detail}
              </dd>
            </div>
          )
        })
      }
    </dl>
  </div>
</section>
