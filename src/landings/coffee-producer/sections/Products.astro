---
import { ChevronLeft, ChevronRight } from "@lucide/astro"
import ProductCard from "../components/ProductCard.astro"
import { products } from "../data/products"
import type { Product } from "../types"
---

<section
  class="bg-background-alt py-section"
  id="products"
  aria-labelledby="products-heading"
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <div
      class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
    >
      <div class="mb-0 max-w-5xl max-w-2xl">
        <p
          class="mb-4 inline-block font-sans text-sm font-semibold tracking-widest text-muted uppercase"
        >
          Products
        </p>
        <h2
          id="products-heading"
          class="max-w-heading text-balance text-headline-2 leading-tight font-semibold text-foreground"
        >
          Four coffees, four ways to tell the story of origin.
        </h2>
        <p class="mt-5 text-base text-muted sm:text-lg">
          Our range stays deliberately short: every product has a reason to
          exist, from the single origin grown on our highest plots to the
          classic we brew every morning at home.
        </p>
      </div>

      <div class="flex shrink-0 items-center gap-3">
        <button
          type="button"
          class="inline-flex size-11 min-h-11 shrink-0 cursor-pointer items-center justify-center rounded-full border-0 bg-control p-0 text-foreground transition duration-200 ease-landing hover:bg-control-hover focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-control-hover"
          data-products-prev
          aria-label="Previous product"
        >
          <ChevronLeft
            aria-hidden="true"
            width="20"
            height="20"
            stroke-width="1.5"
          />
        </button>
        <button
          type="button"
          class="inline-flex size-11 min-h-11 shrink-0 cursor-pointer items-center justify-center rounded-full border-0 bg-control p-0 text-foreground transition duration-200 ease-landing hover:bg-control-hover focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-control-hover"
          data-products-next
          aria-label="Next product"
        >
          <ChevronRight
            aria-hidden="true"
            width="20"
            height="20"
            stroke-width="1.5"
          />
        </button>
      </div>
    </div>

    <div
      class="products-slider swiper"
      data-products-slider
      aria-label="Products carousel"
      role="region"
    >
      <div class="swiper-wrapper">
        {
          products.map((product: Product) => (
            <div class="swiper-slide h-auto">
              <ProductCard product={product} />
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="products-slider-pagination mt-8 flex justify-center"
      data-products-pagination
    >
    </div>
  </div>
</section>

<script>
  import "../scripts/productsSlider"
</script>
