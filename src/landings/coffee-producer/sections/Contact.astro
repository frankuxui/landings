---
import { MapPin, Phone, Mail, Clock } from "@lucide/astro"
---

<section
  class="bg-background-alt py-section"
  id="contact"
  aria-labelledby="contact-heading"
>
  <div
    class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14 grid gap-16 lg:grid-cols-[0.9fr_1.1fr] lg:items-start xl:gap-24"
  >
    <div class="reveal">
      <div class="mb-0 max-w-5xl">
        <p
          class="mb-4 inline-block font-sans text-sm font-semibold tracking-widest text-muted uppercase"
        >
          Contact
        </p>
        <h2
          id="contact-heading"
          class="max-w-heading text-balance text-headline-2 leading-tight font-semibold text-foreground"
        >
          Let's talk about your next cup.
        </h2>
        <p class="mt-5 text-base text-muted sm:text-lg">
          Whether you're a café looking for a new origin, a distributor, or you
          simply want to ask about our varieties, we reply within 48 business
          hours.
        </p>
      </div>

      <address class="mt-12 grid gap-4 not-italic min-[1200px]:grid-cols-2">
        <p class="flex items-center gap-3">
          <MapPin
            class="shrink-0"
            aria-hidden="true"
            width="20"
            height="20"
            stroke-width="1.5"
          />
          <span>Example Address, City, Country</span>
        </p>
        <p class="flex items-center gap-3">
          <Phone
            class="shrink-0"
            aria-hidden="true"
            width="20"
            height="20"
            stroke-width="1.5"
          />
          <a
            class="underline underline-offset-3 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
            href="tel:+00000000000">+00 000 000 000</a
          >
        </p>
        <p class="flex items-center gap-3">
          <Mail
            class="shrink-0"
            aria-hidden="true"
            width="20"
            height="20"
            stroke-width="1.5"
          />
          <a
            class="underline underline-offset-3 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
            href="mailto:email@example.com">email@example.com</a
          >
        </p>
        <p class="flex items-center gap-3">
          <Clock
            class="shrink-0"
            aria-hidden="true"
            width="20"
            height="20"
            stroke-width="1.5"
          />
          <span>Example hours</span>
        </p>
      </address>
    </div>

    <form
      class="reveal flex flex-col gap-6 rounded-3xl bg-surface p-8 sm:p-10 xl:p-12"
      action="mailto:email@example.com"
      method="post"
      enctype="text/plain"
    >
      <div class="flex flex-col gap-1">
        <label class="text-sm font-semibold" for="contact-name">Name</label>
        <input
          class="h-12 w-full min-w-0 rounded-lg border border-border bg-surface px-4 py-3 text-base text-foreground outline-none placeholder:text-muted focus-pour disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-2 aria-invalid:border-foreground aria-invalid:ring-3 aria-invalid:ring-foreground/20"
          type="text"
          id="contact-name"
          name="name"
          autocomplete="name"
          required
        />
      </div>

      <div class="flex flex-col gap-1">
        <label class="text-sm font-semibold" for="contact-email">Email</label>
        <input
          class="h-12 w-full min-w-0 rounded-lg border border-border bg-surface px-4 py-3 text-base text-foreground outline-none placeholder:text-muted focus-pour disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-2 aria-invalid:border-foreground aria-invalid:ring-3 aria-invalid:ring-foreground/20"
          type="email"
          id="contact-email"
          name="email"
          autocomplete="email"
          inputmode="email"
          required
        />
      </div>

      <div class="flex flex-col gap-1">
        <label class="text-sm font-semibold" for="contact-org"
          >Café, restaurant, or distributor (optional)</label
        >
        <input
          class="h-12 w-full min-w-0 rounded-lg border border-border bg-surface px-4 py-3 text-base text-foreground outline-none placeholder:text-muted focus-pour disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-2 aria-invalid:border-foreground aria-invalid:ring-3 aria-invalid:ring-foreground/20"
          type="text"
          id="contact-org"
          name="organization"
          autocomplete="organization"
        />
      </div>

      <div class="flex flex-col gap-1">
        <label class="text-sm font-semibold" for="contact-message"
          >Message</label
        >
        <textarea
          class="min-h-36 w-full min-w-0 resize-y rounded-lg border border-border bg-surface px-4 py-3 text-base text-foreground outline-none placeholder:text-muted focus-pour disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-2 aria-invalid:border-foreground aria-invalid:ring-3 aria-invalid:ring-foreground/20"
          id="contact-message"
          name="message"
          rows="4"
          required></textarea>
      </div>

      <button
        type="submit"
        class="self-start inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-full px-6 py-3 text-base font-semibold no-underline transition duration-200 ease-landing focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border border-0 bg-(--color-primary) text-(--color-light) hover:opacity-90 active:opacity-90"
      >
        Send message
      </button>
    </form>
  </div>
</section>
