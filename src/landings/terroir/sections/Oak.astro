---
// Terroir — Section 10: Roble
// Barrel section with wood concepts.
import { oakImage } from "../data/images"

interface OakConcept {
  title: string
  description: string
}

const concepts: OakConcept[] = [
  {
    title: "Roble frances",
    description:
      "Grano fino, taninos elegantes. Aporta notas de especias dulces, vainilla sutil y estructura sedosa.",
  },
  {
    title: "Roble americano",
    description:
      "Grano mas abierto, mas poroso. Transfiere vainilla pronunciada, coco y notas lácteas.",
  },
  {
    title: "Tostado",
    description:
      "El interior de la barrica se quema. Tostado ligero, medio o fuerte: cada nivel aporta aromas diferentes.",
  },
  {
    title: "Grano",
    description:
      "La densidad de los anillos del arbol. Grano fino libera taninos lentamente. Grano grueso, mas rapido.",
  },
  {
    title: "Tiempo",
    description:
      "La barrica nueva aporta mas madera. Usada varias veces, se vuelve neutral: solo oxigena.",
  },
]
---

<section
  class="relative overflow-hidden bg-background py-section"
  aria-labelledby="oak-heading"
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Image side -->
      <div class="relative lg:sticky lg:top-24 lg:self-start" data-fade-in>
        <div class="aspect-[3/4] overflow-hidden rounded-sm">
          <img
            src={`${oakImage.src}&w=800&auto=format&fit=crop&q=80`}
            alt={oakImage.alt}
            width={oakImage.width}
            height={oakImage.height}
            loading="lazy"
            decoding="async"
            class="photo-tone h-full w-full object-cover"
          />
        </div>
        <div class="mt-2 text-[10px] text-muted/60">
          Foto de <a
            href={oakImage.authorUrl}
            rel="noopener"
            class="underline hover:text-muted">{oakImage.author}</a
          > en <a
            href={oakImage.unsplashUrl}
            rel="noopener"
            class="underline hover:text-muted">Unsplash</a
          >
        </div>
      </div>

      <!-- Concepts list -->
      <div>
        <div class="mb-10">
          <p
            class="mb-4 text-xs font-medium uppercase tracking-[0.3em] text-muted"
          >
            10 &mdash; Roble
          </p>
          <h2
            id="oak-heading"
            class="max-w-heading font-display text-headline-2 font-extrabold uppercase leading-[0.86] text-foreground"
          >
            La madera que da forma al vino
          </h2>
          <p class="mt-4 max-w-copy text-lg leading-relaxed text-muted">
            La barrica no es un recipiente. Es un instrumento. Aporta vainilla,
            especias, tostado, estructura y microoxigenacion. El tipo de roble y
            el tiempo de crianza definen el perfil del vino.
          </p>
        </div>

        <div class="flex flex-col gap-8">
          {
            concepts.map((concept: OakConcept) => (
              <div class="reveal border-t border-border/20 pt-6" data-fade-in>
                <h3 class="font-display text-headline-3 font-semibold uppercase tracking-wider text-foreground">
                  {concept.title}
                </h3>
                <p class="mt-3 text-base leading-relaxed text-muted">
                  {concept.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
