---
// Terroir — Section 20: La galería
// Twelve-column editorial mosaic with contextual square reveals.
import {
  barrelsImage,
  foodImage,
  grapesImage,
  harvestImage,
  heroImage,
  leavesImage,
  oakImage,
  pouringImage,
} from "../data/images"

interface GalleryPhoto {
  src: string
  alt: string
  width: number
  height: number
  author: string
  authorUrl: string
  unsplashUrl: string
  context: string
  place: string
  slot:
    | "lead"
    | "portrait"
    | "landscape"
    | "tall"
    | "square"
    | "detail"
    | "panorama"
    | "closing"
}

const photos: GalleryPhoto[] = [
  {
    ...heroImage,
    src: `${heroImage.src}&w=1400&auto=format&fit=crop&q=80`,
    context: "El paisaje antes de la copa",
    place: "Viñedo / atardecer",
    slot: "lead",
  },
  {
    ...grapesImage,
    src: `${grapesImage.src}&w=900&auto=format&fit=crop&q=80`,
    context: "La fruta en su límite",
    place: "Vendimia / madurez",
    slot: "portrait",
  },
  {
    ...barrelsImage,
    src: `${barrelsImage.src}&w=1000&auto=format&fit=crop&q=80`,
    context: "Donde el tiempo toma forma",
    place: "Bodega / crianza",
    slot: "landscape",
  },
  {
    ...pouringImage,
    src: `${pouringImage.src}&w=900&auto=format&fit=crop&q=80`,
    context: "El gesto de servir",
    place: "Mesa / ceremonia",
    slot: "tall",
  },
  {
    ...oakImage,
    src: `${oakImage.src}&w=900&auto=format&fit=crop&q=80`,
    context: "La huella del roble",
    place: "Barrica / materia",
    slot: "square",
  },
  {
    ...leavesImage,
    src: `${leavesImage.src}&w=900&auto=format&fit=crop&q=80`,
    context: "La estación escrita en la hoja",
    place: "Vid / otoño",
    slot: "detail",
  },
  {
    ...foodImage,
    src: `${foodImage.src}&w=1200&auto=format&fit=crop&q=80`,
    context: "El vino encuentra la mesa",
    place: "Maridaje / cocina",
    slot: "panorama",
  },
  {
    ...harvestImage,
    src: `${harvestImage.src}&w=1000&auto=format&fit=crop&q=80`,
    context: "Las manos de la cosecha",
    place: "Vendimia / oficio",
    slot: "closing",
  },
]
---

<section
  class="relative overflow-hidden bg-background-alt py-section"
  aria-labelledby="gallery-heading"
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <div class="mb-14 grid gap-8 lg:grid-cols-12 lg:items-end" data-fade-in>
      <div class="lg:col-span-8">
        <p
          class="mb-4 text-xs font-medium uppercase tracking-[0.3em] text-muted"
        >
          20 &mdash; La galería
        </p>
        <h2
          id="gallery-heading"
          class="max-w-heading font-display text-headline-2 font-extrabold uppercase leading-[0.86] text-foreground"
        >
          Fragmentos del viñedo a la mesa
        </h2>
      </div>
      <p class="max-w-copy text-lg leading-relaxed text-muted lg:col-span-4">
        Ocho instantes de una misma cultura: paisaje, materia, trabajo, espera y
        conversación.
      </p>
    </div>

    <div class="gallery-collage">
      {
        photos.map((photo: GalleryPhoto, index: number) => (
          <figure
            class:list={[
              "gallery-item group reveal min-w-0",
              photo.slot === "lead" && "gallery-cell-lead",
              photo.slot === "portrait" && "gallery-cell-portrait",
              photo.slot === "landscape" && "gallery-cell-landscape",
              photo.slot === "tall" && "gallery-cell-tall",
              photo.slot === "square" && "gallery-cell-square",
              photo.slot === "detail" && "gallery-cell-detail",
              photo.slot === "panorama" && "gallery-cell-panorama",
              photo.slot === "closing" && "gallery-cell-closing",
            ]}
            data-fade-in
          >
            <div class="gallery-media photo-editorial-hover relative min-h-0 overflow-hidden bg-placeholder">
              <img
                src={photo.src}
                alt={photo.alt}
                title={`Foto de ${photo.author} en Unsplash`}
                width={photo.width}
                height={photo.height}
                loading="lazy"
                decoding="async"
                class="photo-tone h-full w-full object-cover"
              />
              <div class="gallery-context absolute bottom-4 left-4 flex aspect-square w-32 flex-col justify-between bg-neutral-950 p-4 text-neutral-50 sm:w-36">
                <p class="text-xs font-bold uppercase tracking-widest opacity-55">
                  {String(index + 1).padStart(2, "0")}
                </p>
                <div>
                  <p class="font-display text-lg font-extrabold leading-tight">
                    {photo.context}
                  </p>
                  <p class="mt-2 text-xs uppercase tracking-widest opacity-55">
                    {photo.place}
                  </p>
                </div>
              </div>
            </div>
            <figcaption class="flex min-h-9 items-center gap-1 py-2 text-xs text-muted/60">
              Foto de{" "}
              <a
                href={photo.authorUrl}
                rel="noopener"
                class="underline hover:text-muted"
              >
                {photo.author}
              </a>{" "}
              en{" "}
              <a
                href={photo.unsplashUrl}
                rel="noopener"
                class="underline hover:text-muted"
              >
                Unsplash
              </a>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
