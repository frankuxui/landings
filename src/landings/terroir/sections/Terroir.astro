---
// Terroir — Section 02: "Lo que nos da la tierra"
// Educational section about the terroir concept. Five concepts with photos.
import { soilImage, leavesImage, grapesImage } from "../data/images"

interface Concept {
  title: string
  description: string
}

const concepts: Concept[] = [
  {
    title: "Suelo",
    description:
      "La composicion mineral del suelo define el caracter del vino. Caliza, pizarra, granito, arcilla: cada tipo aporta estructura, acidez o complejidad diferentes.",
  },
  {
    title: "Altitud",
    description:
      "Cada cien metros cambia la temperatura, la exposicion solar y la maduracion. Vinos de altura ganan acidez, frescura y concentracion aromatica.",
  },
  {
    title: "Clima",
    description:
      "Lluvia, viento, horas de sol, amplitud termica. El clima moldea la añada y determina si la uva alcanza su punto optimo de equilibrio.",
  },
  {
    title: "Uva",
    description:
      "Cada variedad responde al entorno de forma diferente. Tempranillo prospera en Rioja, Garnacha en laderas de pizarra, Palomino en las arenas de Jerez.",
  },
  {
    title: "Ser humano",
    description:
      "La decision de podar, vendimiar, fermentar, criar. El viñador interpreta lo que la tierra ofrece y decide lo que el vino sera.",
  },
]
---

<section
  id="terroir"
  class="relative overflow-hidden bg-background py-section"
  aria-labelledby="terroir-heading"
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <!-- Section header -->
    <div class="mb-16 reveal" data-fade-in>
      <p class="mb-4 text-xs font-medium uppercase tracking-[0.3em] text-muted">
        02 &mdash; Lo que nos da la tierra
      </p>
      <h2
        id="terroir-heading"
        class="max-w-heading font-display text-headline-2 font-extrabold uppercase leading-[0.86] text-foreground"
      >
        Terroir
      </h2>
      <p class="mt-6 max-w-copy text-lg leading-relaxed text-muted">
        Terroir es el lugar, el clima y el suelo que determinan el caracter de
        un vino. No es un ingrediente que se añada. Es lo que ya estaba ahi
        antes de que alguien plantara la primera vid.
      </p>
    </div>

    <!-- Concepts grid -->
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Left: concepts list -->
      <div class="flex flex-col gap-10">
        {
          concepts.map((concept: Concept) => (
            <div
              class="reveal border-t border-border/20 pt-6"
              data-terroir-item
            >
              <h3 class="font-display text-headline-3 font-semibold uppercase tracking-wider text-foreground">
                {concept.title}
              </h3>
              <p class="mt-3 max-w-copy text-lg leading-relaxed text-muted">
                {concept.description}
              </p>
            </div>
          ))
        }
      </div>

      <!-- Right: stacked images -->
      <div class="relative lg:sticky lg:top-24 lg:self-start">
        <div class="grid gap-6">
          <div class="aspect-[4/3] overflow-hidden rounded-sm">
            <img
              src={`${soilImage.src}&w=800&auto=format&fit=crop&q=80`}
              alt={soilImage.alt}
              width={soilImage.width}
              height={soilImage.height}
              loading="lazy"
              decoding="async"
              class="photo-tone h-full w-full object-cover"
              data-parallax
            />
          </div>
          <div class="text-[10px] text-muted/60">
            Foto de <a
              href={soilImage.authorUrl}
              rel="noopener"
              class="underline hover:text-muted">{soilImage.author}</a
            > en <a
              href={soilImage.unsplashUrl}
              rel="noopener"
              class="underline hover:text-muted">Unsplash</a
            >
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="aspect-square overflow-hidden rounded-sm">
              <img
                src={`${leavesImage.src}&w=600&auto=format&fit=crop&q=80`}
                alt={leavesImage.alt}
                width={leavesImage.width}
                height={leavesImage.height}
                loading="lazy"
                decoding="async"
                class="photo-tone h-full w-full object-cover"
              />
            </div>
            <div class="aspect-square overflow-hidden rounded-sm">
              <img
                src={`${grapesImage.src}&w=600&auto=format&fit=crop&q=80`}
                alt={grapesImage.alt}
                width={grapesImage.width}
                height={grapesImage.height}
                loading="lazy"
                decoding="async"
                class="photo-tone h-full w-full object-cover"
              />
            </div>
          </div>
          <div class="flex gap-4 text-[10px] text-muted/60">
            <span>
              Foto de <a
                href={leavesImage.authorUrl}
                rel="noopener"
                class="underline hover:text-muted">{leavesImage.author}</a
              > en <a
                href={leavesImage.unsplashUrl}
                rel="noopener"
                class="underline hover:text-muted">Unsplash</a
              >
            </span>
            <span>
              Foto de <a
                href={grapesImage.authorUrl}
                rel="noopener"
                class="underline hover:text-muted">{grapesImage.author}</a
              > en <a
                href={grapesImage.unsplashUrl}
                rel="noopener"
                class="underline hover:text-muted">Unsplash</a
              >
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
