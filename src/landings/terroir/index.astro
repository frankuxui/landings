---
// Terroir — Wine editorial landing.
// Root document for this landing. Fully self-contained.
import "./styles/tailwind.css"

import Header from "./sections/Header.astro"
import Hero from "./sections/Hero.astro"
import Terroir from "./sections/Terroir.astro"
import Map from "./sections/Map.astro"
import Vineyards from "./sections/Vineyards.astro"
import Harvest from "./sections/Harvest.astro"
import Grape from "./sections/Grape.astro"
import Crush from "./sections/Crush.astro"
import Fermentation from "./sections/Fermentation.astro"
import Cellar from "./sections/Cellar.astro"
import Oak from "./sections/Oak.astro"
import Solera from "./sections/Solera.astro"
import Aging from "./sections/Aging.astro"
import OldWines from "./sections/OldWines.astro"
import Priorat from "./sections/Priorat.astro"
import Wineries from "./sections/Wineries.astro"
import Pairing from "./sections/Pairing.astro"
import Tasting from "./sections/Tasting.astro"
import People from "./sections/People.astro"
import Voices from "./sections/Voices.astro"
import Gallery from "./sections/Gallery.astro"
import Closing from "./sections/Closing.astro"
import Footer from "./sections/Footer.astro"
import BackToTop from "./components/BackToTop.astro"

const pageTitle = "Terroir — El vino comienza bajo tierra"
const pageDescription =
  "Una experiencia editorial inmersiva sobre el mundo del vino: terroir, vendimia, bodega, crianza, maridaje y las personas que lo hacen posible."
const canonicalUrl = "/landings/terroir"
const thumbnailUrl =
  "https://images.unsplash.com/photo-1506377247377-2a5b3b417ebb?ixlib=rb-4.1.0&w=1200&auto=format&fit=crop&q=80"
---

<!doctype html>
<html
  lang="es"
  class="scroll-smooth overflow-x-clip scheme-light motion-reduce:scroll-auto dark:scheme-dark font-sans"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Restore persisted theme before first paint -->
    <script is:inline>
      ;(function () {
        var saved = localStorage.getItem("terroir:theme")
        if (saved === "dark" || saved === "light") {
          document.documentElement.setAttribute("data-theme", saved)
        }
      })()
    </script>

    <!-- Restore persisted palette before first paint -->
    <script is:inline>
      try {
        var storedPalette = localStorage.getItem("terroir:palette")
        if (storedPalette)
          document.documentElement.dataset.palette = storedPalette
      } catch (error) {}
    </script>

    <!-- Google Fonts — Wix Madefor Text -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Wix+Madefor+Text:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />

    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="noindex" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={thumbnailUrl} />
    <meta property="og:url" content={canonicalUrl} />
  </head>
  <body
    class="min-h-full overflow-x-clip bg-background text-base leading-relaxed text-foreground antialiased font-sans"
  >
    <a
      class="absolute -top-full left-4 z-1000 inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-sm border-0 bg-primary px-5 py-3 text-base font-semibold text-primary-foreground no-underline transition duration-200 ease-landing hover:opacity-90 focus-visible:top-4 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:opacity-90"
      href="#main-content"
    >
      Saltar al contenido principal
    </a>

    <Header />

    <main id="main-content">
      <Hero />
      <Terroir />
      <Map />
      <Vineyards />
      <Harvest />
      <Grape />
      <Crush />
      <Fermentation />
      <Cellar />
      <Oak />
      <Solera />
      <Aging />
      <OldWines />
      <Priorat />
      <Wineries />
      <Pairing />
      <Tasting />
      <People />
      <Voices />
      <Gallery />
      <Closing />
    </main>

    <Footer />

    <BackToTop />

    <script>
      import "./scripts/theme"
      import "./scripts/palette"
      import "./scripts/reveal"
      import "./scripts/backToTop"
      import "./scripts/readingProgress"
      import "./scripts/gsapAnimations"
      import "./scripts/wineSlider"
      import "./scripts/voicesSlider"
      import "./scripts/pairingSlider"
    </script>
  </body>
</html>
