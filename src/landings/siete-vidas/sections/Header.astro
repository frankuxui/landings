---
import { Menu, Moon, Sun, X } from "@lucide/astro"
import Photo from "../components/Photo.astro"
import { navLinks } from "../data/content"
import { images } from "../data/images"
import type { NavLink } from "../types"
---

<header
  class="fixed top-3 right-3 left-3 z-90 text-foreground mix-blend-normal transition duration-300 ease-landing"
  data-site-header
>
  <div
    class="relative z-100 grid min-h-14 grid-cols-[auto_1fr_auto] items-center gap-3 bg-background/88 px-3 py-2 backdrop-blur-md sm:px-5"
  >
    <a
      href="#main-content"
      class="grid size-11 place-items-center font-impact text-4xl leading-none text-foreground no-underline focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
      aria-label="Siete Vidas home"
    >
      7
    </a>

    <nav
      class="hidden justify-self-center nav:block"
      aria-label="Section navigation"
    >
      <ul class="flex items-center gap-5">
        {
          navLinks.map((link: NavLink) => (
            <li>
              <a
                href={link.href}
                class="font-mono text-xs font-semibold tracking-widest text-muted uppercase no-underline transition hover:text-foreground focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 justify-self-end">
      <span
        class="hidden font-mono text-xs tracking-widest text-muted uppercase sm:inline"
        >Cat Index - 001</span
      >
      <button
        type="button"
        class="inline-flex size-11 cursor-pointer items-center justify-center rounded-sm border-0 bg-transparent text-foreground transition hover:bg-control focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-control-hover"
        data-theme-toggle
        aria-label="Toggle dark mode"
      >
        <Moon
          class="size-5 dark:hidden"
          aria-hidden="true"
          stroke-width="1.75"
        />
        <Sun
          class="hidden size-5 dark:block"
          aria-hidden="true"
          stroke-width="1.75"
        />
      </button>
      <button
        type="button"
        class="group inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-sm border-0 bg-foreground px-3 py-2 font-mono text-xs font-semibold tracking-widest text-background uppercase transition hover:opacity-85 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:opacity-80"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span class="group-aria-expanded:hidden">Menu</span>
        <span class="hidden group-aria-expanded:inline">Close</span>
        <Menu class="size-4 group-aria-expanded:hidden" aria-hidden="true" />
        <X class="hidden size-4 group-aria-expanded:block" aria-hidden="true" />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="invisible fixed inset-0 z-90 grid h-dvh translate-x-full content-between overflow-y-auto bg-inverted/94 px-container-x pt-24 pb-8 text-inverted-foreground backdrop-blur-md nav:hidden"
    data-menu-panel
    aria-hidden="true"
  >
    <div class="grid gap-8 sm:grid-cols-[1fr_0.68fr] sm:items-end">
      <nav aria-label="Fullscreen section navigation">
        <ol class="grid gap-1">
          {
            navLinks.map((link: NavLink, index: number) => (
              <li class="overflow-hidden">
                <a
                  href={link.href}
                  class="mobile-menu-link grid min-h-16 grid-cols-[3rem_1fr] items-center gap-4 py-2 font-display text-4xl font-black text-current uppercase no-underline focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-current sm:text-6xl"
                >
                  <span class="mobile-menu-number font-mono text-sm text-current/55">
                    {String(index + 1).padStart(2, "0")} -
                  </span>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="mobile-menu-photo hidden sm:block">
        <Photo image={images.footer} ratio="3 / 4" inverse caption={false} />
      </div>
    </div>
    <div
      class="mobile-menu-meta mt-8 grid gap-3 font-mono text-xs tracking-widest text-current/60 uppercase sm:grid-cols-3"
    >
      <p>Fullscreen navigation</p>
      <p>Escape closes</p>
      <p>Focus stays inside</p>
    </div>
  </div>
</header>
