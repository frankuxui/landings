---
import PhotoCredit from "./PhotoCredit.astro"
import type { UnsplashImage } from "../types"

type PhotoRatio = "1 / 1" | "3 / 4" | "4 / 3" | "16 / 9"

export interface Props {
  image: UnsplashImage
  ratio?: PhotoRatio
  sizes?: string
  caption?: boolean
  inverse?: boolean
  eager?: boolean
  parallax?: boolean
  class?: string
  imgClass?: string
}

const {
  image,
  ratio = "4 / 3",
  sizes = "(min-width: 1024px) 50vw, 100vw",
  caption = true,
  inverse = false,
  eager = false,
  parallax = false,
  class: className,
  imgClass,
} = Astro.props

const ratioClass = {
  "1 / 1": "aspect-square",
  "3 / 4": "aspect-3/4",
  "4 / 3": "aspect-4/3",
  "16 / 9": "aspect-video",
}[ratio]
---

<figure class:list={["m-0 flex w-full flex-col", className]}>
  <div
    class:list={["relative w-full overflow-hidden bg-placeholder", ratioClass]}
  >
    <img
      src={`${image.src}&w=1600&auto=format&fit=crop&crop=entropy&q=80`}
      srcset={`${image.src}&w=800&auto=format&fit=crop&crop=entropy&q=80 800w, ${image.src}&w=1200&auto=format&fit=crop&crop=entropy&q=80 1200w, ${image.src}&w=1600&auto=format&fit=crop&crop=entropy&q=80 1600w, ${image.src}&w=2200&auto=format&fit=crop&crop=entropy&q=80 2200w`}
      alt={image.alt}
      title={`Photo by ${image.author} on Unsplash`}
      width={image.width}
      height={image.height}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      data-parallax-image={parallax ? "true" : undefined}
      class:list={[
        "absolute inset-0 h-full w-full object-cover photo-tone",
        parallax && "scale-110",
        imgClass,
      ]}
    />
  </div>
  {
    caption && (
      <figcaption class="mt-2">
        <PhotoCredit image={image} inverse={inverse} />
      </figcaption>
    )
  }
</figure>
