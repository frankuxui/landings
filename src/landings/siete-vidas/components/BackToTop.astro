---
import { ArrowUp } from "@lucide/astro"
---

<button
  type="button"
  class="pointer-events-none fixed right-4 bottom-4 z-50 inline-flex size-12 translate-y-3 scale-95 cursor-pointer items-center justify-center rounded-sm border-0 bg-control text-foreground opacity-0 transition duration-300 ease-landing hover:bg-control-hover focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:scale-90 data-visible:pointer-events-auto data-visible:translate-y-0 data-visible:scale-100 data-visible:opacity-100 motion-reduce:transition-none sm:right-6 sm:bottom-6"
  data-back-to-top
  aria-label="Back to top"
  aria-hidden="true"
  tabindex="-1"
>
  <ArrowUp class="size-5" aria-hidden="true" stroke-width="1.75" />
</button>
