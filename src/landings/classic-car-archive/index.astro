---
import "./styles/tailwind.css"

import Header from "./sections/Header.astro"
import Hero from "./sections/Hero.astro"
import Collection from "./sections/Collection.astro"
import Featured from "./sections/Featured.astro"
import Origin from "./sections/Origin.astro"
import Timeline from "./sections/Timeline.astro"
import Restorations from "./sections/Restorations.astro"
import Details from "./sections/Details.astro"
import Sounds from "./sections/Sounds.astro"
import Events from "./sections/Events.astro"
import Exhibitions from "./sections/Exhibitions.astro"
import Journeys from "./sections/Journeys.astro"
import Gallery from "./sections/Gallery.astro"
import Stories from "./sections/Stories.astro"
import Archive from "./sections/Archive.astro"
import About from "./sections/About.astro"
import Community from "./sections/Community.astro"
import CTAFinal from "./sections/CTAFinal.astro"
import Footer from "./sections/Footer.astro"
import BackToTop from "./components/BackToTop.astro"

const pageTitle = "Classic Car Archive — A Private Garage of Automotive Memory"
const pageDescription =
  "Classic Car Archive is a cinematic personal-collection landing for a classic-car enthusiast: part private garage, part living museum, part editorial archive."
const canonicalUrl = "/landings/classic-car-archive"
const thumbnailUrl =
  "https://images.unsplash.com/photo-1486006920555-c77dcf18193c?ixid=M3wxMDE2NzMxfDB8MXxzZWFyY2h8Mnx8Y2xhc3NpYyUyMGNhciUyMGdhcmFnZXxlc3wxfDB8fHwxNzg3NzAxMTg3fDI&ixlib=rb-4.1.0&w=1200&h=800&fit=crop&auto=format&q=80"
---

<!doctype html>
<html
  lang="en"
  class="scroll-smooth overflow-x-clip scheme-light motion-reduce:scroll-auto dark:scheme-dark font-sans"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <script is:inline>
      ;(function () {
        const saved = localStorage.getItem("classic-car-archive:theme")
        if (saved === "dark" || saved === "light") {
          document.documentElement.setAttribute("data-theme", saved)
          return
        }
        document.documentElement.setAttribute("data-theme", "dark")
      })()
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bowlby+One+SC&family=IBM+Plex+Sans+Condensed:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="noindex" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={thumbnailUrl} />
    <meta property="og:url" content={canonicalUrl} />

    <script is:inline>
      try {
        var storedPalette = localStorage.getItem("classic-car-archive:palette")
        if (storedPalette)
          document.documentElement.dataset.palette = storedPalette
      } catch (error) {}
    </script>
  </head>
  <body
    class="min-h-full overflow-x-clip bg-background text-base leading-relaxed text-foreground antialiased font-sans"
  >
    <a
      class="absolute -top-full left-4 z-1000 inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-sm border-0 bg-(--color-primary) px-5 py-3 text-base font-bold tracking-widest text-(--color-control-foreground) uppercase no-underline transition duration-200 ease-landing focus-visible:top-4 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
      href="#main-content"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main-content">
      <Hero />
      <Collection />
      <Featured />
      <Origin />
      <Timeline />
      <Restorations />
      <Details />
      <Sounds />
      <Events />
      <Exhibitions />
      <Journeys />
      <Gallery />
      <Stories />
      <Archive />
      <About />
      <Community />
      <CTAFinal />
    </main>

    <Footer />
    <BackToTop />

    <script>
      import "./scripts/theme"
      import "./scripts/palette"
      import "./scripts/menu"
      import "./scripts/reveal"
      import "./scripts/motion"
      import "./scripts/sliders"
      import "./scripts/comparison"
      import "./scripts/backToTop"
    </script>
  </body>
</html>
