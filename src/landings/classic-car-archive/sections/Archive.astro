---
import { Search } from "@lucide/astro"
import { archiveFilters, vehicles } from "../data/content"
import type { ArchiveFilter, Vehicle } from "../types"
---

<section
  id="archive"
  class="bg-background py-section"
  aria-labelledby="archive-heading"
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="text-sm font-bold tracking-widest text-muted uppercase">
          Archive
        </p>
        <h2
          id="archive-heading"
          class="mt-4 max-w-heading font-display text-headline-2 leading-none text-balance uppercase"
        >
          Browse it like a historical catalogue.
        </h2>
      </div>

      <div>
        <div class="grid gap-4 bg-surface p-5">
          <label
            for="archive-search"
            class="text-sm font-bold tracking-widest text-muted uppercase"
          >
            Search archive
          </label>
          <div class="flex min-h-12 items-center gap-3 bg-control px-4">
            <Search aria-hidden="true" width="18" height="18" />
            <input
              id="archive-search"
              type="search"
              placeholder="Maker, decade, body, restoration note"
              class="min-h-12 w-full bg-transparent text-base text-foreground placeholder:text-muted focus-visible:outline-none"
            />
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            {
              archiveFilters.map((filter: ArchiveFilter) => (
                <fieldset class="border-0 p-0">
                  <legend class="mb-3 text-sm font-bold tracking-widest text-muted uppercase">
                    {filter.label}
                  </legend>
                  <div class="flex flex-wrap gap-2">
                    {filter.values.map((value: string) => (
                      <button
                        type="button"
                        class="min-h-11 rounded-sm border border-border/40 px-3 py-2 text-sm font-bold tracking-wider text-foreground uppercase transition duration-200 ease-landing hover:bg-control focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
                      >
                        {value}
                      </button>
                    ))}
                  </div>
                </fieldset>
              ))
            }
          </div>
        </div>

        <div class="mt-8 divide-y divide-border/35">
          {
            vehicles.map((vehicle: Vehicle) => (
              <article class="grid gap-4 py-5 sm:grid-cols-[0.35fr_1fr_0.45fr] sm:items-center">
                <p class="font-display text-4xl leading-none">{vehicle.year}</p>
                <div>
                  <h3 class="text-2xl font-bold">
                    {vehicle.marque} {vehicle.model}
                  </h3>
                  <p class="text-muted">{vehicle.note}</p>
                </div>
                <p class="text-sm font-bold tracking-widest text-muted uppercase">
                  {vehicle.country} · {vehicle.power}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
