---
import Photo from "../components/Photo.astro"
import { timelineMoments } from "../data/content"
import type { TimelineMoment } from "../types"
---

<section
  id="history"
  class="overflow-hidden bg-inverted py-section text-inverted-foreground palette-surface-primary"
  aria-labelledby="history-heading"
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <div class="mb-12 grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="text-sm font-bold tracking-widest text-current/65 uppercase">
          History
        </p>
        <h2
          id="history-heading"
          class="mt-4 max-w-heading font-display text-headline-2 leading-none text-balance uppercase"
        >
          The collection learned to keep dates.
        </h2>
      </div>
      <p class="max-w-copy text-xl leading-relaxed text-current/75">
        A vertical story on small screens and a horizontal archive on desktop,
        animated by scroll when motion is welcome and still completely readable
        when it is not.
      </p>
    </div>

    <div class="relative" data-timeline>
      <div
        class="absolute top-0 bottom-0 left-4 w-px origin-top bg-current/20 lg:top-1/2 lg:right-0 lg:left-0 lg:h-px lg:w-full lg:origin-left"
        data-timeline-line
        aria-hidden="true"
      >
      </div>
      <div
        class="relative flex flex-col gap-12 lg:w-max lg:flex-row lg:gap-8"
        data-timeline-track
      >
        {
          timelineMoments.map((moment: TimelineMoment) => (
            <article class="reveal grid gap-5 pl-12 lg:w-112 lg:pl-0">
              <p class="font-display text-figure leading-none text-current">
                {moment.year}
              </p>
              <Photo image={moment.image} ratio="16 / 10" />
              <div>
                <h3 class="font-display text-2xl leading-none uppercase">
                  {moment.title}
                </h3>
                <p class="mt-3 text-lg text-current/75">{moment.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
