---
import Photo from "../components/Photo.astro"
import { restorations } from "../data/content"
import { restorationCarImage, sandingImage } from "../data/images"
import type { Restoration } from "../types"
---

<section class="bg-background py-section" aria-labelledby="restoration-heading">
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="text-sm font-bold tracking-widest text-muted uppercase">
          Restorations
        </p>
        <h2
          id="restoration-heading"
          class="mt-4 max-w-heading font-display text-headline-2 leading-none text-balance uppercase"
        >
          Archive work with oil under its nails.
        </h2>
      </div>
      <div class="space-y-8">
        {
          restorations.map((restoration: Restoration) => (
            <article class="reveal grid gap-5 border-t border-border/35 pt-6 md:grid-cols-[0.85fr_1.15fr]">
              <Photo image={restoration.image} ratio="4 / 3" />
              <div>
                <p class="text-sm font-bold tracking-widest text-muted uppercase">
                  Restoration: {restoration.duration} · {restoration.status}
                </p>
                <h3 class="mt-3 font-display text-headline-3 leading-none uppercase">
                  {restoration.vehicle}
                </h3>
                <p class="mt-4 text-xl text-foreground/85">
                  "{restoration.text}"
                </p>
                <ul class="mt-6 grid gap-2 text-sm font-bold tracking-wider text-muted uppercase">
                  {restoration.specs.map((spec: string) => (
                    <li>{spec}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }

        <div
          class="reveal grid gap-5 border-t border-border/35 pt-8 md:grid-cols-2"
          data-before-after
        >
          <div>
            <p class="text-sm font-bold tracking-widest text-muted uppercase">
              Before / after
            </p>
            <h3
              class="mt-3 font-display text-headline-3 leading-none uppercase"
            >
              Same shell, different heartbeat.
            </h3>
            <label
              class="mt-6 block text-sm font-bold tracking-widest text-muted uppercase"
              for="comparison-range"
            >
              Restoration comparison
            </label>
            <input
              id="comparison-range"
              data-comparison-range
              class="mt-3 w-full accent-current"
              type="range"
              min="0"
              max="100"
              value="52"
            />
          </div>
          <figure class="m-0">
            <div class="relative aspect-4/3 overflow-hidden bg-placeholder">
              <img
                src={sandingImage.src}
                alt={sandingImage.alt}
                width={sandingImage.width}
                height={sandingImage.height}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover photo-tone"
              />
              <div
                class="absolute inset-y-0 left-0 w-1/2 overflow-hidden"
                data-comparison-after
              >
                <img
                  src={restorationCarImage.src}
                  alt={restorationCarImage.alt}
                  width={restorationCarImage.width}
                  height={restorationCarImage.height}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full max-w-none object-cover photo-tone"
                />
              </div>
            </div>
            <figcaption
              class="mt-2 text-xs font-semibold tracking-widest text-muted uppercase"
            >
              Photos by
              <a
                href={sandingImage.authorUrl}
                rel="noopener"
                target="_blank"
                class="underline underline-offset-4"
              >
                {sandingImage.author}
              </a>
              and
              <a
                href={restorationCarImage.authorUrl}
                rel="noopener"
                target="_blank"
                class="underline underline-offset-4"
              >
                {restorationCarImage.author}
              </a>
              on
              <a
                href={sandingImage.unsplashUrl}
                rel="noopener"
                target="_blank"
                class="underline underline-offset-4"
              >
                Unsplash
              </a>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </div>
</section>
