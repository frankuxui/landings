---
import { facts, garageStories } from "../data/content"
import type { FactNote, GarageStory } from "../types"
---

<section class="bg-background-alt py-section" aria-labelledby="stories-heading">
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-bold tracking-widest text-muted uppercase">
          Garage stories
        </p>
        <h2
          id="stories-heading"
          class="mt-4 max-w-heading font-display text-headline-2 leading-none text-balance uppercase"
        >
          The serious archive has jokes in the margins.
        </h2>
        <div class="mt-10 space-y-4">
          {
            garageStories.map((story: GarageStory) => (
              <article class="reveal bg-surface p-5">
                <h3 class="text-2xl font-bold leading-tight">{story.title}</h3>
                <p class="mt-3 text-lg text-muted">"{story.text}"</p>
              </article>
            ))
          }
        </div>
      </div>

      <div>
        <p class="text-sm font-bold tracking-widest text-muted uppercase">
          Useless facts I know
        </p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            facts.map((fact: FactNote) => (
              <article class="reveal border-t border-border/35 pt-5">
                <p class="font-display text-4xl leading-none text-(--color-primary)">
                  {fact.number}
                </p>
                <h3 class="mt-4 text-xl font-bold">{fact.title}</h3>
                <p class="mt-2 text-muted">{fact.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
