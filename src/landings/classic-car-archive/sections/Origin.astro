---
import Photo from "../components/Photo.astro"
import { restorationCarImage } from "../data/images"
---

<section class="bg-background py-section" aria-labelledby="origin-heading">
  <div
    class="mx-auto grid w-full max-w-landing gap-10 px-container-x sm:px-8 lg:grid-cols-2 lg:items-center xl:px-14"
  >
    <div class="reveal">
      <p class="text-sm font-bold tracking-widest text-muted uppercase">
        First classic
      </p>
      <h2
        id="origin-heading"
        class="mt-4 max-w-heading font-display text-headline-2 leading-none text-balance uppercase"
      >
        It all started with one.
      </h2>
      <div class="mt-8 space-y-5 text-xl leading-relaxed text-foreground/85">
        <p>
          He saw it parked behind a workshop. It had dust, one soft tire, and
          probably more problems than he did. He took it home anyway.
        </p>
        <p>
          That first restoration turned a weekend curiosity into a permanent
          rhythm: catalog the parts, listen before replacing, preserve what
          still has a pulse, and never confuse perfect with alive.
        </p>
      </div>
    </div>
    <Photo
      image={restorationCarImage}
      ratio="3 / 4"
      class="reveal lg:sticky lg:top-28"
    />
  </div>
</section>
