---
import { ArrowUp } from "@lucide/astro"
---

<button
  type="button"
  data-back-to-top
  aria-label="Back to top"
  aria-hidden="true"
  tabindex="-1"
  class="fixed right-5 bottom-5 z-40 inline-flex size-12 min-h-11 scale-90 cursor-pointer items-center justify-center rounded-sm border-0 bg-control p-0 text-foreground opacity-0 pointer-events-none transition-[opacity,transform,background-color] duration-300 ease-landing hover:bg-control-hover focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-control-hover motion-reduce:transition-none sm:right-8 xl:right-14 [&.is-visible]:pointer-events-auto [&.is-visible]:scale-100 [&.is-visible]:opacity-100"
>
  <ArrowUp aria-hidden="true" width="20" height="20" stroke-width="1.5" />
</button>
