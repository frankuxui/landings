---
import { Newspaper } from "@lucide/astro"
import { navLinks } from "../data/nav"
import { topics } from "../data/topics"
import type { NavLink, Topic } from "../types"

const year = new Date().getFullYear()
---

<footer class="bg-inverted pt-16 pb-6 text-inverted-foreground">
  <div
    class="mx-auto grid w-full max-w-landing gap-10 px-container-x footer:grid-cols-[1.4fr_1fr_1fr] sm:px-8 xl:gap-16 xl:px-14"
  >
    <div>
      <a
        class="inline-flex items-center gap-3 text-inherit no-underline"
        href="#main-content"
      >
        <span
          class="inline-flex size-9 items-center justify-center rounded-sm bg-current/12"
          aria-hidden="true"
        >
          <Newspaper width="18" height="18" stroke-width="1.75" />
        </span>
        <span class="text-xl sm:text-2xl">Folio</span>
      </a>
      <p class="mt-4 max-w-copy text-current/75">
        A journal of design, architecture, culture, technology, and ideas —
        published weekly, read slowly.
      </p>
      <p class="mt-6 text-sm text-current/60">
        A fictional publication built for design demonstration purposes only.
      </p>
    </div>

    <nav aria-label="Section navigation">
      <p
        class="mb-4 font-mono text-xs font-semibold tracking-widest text-current/60 uppercase"
      >
        Sections
      </p>
      <ul class="flex flex-col gap-3">
        {
          navLinks.map((link: NavLink) => (
            <li>
              <a
                class="text-current/80 no-underline hover:text-current focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-current"
                href={link.href}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Topics">
      <p
        class="mb-4 font-mono text-xs font-semibold tracking-widest text-current/60 uppercase"
      >
        Topics
      </p>
      <ul class="flex flex-col gap-3">
        {
          topics.map((topic: Topic) => (
            <li>
              <a
                class="text-current/80 no-underline hover:text-current focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-current"
                href={`#${topic.slug}`}
              >
                {topic.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div
    class="mx-auto mt-16 w-full max-w-landing px-container-x sm:px-8 xl:px-14"
  >
    <div class="h-px w-full bg-current/12" aria-hidden="true"></div>
    <p class="pt-6 text-sm text-current/60">
      © {year} Folio. Design demo — not a real publication.
    </p>
  </div>
</footer>
