---
import { ArrowRight, ArrowDown } from "@lucide/astro"
import ImagePlaceholder from "../components/ImagePlaceholder.astro"
---

<section
  class="relative overflow-hidden bg-background"
  aria-labelledby="hero-heading"
>
  <div
    class="mx-auto grid w-full max-w-landing grid-cols-1 gap-10 px-container-x pt-10 pb-16 sm:px-8 sm:pt-14 sm:pb-20 xl:grid-cols-[3rem_1fr_1fr] xl:gap-14 xl:px-14 xl:pt-16"
  >
    <div class="hidden items-center justify-center xl:flex" aria-hidden="true">
      <span
        class="[writing-mode:vertical-rl] font-mono text-xs tracking-[0.3em] text-muted uppercase"
      >
        Folio — A Journal of Design, Architecture &amp; Ideas
      </span>
    </div>

    <div class="flex flex-col justify-center">
      <div
        class="mb-6 flex flex-wrap items-center gap-3 border-b border-border/50 pb-6"
      >
        <p
          class="font-mono text-xs font-semibold tracking-widest text-muted uppercase"
        >
          Issue No. 24
        </p>
        <span class="h-3 w-px bg-border/60" aria-hidden="true"></span>
        <p class="font-mono text-xs tracking-widest text-muted uppercase">
          The Slow Attention Issue
        </p>
      </div>

      <p
        class="mb-3 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
      >
        Cover feature — Technology
      </p>
      <h1
        id="hero-heading"
        class="max-w-hero-heading text-balance text-headline-1 leading-[0.98] font-semibold text-foreground"
        data-hero-headline
      >
        The quiet migration back to paper forms
      </h1>
      <p class="mt-6 max-w-copy text-lg text-muted italic sm:text-xl">
        Across a dozen public services that digitized in the same decade, one
        pattern keeps repeating: a return to paper, and nobody planned it.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          class="inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-sm border-0 bg-primary px-6 py-3 text-base font-semibold text-primary-foreground no-underline transition duration-200 ease-landing hover:bg-emphasis focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-emphasis"
          href="#feature"
        >
          Read the feature
          <ArrowRight
            aria-hidden="true"
            width="18"
            height="18"
            stroke-width="1.5"
          />
        </a>
        <a
          class="inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-sm px-4 py-3 text-base font-semibold text-foreground no-underline transition duration-200 ease-landing hover:bg-control focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-control-hover"
          href="#archive"
        >
          Browse the archive
          <ArrowDown
            aria-hidden="true"
            width="18"
            height="18"
            stroke-width="1.5"
          />
        </a>
      </div>

      <p class="mt-10 text-sm text-muted">
        Editorial Team · <time datetime="2026-08-21">August 21, 2026</time> · 12 min
        read
      </p>
    </div>

    <div class="flex items-stretch">
      <ImagePlaceholder
        label="Cover feature image"
        ratio="3 / 4"
        parallax
        class="w-full"
      />
    </div>
  </div>
</section>

<script>
  import "../scripts/heroReveal"
</script>
