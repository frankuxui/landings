---
import OpinionColumn from "../components/OpinionColumn.astro"
import { opinionPieces } from "../data/opinions"
import type { OpinionPiece } from "../types"
---

<section
  id="opinion"
  class="bg-background py-16 sm:py-20 lg:py-28"
  aria-labelledby="opinion-heading"
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <p
      class="mb-4 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
    >
      Opinion
    </p>
    <h2
      id="opinion-heading"
      class="max-w-heading text-balance text-headline-2 leading-tight font-semibold text-foreground"
    >
      Short arguments, held for the length of a column.
    </h2>

    <div
      class="mt-12 grid grid-cols-1 gap-x-10 gap-y-10 sm:grid-cols-2 xl:grid-cols-4"
    >
      {
        opinionPieces.map((piece: OpinionPiece) => (
          <OpinionColumn piece={piece} />
        ))
      }
    </div>
  </div>
</section>
