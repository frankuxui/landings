---
import { Send } from "@lucide/astro"
---

<section
  id="newsletter"
  class="bg-background-alt palette-surface-light py-16 transition-colors duration-400 ease-landing sm:py-20 lg:py-28"
  aria-labelledby="newsletter-heading"
>
  <div
    class="mx-auto grid w-full max-w-landing gap-10 px-container-x sm:px-8 lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-16 xl:px-14"
  >
    <div class="reveal">
      <p
        class="mb-4 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
      >
        The Editorial Journal dispatch, by email
      </p>
      <h2
        id="newsletter-heading"
        class="max-w-heading text-balance text-headline-2 leading-tight font-semibold text-foreground"
      >
        One email, once a week, no exceptions.
      </h2>
      <p class="mt-5 max-w-copy text-base text-muted sm:text-lg">
        The week's feature, the dispatch highlights, and one thing from the
        archive worth revisiting — nothing else, and never more than once a
        week.
      </p>
    </div>

    <form
      class="reveal flex flex-col gap-4 bg-surface p-8 sm:p-10"
      aria-labelledby="newsletter-heading"
    >
      <div class="flex flex-col gap-1">
        <label class="text-sm font-semibold" for="newsletter-email"
          >Email address</label
        >
        <input
          class="h-12 w-full min-w-0 rounded-xs bg-control px-4 py-2 text-base outline-none placeholder:text-muted focus-underline disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50"
          type="email"
          id="newsletter-email"
          name="email"
          autocomplete="email"
          inputmode="email"
          placeholder="you@example.com"
          required
        />
      </div>

      <fieldset class="flex flex-col gap-2">
        <legend class="mb-1 text-sm font-semibold">
          Which sections interest you?
        </legend>
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
          <label class="flex items-center gap-2">
            <input
              type="checkbox"
              name="interests"
              value="feature"
              class="size-4 rounded-xs accent-foreground focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-border"
              checked
            />
            Feature reports
          </label>
          <label class="flex items-center gap-2">
            <input
              type="checkbox"
              name="interests"
              value="dispatch"
              class="size-4 rounded-xs accent-foreground focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-border"
              checked
            />
            Dispatch
          </label>
          <label class="flex items-center gap-2">
            <input
              type="checkbox"
              name="interests"
              value="opinion"
              class="size-4 rounded-xs accent-foreground focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-border"
            />
            Opinion
          </label>
        </div>
      </fieldset>

      <button
        type="submit"
        class="mt-2 inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 self-start rounded-sm border-0 bg-(--color-primary) px-6 py-3 text-base font-semibold text-(--color-light) no-underline transition duration-200 ease-landing hover:opacity-90 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:opacity-90"
      >
        Subscribe
        <Send aria-hidden="true" width="16" height="16" stroke-width="1.5" />
      </button>
      <p class="text-xs text-muted">
        Demo form for a fictional publication — no messages are sent.
      </p>
    </form>
  </div>
</section>
