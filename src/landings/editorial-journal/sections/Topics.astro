---
import { ArrowUpRight } from "@lucide/astro"
import { topics } from "../data/topics"
import type { Topic } from "../types"
---

<section
  id="topics"
  class="border-y border-border/50 bg-background-alt py-12 sm:py-16"
  aria-labelledby="topics-heading"
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <h2
      id="topics-heading"
      class="mb-8 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
    >
      Browse by topic
    </h2>

    <nav aria-label="Topics">
      <ul
        class="grid grid-cols-1 gap-x-8 gap-y-0 sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          topics.map((topic: Topic) => (
            <li class="border-t border-border/50 first:border-t-0 sm:[&:nth-child(2)]:border-t-0 lg:[&:nth-child(3)]:border-t-0">
              <a
                class="group flex items-center justify-between gap-4 py-5 text-foreground no-underline focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border"
                href={`#${topic.slug}`}
              >
                <span>
                  <span class="block text-xl font-semibold group-hover:underline sm:text-2xl">
                    {topic.label}
                  </span>
                  <span class="mt-1 block max-w-[36ch] text-sm text-muted">
                    {topic.description}
                  </span>
                  <span class="mt-2 block font-mono text-xs text-muted">
                    {topic.count}
                  </span>
                </span>
                <ArrowUpRight
                  class="shrink-0 text-muted transition-transform duration-200 ease-landing group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-foreground"
                  aria-hidden="true"
                  width="20"
                  height="20"
                  stroke-width="1.5"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>
