---
import { ChevronLeft, ChevronRight } from "@lucide/astro"
import ArchiveSlide from "../components/ArchiveSlide.astro"
import { archiveIssues } from "../data/archive"
import type { ArchiveIssue } from "../types"
---

<section
  id="archive"
  class="bg-background py-16 sm:py-20 lg:py-28"
  aria-labelledby="archive-heading"
>
  <div class="mx-auto w-full max-w-landing px-container-x sm:px-8 xl:px-14">
    <div
      class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
    >
      <div class="max-w-heading">
        <p
          class="mb-4 font-mono text-xs font-semibold tracking-widest text-muted uppercase"
        >
          The archive
        </p>
        <h2
          id="archive-heading"
          class="text-balance text-headline-2 leading-tight font-semibold text-foreground"
        >
          Every issue back to the first.
        </h2>
      </div>

      <div class="flex shrink-0 items-center gap-3">
        <button
          type="button"
          class="inline-flex size-11 min-h-11 cursor-pointer items-center justify-center rounded-sm border border-border bg-transparent p-0 text-foreground transition duration-200 ease-landing hover:bg-control focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-control-hover disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-transparent"
          data-archive-prev
          aria-label="Previous issue"
        >
          <ChevronLeft
            aria-hidden="true"
            width="18"
            height="18"
            stroke-width="1.5"
          />
        </button>
        <button
          type="button"
          class="inline-flex size-11 min-h-11 cursor-pointer items-center justify-center rounded-sm border border-border bg-transparent p-0 text-foreground transition duration-200 ease-landing hover:bg-control focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-border active:bg-control-hover disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-transparent"
          data-archive-next
          aria-label="Next issue"
        >
          <ChevronRight
            aria-hidden="true"
            width="18"
            height="18"
            stroke-width="1.5"
          />
        </button>
      </div>
    </div>

    <div
      class="archive-slider swiper"
      data-archive-slider
      aria-label="Past issues carousel"
      role="region"
    >
      <div class="swiper-wrapper">
        {
          archiveIssues.map((issue: ArchiveIssue) => (
            <div class="swiper-slide h-auto !w-40 sm:!w-48 xl:!w-56">
              <ArchiveSlide issue={issue} />
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="archive-slider-pagination mt-8 flex justify-center"
      data-archive-pagination
    >
    </div>
  </div>
</section>

<script>
  import "../scripts/archiveSlider"
</script>
