---
// Bare shell for the /landings/[slug]/preview route.
// Deliberately has NO catalog navbar/footer — only the preview toolbar chrome.
// This keeps the demo experience visually separate from the catalog site.
import "../styles/global.css"
import { withBase } from "../utils/url"

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Preview</title>
  </head>
  <body class="h-full w-full">
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  body {
    display: flex;
    flex-direction: column;
  }
</style>
