---
import { getCollection } from "astro:content"
import Layout from "../layouts/Layout.astro"
import Navbar from "../components/platform/Navbar.astro"
import Footer from "../components/platform/Footer.astro"
import LandingCard from "../components/platform/LandingCard.astro"
import { categories } from "../data/categories"
import type { Category } from "../types/category"
import type { LandingEntry } from "../types/landing"
import { withBase } from "../utils/url"

const allLandings = await getCollection(
  "landings",
  ({ data }: LandingEntry) => data.status === "published",
)
const featured = allLandings
  .filter((landing: LandingEntry) => landing.data.featured)
  .slice(0, 6)
---

<Layout>
  <Navbar />

  <main class="pt-32 pb-28">
    <section class="w-full">
      <div class="container">
        <header
          class="pb-10 w-full max-w-full flex flex-col md:flex-row md:items-center items-start gap-4"
        >
          <div class="flex flex-col gap-4 w-full max-w-2xl flex-1">
            <h1 class="text-3xl sm:text-4xl font-bold">
              Una galería de Landing Pages construidas con Astro
            </h1>
            <p class="mt-6 text-lg">
              Explora, visualiza y consulta una colección de diseños de Landing
              Pages agrupados por categoría. Cada landing es una unidad
              independiente: su propio diseño, sus propios componentes y su
              propio código, listo para inspeccionar.
            </p>
          </div>
          <a
            class="h-10 mt-4 md:ml-auto inline-flex items-center justify-center px-6 text-sm rounded-full font-semibold bg-primary text-primary-foreground hover:bg-primary/90 transition-colors duration-300"
            href={withBase("/landings")}>Explorar landings</a
          >
        </header>
      </div>
    </section>

    <section id="categories">
      <div class="container">
        <header>
          <h2 class="text-2xl font-bold">Categorías</h2>
        </header>
        <div
          class="mt-6 w-full grid grid-cols-1 sm:grid-cols-6 md:grid-cols-9 lg:grid-cols-12 gap-x-4 items-start"
        >
          {
            categories.map((category: Category) => (
              <a
                class="flex flex-col items-start gap-2 p-6 mb-4 rounded-2xl bg-foreground/5 hover:bg-foreground/10 transition-colors duration-300 col-span-3 min-h-[clamp(100px,20vw,135px)]"
                href={withBase(`/landings/category/${category.slug}`)}
              >
                <h3 class="font-semibold text-lg">{category.label}</h3>
                <p class="text-sm text-muted">{category.description}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="pt-8">
      <div class="container">
        <header>
          <h2 class="text-2xl font-bold">Destacadas</h2>
        </header>
        {
          featured.length > 0 ? (
            <div class="mt-6 grid lg:grid-cols-8 xl:grid-cols-12 w-full gap-x-4">
              {featured.map((landing: LandingEntry) => (
                <LandingCard landing={landing} />
              ))}
            </div>
          ) : (
            <p class="empty">
              Todavía no hay landings publicadas. Esta plataforma está lista
              para alojarlas — solo falta añadir la primera.
            </p>
          )
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>
