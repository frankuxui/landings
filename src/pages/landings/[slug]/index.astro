---
import { getCollection } from "astro:content"
import Layout from "../../../layouts/Layout.astro"
import Navbar from "../../../components/platform/Navbar.astro"
import Footer from "../../../components/platform/Footer.astro"
import LandingMetadata from "../../../components/platform/LandingMetadata.astro"
import type { LandingEntry, LandingProps } from "../../../types/landing"

export async function getStaticPaths() {
  const landings = await getCollection(
    "landings",
    ({ data }: LandingEntry) => data.status === "published",
  )
  return landings.map((landing: LandingEntry) => ({
    params: { slug: landing.id },
    props: { landing },
  }))
}

type Props = LandingProps

const { landing } = Astro.props
const { data } = landing
---

<Layout
  title={`${data.title} — Landing Pages Gallery`}
  description={data.description}
  image={data.thumbnail}
  url={`/landings/${landing.id}`}
>
  <Navbar />

  <main>
    <figure class="preview-image">
      <img
        src={data.thumbnail}
        alt={data.thumbnailAlt ?? ""}
        width={data.thumbnailWidth}
        height={data.thumbnailHeight}
        loading="eager"
        decoding="async"
      />
      {
        data.thumbnailCredit && (
          <figcaption class="credit">
            Foto:{" "}
            <a
              href={data.thumbnailCredit.authorUrl}
              rel="noopener"
              target="_blank"
            >
              {data.thumbnailCredit.author}
            </a>{" "}
            ·{" "}
            <a
              href={data.thumbnailCredit.unsplashUrl}
              rel="noopener"
              target="_blank"
            >
              Unsplash
            </a>
          </figcaption>
        )
      }
    </figure>

    <header class="page-header">
      <h1>{data.name}</h1>
      <p>{data.description}</p>
      <a class="cta" href={`/landings/${landing.id}/preview`}>Ver demo</a>
    </header>

    <LandingMetadata landing={landing} />
  </main>

  <Footer />
</Layout>

<style>
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 2.5rem clamp(1rem, 4vw, 2.5rem) 4rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .preview-image {
    position: relative;
    margin: 0;
    border-radius: var(--platform-radius);
    overflow: hidden;
    border: 1px solid var(--platform-border);
    aspect-ratio: 16 / 9;
    background: var(--platform-surface);
  }

  .preview-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .credit {
    position: absolute;
    z-index: 2;
    inset-inline: 0;
    bottom: 0;
    margin: 0;
    display: flex;
    gap: 0.3em;
    align-items: center;
    padding: 0.4rem 0.75rem;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55), transparent);
    color: #fff;
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .credit a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .page-header h1 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
  }

  .page-header p {
    margin: 0 0 1.25rem;
    color: var(--platform-text-muted);
    max-width: 60ch;
  }

  .cta {
    display: inline-block;
    background: var(--platform-accent);
    color: var(--platform-accent-contrast);
    text-decoration: none;
    padding: 0.65rem 1.4rem;
    border-radius: 8px;
    font-weight: 600;
  }
</style>
