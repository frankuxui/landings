---
import { getCollection } from "astro:content"
import Layout from "../../../layouts/Layout.astro"
import Navbar from "../../../components/platform/Navbar.astro"
import Footer from "../../../components/platform/Footer.astro"
import LandingMetadata from "../../../components/platform/LandingMetadata.astro"
import type { LandingEntry, LandingProps } from "../../../types/landing"
import { withBase } from "../../../utils/url"

export async function getStaticPaths() {
  const landings = await getCollection(
    "landings",
    ({ data }: LandingEntry) => data.status === "published",
  )
  return landings.map((landing: LandingEntry) => ({
    params: { slug: landing.id },
    props: { landing },
  }))
}

type Props = LandingProps

const { landing } = Astro.props
const { data } = landing
---

<Layout
  title={`${data.title} — Landing Pages Gallery`}
  description={data.description}
  image={data.thumbnail}
  url={withBase(`/landings/${landing.id}`)}
>
  <Navbar />

  <main class="pt-32 pb-28">
    <div class="container">
      <div class="w-full max-w-full flex flex-row items-center gap-8">
        <div class="w-full max-w-full flex items-start flex-col">
          {
            data.thumbnail && (
              <figure class="preview-image">
                <img
                  src={data.thumbnail}
                  alt={data.thumbnailAlt ?? ""}
                  width={data.thumbnailWidth}
                  height={data.thumbnailHeight}
                  loading="eager"
                  decoding="async"
                  class="rounded-2xl w-full max-w-full sm:max-w-3xl grayscale contrast-125"
                />
                {data.thumbnailCredit && (
                  <figcaption class="text-xs text-muted mt-2">
                    Foto:{" "}
                    <a
                      href={data.thumbnailCredit.authorUrl}
                      rel="noopener"
                      target="_blank"
                    >
                      {data.thumbnailCredit.author}
                    </a>{" "}
                    ·{" "}
                    <a
                      href={data.thumbnailCredit.unsplashUrl}
                      rel="noopener"
                      target="_blank"
                    >
                      Unsplash
                    </a>
                  </figcaption>
                )}
              </figure>
            )
          }
          <header class="w-full mt-4 flex flex-col items-start gap-2">
            <h1 class="font-semibold text-3xl">{data.name}</h1>
            <p class="text-muted w-full max-w-2xl">{data.description}</p>
            <a
              class="h-10 mt-4 inline-flex items-center justify-center px-6 text-sm rounded-full font-semibold bg-black text-white hover:bg-foreground/90 transition-colors duration-300"
              href={withBase(`/landings/${landing.id}/preview`)}>Ver demo</a
            >
          </header>
          <LandingMetadata landing={landing} />
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
