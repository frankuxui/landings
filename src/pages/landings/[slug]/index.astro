---
import { getCollection } from "astro:content"
import Layout from "../../../layouts/Layout.astro"
import Navbar from "../../../components/platform/Navbar.astro"
import Footer from "../../../components/platform/Footer.astro"
import LandingMetadata from "../../../components/platform/LandingMetadata.astro"
import type { LandingEntry, LandingProps } from "../../../types/landing"

export async function getStaticPaths() {
  const landings = await getCollection(
    "landings",
    ({ data }: LandingEntry) => data.status === "published",
  )
  return landings.map((landing: LandingEntry) => ({
    params: { slug: landing.id },
    props: { landing },
  }))
}

type Props = LandingProps

const { landing } = Astro.props
const { data } = landing
---

<Layout
  title={`${data.title} — Landing Pages Gallery`}
  description={data.description}
  image={data.thumbnail}
  url={`/landings/${landing.id}`}
>
  <Navbar />

  <main>
    <div class="preview-image">
      <img src={data.previewImage ?? data.thumbnail} alt="" />
    </div>

    <header class="page-header">
      <h1>{data.name}</h1>
      <p>{data.description}</p>
      <a class="cta" href={`/landings/${landing.id}/preview`}>Ver demo</a>
    </header>

    <LandingMetadata landing={landing} />
  </main>

  <Footer />
</Layout>

<style>
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 2.5rem clamp(1rem, 4vw, 2.5rem) 4rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .preview-image {
    border-radius: var(--platform-radius);
    overflow: hidden;
    border: 1px solid var(--platform-border);
    aspect-ratio: 16 / 9;
    background: var(--platform-surface);
  }

  .preview-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-header h1 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
  }

  .page-header p {
    margin: 0 0 1.25rem;
    color: var(--platform-text-muted);
    max-width: 60ch;
  }

  .cta {
    display: inline-block;
    background: var(--platform-accent);
    color: var(--platform-accent-contrast);
    text-decoration: none;
    padding: 0.65rem 1.4rem;
    border-radius: 8px;
    font-weight: 600;
  }
</style>
