---
import { getCollection } from "astro:content"
import Layout from "../../../layouts/Layout.astro"
import Navbar from "../../../components/platform/Navbar.astro"
import Footer from "../../../components/platform/Footer.astro"
import LandingCard from "../../../components/platform/LandingCard.astro"
import CategoryFilter from "../../../components/platform/CategoryFilter.astro"
import { categories, getCategory } from "../../../data/categories"
import type { Category } from "../../../types/category"
import type { LandingEntry } from "../../../types/landing"

export function getStaticPaths() {
  return categories.map((category: Category) => ({
    params: { category: category.slug },
  }))
}

const { category: categorySlug } = Astro.params
const category = getCategory(categorySlug)

const landings = await getCollection(
  "landings",
  ({ data }: LandingEntry) =>
    data.status === "published" && data.category === categorySlug,
)
---

<Layout title={`${category?.label ?? categorySlug} — Landing Pages Gallery`}>
  <Navbar />

  <main class="pt-10 pb-28">
    <div class="container">
      <header class="pb-10 w-full">
        <h1 class="text-3xl sm:text-4xl font-bold max-w-lg">
          {category?.label ?? categorySlug}
        </h1>
        <p class="mt-6 text-lg mb-6 w-full max-w-3xl">
          {
            category?.description ??
              "Explora, visualiza y consulta una colección de diseños de Landing Pages agrupados por categoría. Cada landing es una unidad independiente: su propio diseño, sus propios componentes y su propio código, listo para inspeccionar."
          }
        </p>
        <CategoryFilter active={categorySlug} />
      </header>

      {
        landings.length > 0 ? (
          <div class="mt-6 grid grid-cols-12 w-full gap-x-4">
            {landings.map((landing: LandingEntry) => (
              <LandingCard landing={landing} />
            ))}
          </div>
        ) : (
          <div class="flex flex-col items-center justify-center gap-4 py-20 w-full max-w-sm mx-auto text-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="size-8"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-package-open-icon lucide-package-open"
            >
              <>
                <path d="M12 22v-9" />
                <path d="M15.17 2.21a1.67 1.67 0 0 1 1.63 0L21 4.57a1.93 1.93 0 0 1 0 3.36L8.82 14.79a1.655 1.655 0 0 1-1.64 0L3 12.43a1.93 1.93 0 0 1 0-3.36z" />
                <path d="M20 13v3.87a2.06 2.06 0 0 1-1.11 1.83l-6 3.08a1.93 1.93 0 0 1-1.78 0l-6-3.08A2.06 2.06 0 0 1 4 16.87V13" />
                <path d="M21 12.43a1.93 1.93 0 0 0 0-3.36L8.83 2.2a1.64 1.64 0 0 0-1.63 0L3 4.57a1.93 1.93 0 0 0 0 3.36l12.18 6.86a1.636 1.636 0 0 0 1.63 0z" />
              </>
            </svg>
            <p class="inline-block text-muted text-center">
              Todavía no hay landings publicadas en la categoría " <br />
              {category?.label ?? categorySlug}".
            </p>
          </div>
        )
      }
    </div>
  </main>

  <Footer />
</Layout>
