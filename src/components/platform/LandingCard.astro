---
import { getCategory } from "../../data/categories"
import { withBase } from "../../utils/url"
import type { LandingProps } from "../../types/landing"

type Props = LandingProps

const { landing } = Astro.props
const category = getCategory(landing.data.category)
const credit = landing.data.thumbnailCredit
---

<article class="w-full col-span-4 mb-4">
  <a
    href={withBase(`/landings/${landing.id}`)}
    class="landing-card group relative flex flex-col justify-end overflow-hidden rounded-3xl min-h-[clamp(400px,36vw,38rem)] bg-black/5 transition-shadow duration-300 hover:shadow-lg hover:shadow-black/20"
    aria-label={`Ver landing: ${landing.data.title}`}
  >
    {
      category && (
        <div class="mt-4 flex flex-wrap gap-2 absolute top-4 left-4 z-10">
          <span class="text-xs font-medium text-black bg-white rounded-full px-3 inline-flex items-center justify-center h-8">
            {category.label}
          </span>
        </div>
      )
    }
    {
      landing.data.thumbnail && (
        <img
          src={landing.data.thumbnail}
          alt={landing.data.thumbnailAlt ?? landing.data.title}
          width={landing.data.thumbnailWidth ?? 400}
          height={landing.data.thumbnailHeight ?? 550}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03] grayscale contrast-125"
        />
      )
    }

    <div
      aria-hidden="true"
      class="landing-card-overlay absolute inset-0 pointer-events-none"
    >
    </div>

    <div class="relative z-10 flex flex-col justify-end p-8 sm:p-10">
      <h3
        class="font-semibold tracking-tight text-white leading-snug text-[clamp(1.25rem,2.5vw,1.75rem)]"
      >
        {landing.data.title}
      </h3>

      {
        landing.data.description && (
          <p class="mt-3 text-white/80 leading-relaxed line-clamp-2 text-base">
            {landing.data.description}
          </p>
        )
      }
    </div>
  </a>
</article>

<style>
  .landing-card-overlay {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.4) 50%,
      transparent 100%
    );
  }
</style>
