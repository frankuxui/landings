---
// Off-canvas drawer, closed by default, slides in from the right.
// PreviewToolbar's "Opciones" button opens it by dispatching
// `preview:options-panel`. Open/close behavior — entry/exit animation,
// focus trap, scroll lock, Escape, backdrop click, and returning focus to
// the opener — is handled by the reusable `Drawer` class (src/lib/drawer.ts),
// which drives everything through the `data-state` attribute this component
// styles below. No motion or state logic lives in this file's script.
//
// Extensibility: each `<section>` below is one future capability (see the
// Skill's "Panel de opciones" rule). Only "Código" has any real content
// today (CodeExplorer, itself still a structural placeholder) — the rest
// render `ComingSoonNotice` until they're built. Adding a real feature later
// means swapping that one section's rendered content, not restructuring the
// panel.
import { Code, FolderTree, Download, Palette, X } from "@lucide/astro"
import CodeExplorer from "./CodeExplorer.astro"
import ComingSoonNotice from "./ComingSoonNotice.astro"
import PaletteOptions from "./PaletteOptions.astro"
import type { LandingPreviewProps } from "../../types/preview"

type Props = LandingPreviewProps

const { slug, palettes = [] } = Astro.props
---

<div
  class="options-drawer"
  id="options-panel"
  role="dialog"
  aria-modal="true"
  aria-label="Opciones del visualizador"
  hidden
>
  <div class="backdrop" data-drawer-backdrop aria-hidden="true"></div>

  <aside class="panel" aria-label="Opciones del visualizador">
    <div class="header">
      <h2>Opciones</h2>
      <button
        type="button"
        data-drawer-close
        data-drawer-autofocus
        aria-label="Cerrar panel de opciones"
      >
        <X aria-hidden="true" />
      </button>
    </div>

    <div class="body">
      <section class="option-section" aria-labelledby="option-code-heading">
        <h3 id="option-code-heading">
          <Code aria-hidden="true" />
          Código
        </h3>
        <CodeExplorer slug={slug} />
      </section>

      <section
        class="option-section"
        aria-labelledby="option-structure-heading"
      >
        <h3 id="option-structure-heading">
          <FolderTree aria-hidden="true" />
          Estructura de carpetas
        </h3>
        <ComingSoonNotice
          label="Próximamente"
          description="Aquí podrás explorar la estructura de archivos de la landing."
        />
      </section>

      <section class="option-section" aria-labelledby="option-download-heading">
        <h3 id="option-download-heading">
          <Download aria-hidden="true" />
          Descargar
        </h3>
        <ComingSoonNotice
          label="Próximamente"
          description="Descarga esta landing como un archivo .zip listo para usar."
        />
      </section>

      <section class="option-section" aria-labelledby="option-colors-heading">
        <h3 id="option-colors-heading">
          <Palette aria-hidden="true" />
          Personalizar colores
        </h3>
        {
          palettes.length > 0 ? (
            <PaletteOptions palettes={palettes} />
          ) : (
            <ComingSoonNotice
              label="Próximamente"
              description="Esta landing todavía no tiene paletas alternativas."
            />
          )
        }
      </section>
    </div>
  </aside>
</div>

<script>
  import { Drawer } from "../../lib/drawer"

  const root = document.getElementById("options-panel")

  if (root) {
    // Behavior (open/close, focus trap, scroll lock, Escape, backdrop) is the
    // Drawer's job; all motion lives in this component's CSS, keyed off the
    // `data-state` the Drawer writes. The panel is opened by the toolbar's
    // `preview:options-panel` event rather than a `trigger` selector.
    const drawer = new Drawer({
      root,
      panel: ".panel",
      backdrop: true,
      orientation: "right",
    }).init()

    document.addEventListener("preview:options-panel", () => drawer.open())
  }
</script>

<style>
  .options-drawer {
    position: fixed;
    inset: 0;
    z-index: 60;
  }

  /* The Drawer sets `hidden` only after the exit animation ends, so the
     panel stays mounted long enough to animate out. */
  .options-drawer[hidden] {
    display: none;
  }

  .backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--foreground) 60%, transparent);
    opacity: 0;
    transition: opacity 0.28s ease;
  }

  .panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(420px, 100%);
    background: var(--surface);
    border-left: 1px solid var(--platform-border);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 0.28s ease;
    will-change: transform;
  }

  /* Entrance and exit are the same transition reversed. `data-state` is
     written by the Drawer: `open` slides in, `closing` slides back out. */
  .options-drawer[data-state="open"] .panel {
    transform: translateX(0);
  }

  .options-drawer[data-state="open"] .backdrop {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .backdrop,
    .panel {
      transition: none;
    }
  }

  .header {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--platform-border);
    background: var(--surface);
  }

  .header h2 {
    margin: 0;
    font-size: 1rem;
  }

  .header button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--platform-text-muted);
    cursor: pointer;
  }

  .header button:hover,
  .header button:focus-visible {
    background: var(--platform-border);
    color: var(--platform-text);
  }

  .header button :global(svg) {
    width: 18px;
    height: 18px;
  }

  .body {
    flex: 1;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .option-section h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--platform-text);
  }

  .option-section h3 :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--platform-text-muted);
  }

  @media (max-width: 480px) {
    .panel {
      width: 100%;
    }
  }
</style>
