---
import { categories } from "../../data/categories"
import { withBase } from "../../utils/url"
import type { Category } from "../../types/category"

interface Props {
  active?: string
}

const { active } = Astro.props
---

<nav
  class="flex items-center justify-start w-full flex-wrap gap-2"
  aria-label="Filtrar por categoría"
  role="navigation"
>
  <a
    href={withBase("/landings")}
    class="rounded-full inline-flex items-center justify-center px-4 h-9 text-sm font-semibold transition-colors duration-300 hover:bg-foreground/5 data-[active=true]:bg-foreground/10"
    data-active={!active ? "true" : "false"}
  >
    Todas
  </a>
  {
    categories.map((category: Category) => (
      <a
        href={withBase(`/landings/category/${category.slug}`)}
        class="rounded-full inline-flex items-center justify-center px-4 h-9 text-sm font-semibold transition-colors duration-300 hover:bg-foreground/5 data-[active=true]:bg-foreground/10"
        data-active={active === category.slug ? "true" : "false"}
      >
        {category.label}
      </a>
    ))
  }
</nav>
