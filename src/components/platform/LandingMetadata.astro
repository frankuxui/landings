---
import { getCategory } from "../../data/categories"
import { slugifyTag } from "../../utils/slugify"
import type { LandingProps } from "../../types/landing"

type Props = LandingProps

const { landing } = Astro.props
const { data } = landing
const category = getCategory(data.category)
const dateFormatter = new Intl.DateTimeFormat("es", { dateStyle: "medium" })
---

<dl class="metadata">
  <div>
    <dt>Categoría</dt>
    <dd>{category?.label ?? data.category}</dd>
  </div>
  <div>
    <dt>Autor</dt>
    <dd>{data.author}</dd>
  </div>
  <div>
    <dt>Creada</dt>
    <dd>{dateFormatter.format(data.createdAt)}</dd>
  </div>
  {
    data.updatedAt && (
      <div>
        <dt>Actualizada</dt>
        <dd>{dateFormatter.format(data.updatedAt)}</dd>
      </div>
    )
  }
  <div>
    <dt>Temas disponibles</dt>
    <dd>{data.themes.join(", ")}</dd>
  </div>
  {
    data.technologies.length > 0 && (
      <div>
        <dt>Tecnologías</dt>
        <dd>{data.technologies.join(", ")}</dd>
      </div>
    )
  }
  {
    data.tags.length > 0 && (
      <div class="tags">
        <dt>Tags</dt>
        <dd>
          {data.tags.map((tag: string) => (
            <a class="tag" href={`/landings/tags/${slugifyTag(tag)}`}>
              {tag}
            </a>
          ))}
        </dd>
      </div>
    )
  }
</dl>

<style>
  .metadata {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem 1.5rem;
    margin: 0;
  }

  dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--platform-text-muted);
    margin-bottom: 0.25rem;
  }

  dd {
    margin: 0;
    font-size: 0.95rem;
  }

  .tags dd {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--platform-border);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }

  .tag:hover {
    background: var(--platform-accent);
    color: var(--platform-accent-contrast);
  }
</style>
