---
import { getCategory } from "../../data/categories"
import { slugifyTag } from "../../utils/slugify"
import { withBase } from "../../utils/url"
import type { LandingProps } from "../../types/landing"
import WidgetAboutMe from "./WidgetAboutMe.astro"

type Props = LandingProps

const { landing } = Astro.props
const { data } = landing
const category = getCategory(data.category)
const dateFormatter = new Intl.DateTimeFormat("es", { dateStyle: "medium" })
---

<dl
  class="w-full max-w-3xl mt-6 grid gap-4 sm:gap-6 xl:gap-8 grid-cols-[repeat(auto-fit,minmax(160px,1fr))]"
>
  <div class="flex flex-col gap-2">
    <dt class="uppercase font-semibold text-xs text-muted/60">Categoría</dt>
    <dd class="font-medium text-sm">{category?.label ?? data.category}</dd>
  </div>
  <div class="flex flex-col gap-2">
    <dt class="uppercase font-semibold text-xs text-muted/60">Creada</dt>
    <dd class="font-medium text-sm">
      {dateFormatter.format(data.createdAt)}
    </dd>
  </div>
  {
    data.updatedAt && (
      <div class="flex flex-col gap-2">
        <dt class="uppercase font-semibold text-xs text-muted/60">
          Actualizada
        </dt>
        <dd class="font-medium text-sm">
          {dateFormatter.format(data.updatedAt)}
        </dd>
      </div>
    )
  }
  <div class="flex flex-col gap-2">
    <dt class="uppercase font-semibold text-xs text-muted/60">
      Temas disponibles
    </dt>
    <dd class="font-medium text-sm">{data.themes.join(", ")}</dd>
  </div>
  {
    data.technologies.length > 0 && (
      <div class="flex flex-col gap-2">
        <dt class="uppercase font-semibold text-xs text-muted/60">
          Tecnologías
        </dt>
        <dd class="font-medium text-sm">{data.technologies.join(", ")}</dd>
      </div>
    )
  }
  {
    data.tags.length > 0 && (
      <div class="tags flex flex-col gap-2">
        <dt class="uppercase font-semibold text-xs text-muted/60">Tags</dt>
        <dd class="font-medium text-sm flex flex-wrap gap-2">
          {data.tags.map((tag: string) => (
            <a
              class="h-7 inline-flex items-center justify-center rounded-full px-4 bg-foreground/5 motion-safe:transition-colors duration-300 text-xs font-medium hover:bg-foreground/10"
              href={withBase(`/landings/tags/${slugifyTag(tag)}`)}
            >
              {tag.charAt(0).toUpperCase() + tag.slice(1)}
            </a>
          ))}
        </dd>
      </div>
    )
  }
  <div class="flex flex-col gap-2 col-span-1 sm:col-span-2">
    <dt class="uppercase font-semibold text-xs text-muted/60">Autor</dt>
    <dd class="font-medium text-sm hidden">{data.author}</dd>
    <WidgetAboutMe />
  </div>
</dl>
