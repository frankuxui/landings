---
// Toggles the theme of the previewed landing ONLY — never the catalog's own theme.
// Sends a `postMessage` into the preview iframe; each landing owns a small script
// that toggles `data-theme` on its OWN `document.documentElement`.
import { Sun, Moon } from "@lucide/astro"
---

<div class="theme-selector" role="group" aria-label="Seleccionar tema">
  <span class="theme-indicator" aria-hidden="true"></span>

  <button
    type="button"
    data-theme="light"
    aria-label="Activar tema claro"
    aria-pressed="true"
  >
    <Sun aria-hidden="true" />
  </button>

  <button
    type="button"
    data-theme="dark"
    aria-label="Activar tema oscuro"
    aria-pressed="false"
  >
    <Moon aria-hidden="true" />
  </button>
</div>

<script>
  import { gsap } from "gsap"
  import { isTheme } from "../../types/theme"

  const selectors = document.querySelectorAll<HTMLElement>(".theme-selector")

  selectors.forEach((selector) => {
    const indicator = selector.querySelector<HTMLElement>(".theme-indicator")

    const buttons = Array.from(
      selector.querySelectorAll<HTMLButtonElement>("button"),
    )

    if (!indicator || buttons.length === 0) return

    let activeTheme = "light"

    const moveIndicator = (
      activeButton: HTMLButtonElement,
      immediate = false,
    ) => {
      const icon = activeButton.querySelector<SVGElement>("svg")

      const duration = immediate ? 0 : 0.55

      const timeline = gsap.timeline({
        defaults: {
          overwrite: "auto",
        },
      })

      timeline.to(indicator, {
        x: activeButton.offsetLeft,
        y: activeButton.offsetTop,
        width: activeButton.offsetWidth,
        height: activeButton.offsetHeight,
        duration,
        ease: "back.out(1.35)",
      })

      if (!immediate && icon) {
        timeline.fromTo(
          icon,
          {
            rotate: activeTheme === "dark" ? -90 : 90,
            scale: 0.35,
            opacity: 0,
          },
          {
            rotate: 0,
            scale: 1,
            opacity: 1,
            duration: 0.5,
            ease: "back.out(2.5)",
          },
          "-=0.35",
        )
      }

      if (!immediate) {
        timeline.fromTo(
          selector,
          {
            scale: 0.96,
          },
          {
            scale: 1,
            duration: 0.45,
            ease: "elastic.out(1, 0.55)",
          },
          0,
        )
      }
    }

    const updateTheme = (
      theme: string,
      activeButton: HTMLButtonElement,
      immediate = false,
    ) => {
      if (theme === activeTheme && !immediate) return

      activeTheme = theme

      buttons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          button === activeButton ? "true" : "false",
        )
      })

      moveIndicator(activeButton, immediate)
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const theme = button.dataset.theme
        if (!isTheme(theme)) return

        updateTheme(theme, button)

        document.dispatchEvent(
          new CustomEvent("preview:theme", {
            detail: { theme },
          }),
        )
      })
    })

    const resizeObserver = new ResizeObserver(() => {
      const activeButton = buttons.find(
        (button) => button.dataset.theme === activeTheme,
      )

      if (activeButton) {
        moveIndicator(activeButton, true)
      }
    })

    resizeObserver.observe(selector)

    requestAnimationFrame(() => {
      const initialButton = buttons.find(
        (button) => button.getAttribute("aria-pressed") === "true",
      )

      if (!initialButton) return

      activeTheme = initialButton.dataset.theme ?? "light"
      moveIndicator(initialButton, true)
    })
  })
</script>

<style>
  .theme-selector {
    position: relative;
    display: inline-flex;
    align-items: center;
    overflow: hidden;
    background: var(--surface);
    border-radius: 9999px;
    isolation: isolate;
  }

  .theme-indicator {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    border-radius: 9999px;
    background: var(--primary);
    box-shadow:
      0 4px 12px color-mix(in srgb, var(--primary) 28%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 18%);
    pointer-events: none;
    will-change: transform, width, height;
  }

  button {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    color: var(--platform-text-muted);
    cursor: pointer;
    transition: color 300ms ease;
  }

  button :global(svg) {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    transform-origin: center;
    will-change: transform, opacity;
  }

  button[aria-pressed="true"] {
    color: var(--primary-foreground);
  }

  button:not([aria-pressed="true"]):hover {
    color: var(--platform-text);
  }

  button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
</style>
