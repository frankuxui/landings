---
import { Smartphone, Tablet, Monitor } from "@lucide/astro"
import type { Device, DeviceOption } from "../../types/preview"

const devices: DeviceOption[] = [
  { id: "mobile", label: "Mobile" },
  { id: "tablet", label: "Tablet" },
  { id: "desktop", label: "Desktop" },
]

const icons: Record<Device, typeof Smartphone> = {
  mobile: Smartphone,
  tablet: Tablet,
  desktop: Monitor,
}
---

<div class="device-selector" role="group" aria-label="Seleccionar dispositivo">
  <span class="indicator-tab" aria-hidden="true"></span>

  {
    devices.map((device: DeviceOption) => {
      const Icon = icons[device.id]

      return (
        <button
          type="button"
          data-device={device.id}
          aria-pressed={device.id === "desktop" ? "true" : "false"}
          class="device-button"
        >
          <Icon aria-hidden="true" />
          <span class="label">{device.label}</span>
        </button>
      )
    })
  }
</div>

<script>
  import { gsap } from "gsap"
  import { isDevice } from "../../types/preview"
  import type { Device } from "../../types/preview"

  const selectors = document.querySelectorAll<HTMLElement>(".device-selector")

  selectors.forEach((selector) => {
    const indicator = selector.querySelector<HTMLElement>(".indicator-tab")

    const buttons = Array.from(
      selector.querySelectorAll<HTMLButtonElement>(".device-button"),
    )

    if (!indicator || buttons.length === 0) return

    let activeDevice: Device = "desktop"

    const moveIndicator = (
      activeButton: HTMLButtonElement,
      immediate = false,
    ) => {
      gsap.to(indicator, {
        x: activeButton.offsetLeft,
        y: activeButton.offsetTop,
        width: activeButton.offsetWidth,
        height: activeButton.offsetHeight,
        duration: immediate ? 0 : 0.2,
        ease: "power3.inOut",
        overwrite: true,
      })
    }

    const updateActiveDevice = (device: Device, immediate = false) => {
      const activeButton = buttons.find(
        (button) => button.dataset.device === device,
      )

      if (!activeButton) return

      activeDevice = device

      buttons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          button === activeButton ? "true" : "false",
        )
      })

      moveIndicator(activeButton, immediate)
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const device = button.dataset.device
        if (!isDevice(device)) return

        document.dispatchEvent(
          new CustomEvent("preview:device", {
            detail: { device },
          }),
        )
      })
    })

    const handleDeviceChange = (event: Event) => {
      const customEvent = event as CustomEvent<{ device: unknown }>
      const device = customEvent.detail?.device as Device

      if (!isDevice(device)) return

      updateActiveDevice(device)
    }

    document.addEventListener("preview:device-change", handleDeviceChange)

    const resizeObserver = new ResizeObserver(() => {
      updateActiveDevice(activeDevice, true)
    })

    resizeObserver.observe(selector)

    requestAnimationFrame(() => {
      updateActiveDevice(activeDevice, true)
    })
  })
</script>

<style>
  .device-selector {
    position: relative;
    display: inline-flex;
    align-items: center;
    overflow: hidden;
    background: var(--color-surface);
    border-radius: 9999px;
  }

  .indicator-tab {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    border-radius: 9999px;
    background: var(--color-foreground);
    pointer-events: none;
    will-change: transform, width, height;
  }

  .device-button {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    color: var(--foreground);
    height: 2.5rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.85rem;
    cursor: pointer;
    transition: color 300ms ease;
  }

  .device-button :global(svg) {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .device-button[aria-pressed="true"] {
    color: var(--primary-foreground);
  }

  .device-button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: -2px;
  }

  @media (max-width: 640px) {
    .label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .device-button {
      padding: 0.5rem;
      width: 2.5rem;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .device-button {
      transition: none;
    }
  }
</style>
