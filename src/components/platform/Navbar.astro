---
// Platform navbar — used on catalog pages only, never inside a landing.
import { withBase } from "../../utils/url"
import SearchOverlay from "./SearchOverlay.astro"
---

<header
  class="navbar fixed top-0 left-0 right-0 z-50 bg-background/95 backdrop-blur-sm h-20 flex items-center justify-between border-b border-border/60"
>
  <div class="container h-full flex items-center justify-between">
    <a class="font-semibold" href={withBase("/")}>Galería</a>

    <div class="flex items-center gap-3">
      <button
        type="button"
        data-search-trigger
        class="inline-flex items-center justify-center gap-2 h-10 px-5 text-sm rounded-full font-medium border border-border/80 text-foreground/80 hover:bg-foreground/5 hover:text-foreground transition-colors duration-200"
        aria-label="Buscar landings"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="hidden sm:inline">Buscar</span>
        <kbd
          class="hidden md:inline-flex items-center gap-0.5 text-[10px] text-muted/60 font-normal ml-1"
        >
          <span class="px-1 py-0.5 rounded bg-foreground/5 leading-none">⌘</span
          >
          <span class="px-1 py-0.5 rounded bg-foreground/5 leading-none">K</span
          >
        </kbd>
      </button>
      <a
        class="h-10 inline-flex items-center justify-center px-5 text-sm rounded-full font-semibold bg-primary text-primary-foreground hover:bg-primary/90 transition-colors duration-200"
        href={withBase("/landings")}
      >
        Explorar landings
      </a>
    </div>
  </div>
</header>

<SearchOverlay />
