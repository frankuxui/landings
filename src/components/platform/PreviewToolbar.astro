---
import {
  Maximize,
  Maximize2,
  Minimize,
  PanelTopClose,
  SlidersHorizontal,
} from "@lucide/astro"
import DeviceSelector from "./DeviceSelector.astro"
import ThemeSelector from "./ThemeSelector.astro"
import { withBase } from "../../utils/url"
import type { LandingPreviewProps } from "../../types/preview"

type Props = LandingPreviewProps

const { name, slug } = Astro.props
---

<div
  class="toolbar w-full fixed left-0 h-20 top-0 border-b border-border"
  id="preview-toolbar"
>
  <div class="container h-full flex items-center justify-between gap-2">
    <div class="w-full flex items-center justify-between h-full">
      <div class="flex-none">
        <a
          class="inline-flex items-center gap-2 group"
          href={withBase(`/landings/${slug}`)}
          aria-label="Volver al catálogo"
        >
          <span
            class="rounded-full flex-none inline-flex items-center justify-center mt-0.5 size-10 transition-colors duration-300 group-hover:bg-foreground/10"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="26px"
              height="26px"
              viewBox="0 0 24 24"
            >
              <path d="M0 0h24v24H0z" fill="none"></path>
              <path
                fill="currentColor"
                d="M11.03 8.53a.75.75 0 1 0-1.06-1.06l-4 4a.75.75 0 0 0 0 1.06l4 4a.75.75 0 1 0 1.06-1.06l-2.72-2.72H18a.75.75 0 0 0 0-1.5H8.31z"
              ></path>
            </svg>
          </span>
          <span class="font-semibold text-sm hidden sm:block">{name}</span>
        </a>
      </div>
      <div
        class="w-full flex-1 mx-auto flex items-center justify-center gap-1 sm:gap-2"
      >
        <DeviceSelector />
        <ThemeSelector />
      </div>
      <div class="ml-auto flex items-center justify-end gap-1 sm:gap-2">
        <button
          type="button"
          id="open-options-panel"
          class="rounded-full size-10 inline-flex items-center justify-center bg-foreground/5 font-semibold text-sm transition-colors duration-300 hover:bg-foreground/10"
        >
          <SlidersHorizontal aria-hidden="true" size="18" />
        </button>
        <button
          type="button"
          id="browser-fill-toggle"
          aria-label="Ver a tamaño original del navegador"
          aria-pressed="false"
          class="rounded-full size-10 inline-flex items-center justify-center bg-foreground/5 font-semibold text-sm transition-colors duration-300 hover:bg-foreground/10"
        >
          <Maximize2 aria-hidden="true" size="18" />
        </button>
        <button
          type="button"
          id="fullscreen-toggle"
          aria-label="Ver a pantalla completa"
          aria-pressed="false"
          data-fullscreen="false"
          class="rounded-full size-10 inline-flex items-center justify-center bg-foreground/5 font-semibold text-sm transition-colors duration-300 hover:bg-foreground/10"
        >
          <Maximize aria-hidden="true" class="icon-enter" size="18" />
          <Minimize aria-hidden="true" class="icon-exit" size="18" />
        </button>
        <button
          type="button"
          id="hide-toolbar"
          aria-label="Ocultar barra de herramientas"
          class="rounded-full size-10 inline-flex items-center justify-center bg-foreground/5 font-semibold text-sm transition-colors duration-300 hover:bg-foreground/10"
        >
          <PanelTopClose aria-hidden="true" size="18" />
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const toolbar = document.getElementById("preview-toolbar")
  const hideButton = document.getElementById("hide-toolbar")

  document
    .getElementById("open-options-panel")
    ?.addEventListener("click", () => {
      document.dispatchEvent(new CustomEvent("preview:options-panel"))
    })

  hideButton?.addEventListener("click", () => {
    document.dispatchEvent(
      new CustomEvent("preview:toolbar-visibility", {
        detail: { visible: false },
      }),
    )
  })

  document
    .getElementById("browser-fill-toggle")
    ?.addEventListener("click", () => {
      document.dispatchEvent(new CustomEvent("preview:browser-fill-toggle"))
    })

  const fullscreenButton =
    document.querySelector<HTMLButtonElement>("#fullscreen-toggle")

  fullscreenButton?.addEventListener("click", () => {
    document.dispatchEvent(new CustomEvent("preview:fullscreen-toggle"))
  })

  document.addEventListener("fullscreenchange", () => {
    if (!fullscreenButton) return
    const isFullscreen = document.fullscreenElement !== null
    fullscreenButton.dataset.fullscreen = isFullscreen ? "true" : "false"
    fullscreenButton.setAttribute("aria-pressed", `${isFullscreen}`)
    fullscreenButton.setAttribute(
      "aria-label",
      isFullscreen ? "Salir de pantalla completa" : "Ver a pantalla completa",
    )
  })

  // Publishes this toolbar's real rendered height as a CSS custom property
  // on the document root so PreviewShell's `.stage` can reserve exactly
  // that much space, without either component reaching into the other's DOM.
  function publishHeight(): void {
    if (!toolbar) return
    document.documentElement.style.setProperty(
      "--toolbar-height",
      `${toolbar.offsetHeight}px`,
    )
  }

  if (toolbar) {
    const heightObserver = new ResizeObserver(publishHeight)
    heightObserver.observe(toolbar)
  }
  publishHeight()

  document.addEventListener("preview:toolbar-visibility", (event) => {
    if (!toolbar) return
    const { visible } = event.detail
    toolbar.dataset.hidden = visible ? "false" : "true"
    if (visible) hideButton?.focus()
  })
</script>

<style>
  .toolbar[data-hidden="true"] {
    transform: translateY(-100%);
    visibility: hidden;
    transition:
      transform 0.25s ease,
      visibility 0s linear 0.25s;
  }

  @media (max-width: 720px) {
    .toolbar {
      grid-template-columns: 1fr;
      row-gap: 0.6rem;
    }

    .left {
      justify-self: stretch;
    }

    .center {
      justify-self: stretch;
    }

    .right {
      justify-self: stretch;
      justify-content: flex-end;
    }
  }

  #fullscreen-toggle :global(.icon-exit) {
    display: none;
  }

  #fullscreen-toggle[data-fullscreen="true"] :global(.icon-enter) {
    display: none;
  }

  #fullscreen-toggle[data-fullscreen="true"] :global(.icon-exit) {
    display: block;
  }
</style>
